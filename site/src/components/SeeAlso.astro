---
// A short row of links to related pages, shown at the foot of a page.
import { href } from '../lib/data';
import { nav } from '../lib/nav';

interface Props {
  links: { path: string; label: string }[];
}
const { links } = Astro.props;
const boxOnly = new Set(nav.filter((n) => n.boxOnly).map((n) => n.path));
---
{links.length > 0 && (
  <nav class="see-also" aria-label="See also">
    <span class="label">See also</span>
    <ul>
      {links.map((l) => <li class:list={{ 'box-only': boxOnly.has(l.path) }}><a href={href(l.path)}>{l.label}</a></li>)}
    </ul>
  </nav>
)}

<style>
  .see-also {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 15px;
  }
  .label { color: var(--muted); font-family: var(--display); font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; }
  ul { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0; padding: 0; list-style: none; }
</style>
