---
// Hover cards on links to Invokers, Titans and bosses (pages/tooltips.json.ts). Mouse and trackpad only:
// on touch screens a tap just opens the page.
import { href } from '../lib/data';
---
<div id="tooltip" class="tooltip" role="tooltip" hidden data-src={href('tooltips.json')} data-base={href('/')}></div>

<script>
  import type { Tooltip } from '../pages/tooltips.json';

  const box = document.getElementById('tooltip')!;
  const base = box.dataset.base!;
  let tips: Promise<Record<string, Tooltip>> | undefined;
  let current: HTMLAnchorElement | undefined;

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const keyFor = (a: HTMLAnchorElement) => {
    if (a.origin !== location.origin || !a.pathname.startsWith(base)) return undefined;
    return a.pathname.slice(base.length).replace(/^\/|\/$/g, '');
  };
  const html = (t: Tooltip) => `
    <div class="tt-head">
      ${t.a ? `<img src="${t.a}" alt="" width="56" height="56">` : ''}
      <div><strong>${esc(t.n)}</strong><span class="tt-sub" style="${t.c ? `color:${t.c}` : ''}">${t.e ? `<img src="${t.e}" alt="" width="14" height="14">` : ''}${esc(t.s)}</span>
      ${t.t ? `<span class="tt-tier" style="--tier:${t.t.color}">${esc(t.t.label)}</span>` : ''}</div>
    </div>
    ${t.r?.length ? `<dl>${t.r.map(([k, v]) => `<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`).join('')}</dl>` : ''}
    ${t.l?.length ? `<ul>${t.l.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>` : ''}`;

  function place(e: MouseEvent) {
    const pad = 16;
    const w = box.offsetWidth, h = box.offsetHeight;
    let x = e.clientX + pad, y = e.clientY + pad;
    if (x + w > innerWidth - 8) x = e.clientX - w - pad;
    if (y + h > innerHeight - 8) y = Math.max(8, e.clientY - h - pad);
    box.style.transform = `translate(${Math.max(8, x)}px, ${y}px)`;
  }

  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.addEventListener('mouseover', async (e) => {
      const a = (e.target as Element).closest?.('a[href]') as HTMLAnchorElement | null;
      if (!a || a === current || a.closest('.tooltip, .top-nav, .crumbs, footer')) return;
      const key = keyFor(a);
      if (!key || key === keyFor(location as unknown as HTMLAnchorElement)) return;
      current = a;
      tips ??= fetch(box.dataset.src!).then((r) => r.json()).catch(() => ({}));
      const t = (await tips)[key];
      if (!t || current !== a) return;
      box.innerHTML = html(t);
      box.hidden = false;
      place(e);
    });
    document.addEventListener('mousemove', (e) => { if (!box.hidden) place(e); });
    document.addEventListener('mouseout', (e) => {
      const a = (e.target as Element).closest?.('a[href]');
      if (a && a === current && !a.contains(e.relatedTarget as Node)) {
        current = undefined;
        box.hidden = true;
      }
    });
    addEventListener('scroll', () => { box.hidden = true; current = undefined; }, { passive: true });
  }
</script>

<style is:global>
  .tooltip {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 50;
    width: 300px;
    padding: 12px 14px;
    border-radius: var(--radius);
    background: #12100C;
    border: 1px solid var(--line);
    box-shadow: 0 16px 36px rgb(0 0 0 / 0.55);
    pointer-events: none;
    font-size: 13px;
    color: var(--soft);
  }
  .tooltip[hidden] { display: none; }
  .tt-head { display: flex; gap: 12px; align-items: center; }
  .tt-head > img { width: 56px; height: 56px; border-radius: var(--radius); object-fit: cover; object-position: top center; border: 1px solid var(--line); flex: none; }
  .tt-head div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .tt-head strong { font-family: var(--display); font-size: 16px; color: var(--text); line-height: 1.2; }
  .tt-sub { display: inline-flex; align-items: center; gap: 4px; font-size: 12.5px; font-weight: 600; }
  .tt-tier { align-self: flex-start; margin-top: 2px; padding: 0 8px; border-radius: var(--radius); font-size: 11.5px; font-weight: 700; color: #110E0A; background: var(--tier); }
  .tooltip dl { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 10px 0 0; padding-top: 8px; border-top: 1px solid var(--line); }
  .tooltip dl div { display: flex; gap: 5px; }
  .tooltip dt { color: var(--muted); }
  .tooltip dd { margin: 0; color: var(--text); font-weight: 600; }
  .tooltip ul { margin: 8px 0 0; padding: 0; list-style: none; display: grid; gap: 2px; }
</style>
