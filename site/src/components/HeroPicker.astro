---
// Search box for picking an Invoker. The page wires it up with attachPicker() from lib/picker.
interface Props {
  id: string;
  label: string;
}
const { id, label } = Astro.props;
---
<div class="picker">
  <label>
    <span class="visually-hidden">{label}</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
    <input id={id} type="search" placeholder={label} autocomplete="off" disabled />
  </label>
  <ul id={`${id}-list`} class="picker-list" role="listbox" aria-label={label} hidden></ul>
</div>

<style is:global>
  .picker { position: relative; max-width: 420px; }
  .picker .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .picker label {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .picker label:focus-within { border-color: var(--accent); }
  .picker input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--text); font: inherit; font-size: 15px; }
  .picker-list {
    position: absolute;
    z-index: 5;
    left: 0;
    right: 0;
    top: calc(100% + 4px);
    margin: 0;
    padding: 4px;
    list-style: none;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--line);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }
  .picker-list[hidden] { display: none; }
  .picker-list li { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--radius); cursor: pointer; }
  .picker-list li div { display: flex; flex-direction: column; min-width: 0; }
  .picker-list li div span { font-size: 12px; color: var(--soft); }
  .picker-list li[aria-selected='true'] { background: var(--surface-3); outline: 1px solid var(--accent); }
  .picker-list li.empty { color: var(--muted); cursor: default; }
</style>
