---
// Hero portrait, or a placeholder tinted by element for a hero without art.
import type { Hero } from '../lib/data';
import { heroArt, heroSplash } from '../lib/art';
import { elementColor, initials } from '../lib/format';

interface Props {
  hero: Hero;
  class?: string;
  /** Prefer the full-size character art when there is some (hero page header). */
  large?: boolean;
}
const { hero, class: cls, large } = Astro.props;
const splash = large ? heroSplash(hero.id) : undefined;
const art = splash ?? heroArt(hero.id);
const tint = elementColor[hero.element] ?? '#5FDCF7';
---
{art ? (
  <img class:list={['art', { splash }, cls]} src={art} alt="" loading={large ? 'eager' : 'lazy'} />
) : (
  <div class:list={['art', 'art-placeholder', cls]} style={`--tint: ${tint}`} aria-hidden="true">
    <span>{initials(hero.name)}</span>
  </div>
)}

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .art.splash { object-fit: contain; object-position: bottom center; }
  .art-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--tint) 18%, var(--surface-2));
  }
  .art-placeholder span {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(28px, 6vw, 44px);
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--tint) 70%, var(--text));
    opacity: 0.85;
  }
</style>
