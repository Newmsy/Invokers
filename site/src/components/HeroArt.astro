---
// Hero portrait, or a placeholder tinted by element until the art is extracted.
import { href, type Hero } from '../lib/data';
import { elementColor, heroArt, initials } from '../lib/format';

interface Props {
  hero: Hero;
  class?: string;
}
const { hero, class: cls } = Astro.props;
const art = heroArt(hero.id);
const tint = elementColor[hero.element] ?? '#5FDCF7';
---
{art ? (
  <img class:list={['art', cls]} src={href(art)} alt="" loading="lazy" />
) : (
  <div class:list={['art', 'art-placeholder', cls]} style={`--tint: ${tint}`} aria-hidden="true">
    <span>{initials(hero.name)}</span>
  </div>
)}

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .art-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--tint) 18%, var(--surface-2));
  }
  .art-placeholder span {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(28px, 6vw, 44px);
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--tint) 70%, var(--text));
    opacity: 0.85;
  }
</style>
