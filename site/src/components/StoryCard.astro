---
// A news post or article in a list: its picture down the left (on top on phones), then the text.
import { href } from '../lib/data';
import { storyPicture } from '../lib/storyArt';

interface Props {
  path: string;
  title: string;
  description: string;
  /** Small gold label above the title, e.g. "Patch notes". */
  kind?: string;
  meta: string;
}
const { path, title, description, kind, meta } = Astro.props;
const pic = await storyPicture(path);
---
<a class:list={['story-card', { 'no-pic': !pic }]} href={href(path)}>
  {pic && <img class="pic" src={pic.src} style={`object-position: ${pic.position}`} alt="" loading="lazy" />}
  <span class="text">
    {kind && <span class="kind">{kind}</span>}
    <strong>{title}</strong>
    <span class="desc">{description}</span>
    <span class="meta">{meta}</span>
  </span>
</a>

<style>
  .story-card {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--text);
  }
  .story-card.no-pic { grid-template-columns: minmax(0, 1fr); }
  .story-card:hover { border-color: var(--accent); }
  .pic { width: 100%; height: 100%; min-height: 140px; object-fit: cover; border-right: 1px solid var(--line); transition: transform 0.4s ease; }
  .story-card:hover .pic { transform: scale(1.03); }
  .text { display: flex; flex-direction: column; gap: 6px; padding: 18px 22px; min-width: 0; }
  .kind { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); font-family: var(--display); font-weight: 600; }
  strong { font-family: var(--display); font-size: 20px; line-height: 1.3; }
  .desc { color: var(--soft); }
  .meta { font-size: 13px; color: var(--muted); }
  @media (max-width: 720px) {
    .story-card { grid-template-columns: minmax(0, 1fr); }
    .pic { height: auto; min-height: 0; aspect-ratio: 4 / 1; border-right: 0; border-bottom: 1px solid var(--line); }
    .text { padding: 14px 16px; }
    strong { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .pic { transition: none; } }
</style>
