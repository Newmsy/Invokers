---
// A row of game art for a post header or blog card, from "kind:Name" references (see lib/markdown-art).
import { artRef } from '../lib/markdown-art';
import { href } from '../lib/data';

interface Props {
  refs: string[];
  size?: 'large' | 'small';
}
const { refs, size = 'large' } = Astro.props;
const images = refs.map((r) => {
  const a = artRef(r);
  return { src: href(a.path), name: a.name, portrait: a.portrait };
});
---
{images.length > 0 && (
  <div class:list={['strip', size]}>
    {images.map((i) => (
      <span class:list={['tile', { portrait: i.portrait }]} title={i.name}>
        <img src={i.src} alt={i.name} loading="lazy" />
      </span>
    ))}
  </div>
)}

<style>
  .strip { display: flex; flex-wrap: wrap; gap: 10px; }
  .tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .tile img { width: 76%; height: 76%; object-fit: contain; }
  .tile.portrait img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .small { gap: 6px; }
  .small .tile { width: 44px; height: 44px; border-radius: 10px; }
  @media (max-width: 720px) {
    .large .tile { width: 56px; height: 56px; }
  }
</style>
