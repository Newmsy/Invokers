---
import BossLink from '../components/BossLink.astro';
import Base from '../layouts/Base.astro';
import { heroes, href } from '../lib/data';
import { richText } from '../lib/format';
import { gearGroups, gearSets } from '../lib/gear';
import { accessoryIcon, accessorySlots, gearPieceIcon, gearSlots, setIcon, slotIcon } from '../lib/art';

const factions = [...new Set(heroes.map((h) => String(h.faction)))].sort().filter((f) => accessorySlots.some((a) => accessoryIcon(f, a)));
const groups = gearGroups.map((g) => ({ ...g, sets: gearSets.filter((s) => s.group === g.id) })).filter((g) => g.sets.length);
---
<Base title="Gear sets">
  <h1>Gear sets</h1>
  <p class="lead">
    What every set gives at 3 and 5 pieces, and who should wear it. The 5-piece bonus adds to the 3-piece one, so a
    full Accuracy set gives +125 ACC. Tolerance sets link the bosses they counter.
  </p>
  <p class="links">
    <a href={href('my-box')}>See your own gear in My box</a>
    <span aria-hidden="true">·</span>
    <a href={href('gear-upgrades')}>Upgrade costs and Memorium</a>
    <span aria-hidden="true">·</span>
    <a href={href('planner')}>Plan upgrades in the Planner</a>
    <span aria-hidden="true">·</span>
    <a href={href('blog/every-gear-set')}>Every gear set, by the numbers</a>
  </p>

  <nav class="chips" aria-label="Set groups">
    {groups.map((g) => <a class="chip" href={`#${g.id}`}>{g.title} <span>{g.sets.length}</span></a>)}
  </nav>

  <section aria-labelledby="slots">
    <h2 id="slots">Slots</h2>
    <p class="hint">Every Invoker has eight gear slots. Awakening unlocks the five <a href="#accessories">accessory</a> slots.</p>
    <ul class="slots">
      {[...gearSlots, ...accessorySlots].map((slot) => (
        <li>{slotIcon(slot) && <img src={slotIcon(slot)} alt="" width="40" height="40" loading="lazy" />}<span>{slot}</span></li>
      ))}
    </ul>
  </section>

  {groups.map((g) => (
    <section aria-labelledby={g.id}>
      <h2 id={g.id}>{g.title}</h2>
      {g.id === 'tolerance' && (
        <p class="hint">
          Tolerance shortens and weakens a corruption, so pick the set for your boss. The 5-piece bonus is the same on all.
          <a href={href('blog/boss-corruptions-and-tolerance-sets')}>Which to build first</a>
        </p>
      )}
      <ul class="grid">
        {g.sets.map((s) => (
          <li class="card" id={`set-${s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
            <h3>{setIcon(s.id) && <img class="set-icon" src={setIcon(s.id)} alt="" width="40" height="44" loading="lazy" />}{s.name}</h3>
            {gearSlots.some((slot) => gearPieceIcon(s.id, slot)) && (
              <ul class="pieces" aria-label={`${s.name} pieces`}>
                {gearSlots.map((slot) => gearPieceIcon(s.id, slot) && (
                  <li><img src={gearPieceIcon(s.id, slot)} alt={slot} title={slot} width="32" height="32" loading="lazy" /></li>
                ))}
              </ul>
            )}
            <dl class="bonuses">
              {s.bonuses.map((b) => (
                <div>
                  <dt>{b.pieces} pieces</dt>
                  <dd>{b.lines.map((l) => <span>{l}</span>)}</dd>
                </div>
              ))}
              {s.fullSet.length > 0 && (
                <div class="full">
                  <dt>Full set</dt>
                  <dd>{s.fullSet.map((l) => <span>{l}</span>)}</dd>
                </div>
              )}
            </dl>
            {s.bosses.length > 0 && (
              <div class="bosses">
                <span class="label">Bosses with {s.corruption}</span>
                <ul>
                  {s.bosses.map((b) => <li><BossLink boss={b} /></li>)}
                </ul>
              </div>
            )}
            {s.description && (
              <details>
                <summary>Who it's for</summary>
                <p set:html={richText(s.description)} />
              </details>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}

  {factions.length > 0 && (
    <section aria-labelledby="accessories">
      <h2 id="accessories">Accessories</h2>
      <p class="hint">Each faction has its own look for the five accessory slots, which Awakening unlocks. <a href={href('ascension')}>How Awakening works</a></p>
      <ul class="grid accessories">
        {factions.map((f) => (
          <li class="card">
            <h3><a href={href(`heroes?faction=${encodeURIComponent(f)}`)}>{f}</a></h3>
            <ul class="pieces" aria-label={`${f} accessories`}>
              {accessorySlots.map((slot) => accessoryIcon(f, slot) && (
                <li><img src={accessoryIcon(f, slot)} alt={slot} title={slot} width="32" height="32" loading="lazy" /></li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  h2 { font-size: 18px; font-weight: 600; margin: 32px 0 12px; scroll-margin-top: 80px; }
  .lead { color: var(--soft); max-width: 70ch; margin: 0; }
  .hint { color: var(--muted); font-size: 14px; margin: -4px 0 12px; max-width: 80ch; }
  .links { margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 8px; color: var(--muted); }
  .links a, .bosses a { color: var(--accent); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    color: var(--soft);
    text-decoration: none;
    font-size: 14px;
  }
  .chip span { color: var(--muted); font-size: 12px; }
  .chip:hover { border-color: var(--accent); color: var(--text); }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .card {
    padding: 16px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-margin-top: 80px;
  }
  h3 { margin: 0; font-family: var(--display); font-size: 17px; font-weight: 600; display: flex; align-items: center; gap: 10px; }
  .set-icon { width: 40px; height: 44px; object-fit: contain; flex: none; }
  .pieces { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(8, minmax(0, 40px)); gap: 4px; }
  .accessories .pieces { grid-template-columns: repeat(5, minmax(0, 40px)); }
  .pieces li { aspect-ratio: 1; border-radius: 8px; border: 1px solid var(--line); display: grid; place-items: center; overflow: hidden; }
  .pieces img { width: 100%; height: 100%; object-fit: contain; }
  .slots { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .slots li { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 72px; font-size: 12px; color: var(--muted); text-align: center; }
  .slots img { width: 40px; height: 40px; object-fit: contain; }
  .accessories h3 a { color: var(--text); text-decoration: none; }
  .accessories h3 a:hover { color: var(--accent); }
  .bonuses { margin: 0; display: grid; gap: 8px; }
  .bonuses div { display: grid; grid-template-columns: 72px 1fr; gap: 8px; }
  .bonuses .full { border-top: 1px solid var(--line); padding-top: 8px; }
  dt { color: var(--muted); font-size: 13px; padding-top: 2px; }
  dd { margin: 0; display: flex; flex-direction: column; gap: 2px; font-weight: 500; }
  .bosses .label { display: block; color: var(--muted); font-size: 13px; margin-bottom: 4px; }
  .bosses ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 14px; }
  details { margin-top: auto; border-top: 1px solid var(--line); padding-top: 8px; }
  summary { cursor: pointer; color: var(--soft); font-size: 14px; min-height: 32px; display: flex; align-items: center; }
  details p { margin: 8px 0 0; color: var(--soft); font-size: 14px; line-height: 1.5; }

  @media (max-width: 720px) {
    h1 { font-size: 22px; }
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
