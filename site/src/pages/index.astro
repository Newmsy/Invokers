---
import Base from '../layouts/Base.astro';
import NavIcon from '../components/NavIcon.astro';
import SectionArt from '../components/SectionArt.astro';
import { heroes, heroHref, href } from '../lib/data';
import { heroArt, heroSplash } from '../lib/art';
import { tierLists, tierRows } from '../lib/tierData';
import { nav } from '../lib/nav';

const blurbs: Record<string, string> = {
  heroes: `All ${heroes.length} Invokers with skills, stats and ratings`,
  tiers: 'The best Invokers and Titans for each mode and boss',
  events: 'Event targets, energy planner and Arena Rush calculator',
  summons: 'Summon rates and an odds calculator',
  gear: 'Every gear set and who should wear it',
  trophies: 'Trophy Room costs, bonuses and an upgrade planner',
  bosses: "How to beat each boss, with its dos and don'ts",
  blog: 'Guides and deep dives',
  'skill-costs': 'What it costs to level skills, by rarity',
  ascension: 'Star-up and awakening costs, and where materials drop',
  'gear-upgrades': 'Gear upgrade gold, Memorium and selling',
  'heroes/compare': 'Put up to 4 Invokers side by side',
  updates: 'What changed in each game update',
  planner: 'Plan skill and gear upgrades for your own box',
  team: 'Build a team and check its element, faction and class mix',
  'my-box': 'Import your Invokers and gear, saved only in your browser',
};
const sections = nav.filter((n) => blurbs[n.path]);

// Banner: the campaign list's top picks, topped up with other Legendaries. Full-size art replaces the
// portraits once it exists.
const campaign = tierLists.find((l) => l.id === 'campaign');
const topSlugs = campaign ? tierRows('invokers', campaign).flatMap((r) => r.picks.map((p) => p.slug)) : [];
const bannerHeroes = [
  ...topSlugs.map((slug) => heroes.find((h) => heroHref(h.id).endsWith(`/${slug}`))),
  ...heroes.filter((h) => h.rarity === 'Legendary'),
]
  .filter((h, i, all): h is (typeof heroes)[number] => !!h && !!heroArt(h.id) && all.indexOf(h) === i)
  .slice(0, 12);
const splashes = heroes.filter((h) => heroSplash(h.id)).slice(0, 3);
---
<Base title="Home">
  <h1>Invokers Companion</h1>
  <p class="lead">Guides, planners and reference for Invokers.</p>
  {splashes.length > 0 ? (
    <div class="banner splash" aria-hidden="true">
      {splashes.map((h) => <a href={heroHref(h.id)} tabindex="-1"><img src={heroSplash(h.id)} alt="" /></a>)}
    </div>
  ) : (
    <div class="banner" aria-hidden="true">
      {bannerHeroes.map((h) => <a href={heroHref(h.id)} tabindex="-1" title={h.name}><img src={heroArt(h.id)} alt="" width="120" height="120" /></a>)}
    </div>
  )}
  <ul class="grid">
    {sections.map((n) => (
      <li>
        <a href={href(n.path)}>
          {n.art ? <SectionArt art={n.art} size={52} class="card-art" /> : <NavIcon icon={n.icon} />}
          <span class="name">{n.label}</span>
          <span class="blurb">{blurbs[n.path]}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  .lead { color: var(--soft); margin: 0 0 24px; }
  .banner {
    display: flex;
    gap: 10px;
    margin: 0 0 24px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .banner a { flex: none; display: block; width: 120px; height: 120px; border-radius: 20px; overflow: hidden; border: 1px solid var(--line); background: var(--surface); }
  .banner a:hover { border-color: var(--accent); }
  .banner img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .banner.splash { mask-image: none; gap: 0; justify-content: center; }
  .banner.splash a { width: auto; height: 280px; border: 0; background: none; flex: 1; }
  .banner.splash img { object-fit: contain; object-position: bottom center; }
  @media (max-width: 720px) {
    .banner a { width: 76px; height: 76px; border-radius: 14px; }
    .banner.splash a { height: 180px; }
  }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .grid a {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 14px;
    row-gap: 2px;
    align-items: center;
    padding: 16px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    height: 100%;
    box-sizing: border-box;
  }
  .grid a:hover { border-color: var(--accent); }
  .grid :global(svg) { color: var(--accent); grid-row: span 2; }
  .grid :global(.card-art) { grid-row: span 2; }
  .name { font-family: var(--display); font-weight: 600; font-size: 17px; }
  .blurb { color: var(--muted); font-size: 14px; grid-column: 2; }
</style>
