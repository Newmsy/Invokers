---
// Home: the latest news and articles up top, a sidebar of quick facts, then every section by menu.
import Base from '../layouts/Base.astro';
import SectionArt from '../components/SectionArt.astro';
import SearchForm from '../components/SearchForm.astro';
import { bosses, heroes, href, pack, titans } from '../lib/data';
import { effects } from '../lib/effects';
import { gearSets } from '../lib/gear';
import { tierLists, tierRows } from '../lib/tierData';
import { hasNews, inGroup, menus } from '../lib/nav';
import { allGuides } from '../lib/guides';
import { artRef } from '../lib/markdown-art';
import { storyPictures } from '../lib/storyArt';

// News entries (src/content/news) when they exist, then articles, newest first.
interface Story { path: string; title: string; blurb: string; art: string[]; tag: string; date: Date }
const newsFiles = import.meta.glob<{ frontmatter: Record<string, unknown> }>('../content/news/*.md', { eager: true });
// Labels match newsKinds in lib/news.ts (the News pages' own module).
const newsLabels: Record<string, string> = { spotlight: 'Chase hero spotlight', patch: 'Patch notes', event: 'Event', announcement: 'Announcement' };
const list = (v: unknown) => (Array.isArray(v) ? v.map(String) : []);
const hasArt = (ref: string) => { try { return !!artRef(ref); } catch { return false; } };
const news: Story[] = hasNews
  ? Object.entries(newsFiles).map(([file, m]) => {
      const f = m.frontmatter;
      return {
        path: `news/${file.split('/').pop()!.replace(/\.md$/, '')}`,
        title: String(f.title),
        blurb: String(f.description ?? ''),
        art: [...list(f.heroes).map((h) => `hero:${h}`), ...list(f.art)].filter(hasArt),
        tag: newsLabels[String(f.kind)] ?? 'News',
        date: new Date(String(f.date)),
      };
    })
  : [];
const guides = await allGuides();
const articles: Story[] = guides
  .filter((g) => g.date)
  .map((g) => ({ path: g.path, title: g.title, blurb: g.blurb, art: g.art, tag: g.topic, date: g.date! }));
const stories = [...news, ...articles].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const [lead, ...rest] = stories;
const side = rest.slice(0, 2);
const feed = rest.slice(2, 10);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const featured = guides.filter((g) => g.kind === 'Guide').slice(0, 6);

const campaign = tierLists.find((l) => l.id === 'campaign') ?? tierLists[0];
const topPicks = tierRows('invokers', campaign).flatMap((r) => r.picks).filter((p) => p.art).slice(0, 8);
// Story pictures (lib/storyArt): key art of what the story is about, else a scene from its topic.
const pictures = await storyPictures();
const pic = (st: Story) => pictures.get(st.path);
const backdrop = (st: Story) => pic(st)?.src;
const backdropPos = (st: Story) => `object-position: ${pic(st)?.position ?? 'center 30%'}`;

const counts = [
  { path: 'heroes', label: 'Invokers', n: heroes.length, art: 'hero:Admiral Gladstone' },
  { path: 'titans', label: 'Titans', n: titans.length, art: 'titan:Visciant' },
  { path: 'bosses', label: 'Bosses', n: bosses.length, art: 'item:Elder Titanheart' },
  { path: 'gear', label: 'Gear sets', n: gearSets.length, art: 'item:Gear Swap Pass' },
  { path: 'effects', label: 'Status effects', n: effects.length, art: 'item:Rare Codex' },
];
---
<Base title="Home">
  <h1 class="sr-only">Invokers Companion</h1>

  {lead && (
    <section class="top-stories" aria-label="Latest">
      <a class="lead-story" href={href(lead.path)}>
        {backdrop(lead) && <img class="backdrop" src={backdrop(lead)} style={backdropPos(lead)} alt="" fetchpriority="high" />}
        <span class="text">
          <span class="tag">{lead.tag}</span>
          <strong>{lead.title}</strong>
          <span class="blurb">{lead.blurb}</span>
          <span class="date">{fmt(lead.date)}</span>
        </span>
      </a>
      {side.map((st) => (
        <a class="side-story" href={href(st.path)}>
          {backdrop(st) && <img class="backdrop" src={backdrop(st)} style={backdropPos(st)} alt="" loading="lazy" />}
          <span class="text">
            <span class="tag">{st.tag}</span>
            <strong>{st.title}</strong>
            <span class="date">{fmt(st.date)}</span>
          </span>
        </a>
      ))}
    </section>
  )}

  <div class="columns">
    <div class="main-col">
      <section>
        <h2 class="bar">
          <span>{hasNews ? 'Latest news and articles' : 'Latest articles'}</span>
          <a href={href(hasNews ? 'news' : 'blog')}>{hasNews ? 'All news' : 'All articles'} ›</a>
        </h2>
        <ul class="feed">
          {feed.map((s) => (
            <li>
              <a href={href(s.path)}>
                {backdrop(s) ? <img class="thumb crop" src={backdrop(s)} style={backdropPos(s)} alt="" loading="lazy" /> : <SectionArt art={s.art[0]} size={64} class="thumb" />}
                <span class="tag">{s.tag}</span>
                <strong>{s.title}</strong>
                <span class="blurb">{s.blurb}</span>
                <span class="date">{fmt(s.date)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="bar"><span>Featured guides</span><a href={href('guides')}>All guides ›</a></h2>
        <ul class="guide-grid">
          {featured.map((g) => (
            <li>
              <a href={href(g.path)}>
                <SectionArt art={g.art[0]} size={44} />
                <strong>{g.title}</strong>
                <span class="blurb">{g.blurb}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <aside class="side-col">
      <div class="box search-box"><SearchForm /></div>

      <section class="box">
        <h2>Database</h2>
        <ul class="counts">
          {counts.map((c) => (
            <li><a href={href(c.path)}><SectionArt art={c.art} size={32} /><span>{c.label}</span><b>{c.n}</b></a></li>
          ))}
        </ul>
      </section>

      {topPicks.length > 0 && (
        <section class="box">
          <h2>Top picks: {campaign.label}</h2>
          <ul class="picks">
            {topPicks.map((p) => (
              <li><a href={p.href} title={p.name}><img src={p.art} alt="" width="56" height="56" loading="lazy" /><span>{p.name}</span></a></li>
            ))}
          </ul>
          <a class="more" href={href(`tiers/invokers/${campaign.id}`)}>Full tier list ›</a>
        </section>
      )}

      <section class="box tools-box">
        <h2>Tools</h2>
        <ul class="tools">
          {inGroup('tools').map((n) => (
            <li class:list={{ 'box-only': n.boxOnly }}><a href={href(n.path)}><SectionArt art={n.art} size={28} />{n.label}</a></li>
          ))}
        </ul>
      </section>

      <section class="box version">
        <h2>Game version</h2>
        <a href={href('updates')}><b>{pack.gameVersion}</b> · what changed ›</a>
      </section>
    </aside>
  </div>

  {menus.map((m) => (
    <section class="browse">
      <h2 class="bar"><span>{m.label}</span></h2>
      <ul class="grid">
        {inGroup(m.group).map((n) => (
          <li class:list={{ 'box-only': n.boxOnly }}>
            <a href={href(n.path)}>
              <SectionArt art={n.art} size={52} class="card-art" />
              <span class="name">{n.label}</span>
              <span class="blurb">{n.blurb}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .tag { font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); font-weight: 700; }
  .date { font-size: 12.5px; color: var(--muted); }
  .blurb { color: var(--muted); font-size: 14px; }
  strong { font-family: var(--display); font-weight: 600; line-height: 1.3; color: var(--text); }

  /* Top stories: one big, two small. */
  .top-stories { display: grid; grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; gap: 12px; margin: 12px 0 28px; }
  .top-stories a { border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); color: var(--text); overflow: hidden; }
  .top-stories a:hover { border-color: var(--accent); }
  .lead-story, .side-story { position: relative; display: flex; flex-direction: column; justify-content: flex-end; isolation: isolate; }
  .lead-story { grid-row: span 2; min-height: 360px; }
  .side-story { min-height: 170px; }
  .backdrop { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; z-index: -2; transition: transform 0.4s ease; }
  .top-stories a:hover .backdrop { transform: scale(1.03); }
  .top-stories a::before { content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgb(17 14 10 / 0) 25%, rgb(17 14 10 / 0.75) 62%, rgb(17 14 10 / 0.95) 100%); }
  .text { display: flex; flex-direction: column; gap: 6px; padding: 22px 24px; }
  .side-story .text { gap: 4px; padding: 16px 18px; }
  .lead-story strong { font-size: 30px; text-shadow: 0 2px 12px rgb(0 0 0 / 0.6); }
  .lead-story .blurb { font-size: 15px; color: var(--soft); max-width: 640px; }
  .side-story strong { font-size: 17px; text-shadow: 0 2px 10px rgb(0 0 0 / 0.6); }

  .columns { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 28px; align-items: start; }
  h2.bar { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; font-size: 19px; margin: 0 0 12px; padding-bottom: 8px; border-bottom: 2px solid var(--line); }
  h2.bar a { font-family: 'DM Sans', system-ui, sans-serif; font-size: 14px; font-weight: 500; }
  section { margin-bottom: 28px; }

  .feed { list-style: none; margin: 0; padding: 0; display: grid; }
  .feed a { display: grid; grid-template-columns: auto 1fr; column-gap: 16px; padding: 14px 8px; border-bottom: 1px solid var(--line); color: var(--text); }
  .feed a:hover { background: var(--surface); }
  .feed :global(.thumb) { grid-row: span 4; align-self: start; }
  .feed .crop { width: 160px; height: 90px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); }
  .feed strong { font-size: 17px; margin: 2px 0 2px; }

  .guide-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .guide-grid a { display: grid; grid-template-columns: auto 1fr; column-gap: 12px; align-content: start; height: 100%; padding: 14px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .guide-grid a:hover { border-color: var(--accent); }
  .guide-grid :global(.section-art) { grid-row: span 2; }
  .guide-grid strong { font-size: 15px; }

  .box { padding: 16px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); margin-bottom: 14px; }
  .search-box { padding: 0; border: 0; background: none; }
  .box h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--soft); margin: 0 0 10px; }
  .counts, .tools, .picks { list-style: none; margin: 0; padding: 0; }
  .counts a, .tools a { display: flex; align-items: center; gap: 10px; padding: 6px 4px; border-radius: var(--radius); color: var(--text); font-size: 15px; }
  .counts a:hover, .tools a:hover { background: var(--surface-2); }
  .counts span { flex: 1; }
  .counts b { font-family: var(--display); color: var(--accent); }
  .picks { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .picks a { display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 11.5px; color: var(--soft); text-align: center; line-height: 1.2; }
  .picks img { width: 56px; height: 56px; border-radius: var(--radius); object-fit: cover; object-position: top center; border: 1px solid var(--line); }
  .picks a:hover img { border-color: var(--accent); }
  .more { display: inline-block; margin-top: 10px; font-size: 14px; }
  .version a { color: var(--soft); }
  .version b { color: var(--text); font-family: var(--display); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .grid a { display: grid; grid-template-columns: auto 1fr; column-gap: 14px; row-gap: 2px; align-items: center; padding: 16px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); color: var(--text); height: 100%; }
  .grid a:hover { border-color: var(--accent); }
  .grid :global(.card-art) { grid-row: span 2; }
  .name { font-family: var(--display); font-weight: 600; font-size: 17px; }
  .grid .blurb { grid-column: 2; }

  @media (max-width: 1000px) {
    .columns { grid-template-columns: 1fr; }
    .side-col { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
    .search-box { grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .top-stories { grid-template-columns: 1fr; grid-template-rows: auto; }
    .lead-story { grid-row: auto; min-height: 280px; }
    .lead-story strong { font-size: 22px; }
    .text { padding: 16px; }
    .side-story { min-height: 150px; }
    .side-col { grid-template-columns: 1fr; }
    /* Phones have the More page for browsing, so the home page stops after the sidebar. */
    .browse, .tools-box { display: none; }
    .feed a { column-gap: 12px; }
    .feed :global(.thumb) { --size: 48px !important; }
    .feed .crop { width: 96px; height: 54px; }
  }
</style>
