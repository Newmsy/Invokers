---
import Base from '../layouts/Base.astro';
import SeeAlso from '../components/SeeAlso.astro';
import { itemIcon } from '../lib/art';
import { href } from '../lib/data';
import { bank, bankGemsPerPound, gemShopPrices, rankedPacks, rewardName, unrankedPacks, type PackValue } from '../lib/packs';

const money = (n: number, dp = 2) => (Number.isFinite(n) ? `£${n.toLocaleString('en-GB', { minimumFractionDigits: dp, maximumFractionDigits: dp })}` : '–');
const short = (n: number) =>
  n >= 1e6 ? `${+(n / 1e6).toFixed(1)}M` : n >= 10000 && n % 1000 === 0 ? `${n / 1000}K` : n.toLocaleString('en-GB');
const gems = (n: number) => Math.round(n).toLocaleString('en-GB');
const times = (r: number) => `${r.toFixed(1)}×`;

const ranked = rankedPacks();
const unranked = unrankedPacks();
const best = ranked.slice(0, 3);
const boosters = ranked.filter((p) => p.name === 'Weekly Booster Pack' || p.name === 'Monthly Summon Booster');
const tabs = [...new Set(ranked.map((p) => p.tab))].sort();
const bankRows = bank();
const shopRows = gemShopPrices();
const gemIcon = itemIcon('Gem');
const starIcon = itemIcon('SI_DivineStar');
const destinyIcon = itemIcon('SI_DestinyStar');

const estimatedNames = [...new Set(ranked.flatMap((p) => p.rewards.filter((r) => r.value?.how === 'estimated').map((r) => rewardName(r.id))))];
const unpricedNames = [...new Set(unranked.flatMap((p) => p.rewards.filter((r) => !r.value).map((r) => rewardName(r.id))))];
const contents = (p: PackValue) => p.rewards.map((r) => ({ ...r, name: rewardName(r.id), icon: itemIcon(r.id) }));
---
<Base title="Pack value">
  <h1>Pack value</h1>
  <p class="lead">
    Every paid pack, ranked by what its contents are worth against buying gems at the Bank. 1× is the same as the
    Bank; 3× is three times the value.
  </p>
  {best[0] && (
    <p class="verdict">
      Best value: <strong>{best[0].name}</strong>, {times(best[0].ratio)} the Bank for {money(best[0].price)}.
      {boosters.length > 0 && ` For comparison, ${boosters.map((b) => `${b.name} is ${times(b.ratio)}`).join(' and ')}.`}
    </p>
  )}

  <ul class="packs">
    {best.map((p, i) => (
      <li class="card pack">
        <div class="pack-head">
          <span class="rank">#{i + 1}</span>
          <h2>{p.name}</h2>
          <span class="price">{money(p.price)}</span>
        </div>
        <p class="limit">{p.tab} · {p.pack.steps?.length ? `${p.pack.steps.length} days · ` : ''}{p.limit}</p>
        <ul class="contents">
          {contents(p).map((r) => (
            <li title={r.name}>
              <span class="tile">{r.icon && <img src={r.icon} alt="" width="44" height="44" loading="lazy" />}</span>
              <span class="n">{short(r.amount)}</span>
              <span class="what">{r.name}</span>
            </li>
          ))}
        </ul>
        <dl class="stats">
          <div><dt>Value vs Bank</dt><dd>{times(p.ratio)}</dd></div>
          <div><dt>Worth</dt><dd>{money(p.worth, 0)}{p.estimated && <small> est.</small>}</dd></div>
        </dl>
      </li>
    ))}
  </ul>

  <section aria-labelledby="ranked-title">
    <h2 id="ranked-title">{starIcon && <img class="h-icon" src={starIcon} alt="" width="26" height="26" />}Every pack, ranked</h2>
    <div class="chips" role="group" aria-label="Filter by shop tab">
      <button type="button" class="chip" aria-pressed="true" data-tab="">All</button>
      {tabs.map((t) => <button type="button" class="chip" aria-pressed="false" data-tab={t}>{t}</button>)}
    </div>
    <div class="table-wrap">
      <table class="ranked">
        <thead>
          <tr>
            <th scope="col">Pack</th>
            <th scope="col">Contents</th>
            <th scope="col" class="num">Price</th>
            <th scope="col" class="num">Worth</th>
            <th scope="col" class="num">Value</th>
            <th scope="col" class="num">£ per Legendary</th>
          </tr>
        </thead>
        <tbody>
          {ranked.map((p) => (
            <tr data-tab={p.tab}>
              <th scope="row">{p.name}<small>{p.tab} · {p.limit}</small></th>
              <td>
                <span class="mini">
                  {contents(p).map((r) => (
                    <span title={r.name}>
                      {r.icon ? <img src={r.icon} alt={r.name} width="22" height="22" loading="lazy" /> : r.name}
                      {short(r.amount)}
                    </span>
                  ))}
                </span>
              </td>
              <td class="num">{money(p.price)}</td>
              <td class="num">{money(p.worth, 0)}{p.estimated && '*'}</td>
              <td class="num strong">{times(p.ratio)}</td>
              <td class="num">{p.pulls.Legendary ? money(p.perLegendary, 0) : '–'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="hint">
      * Includes {estimatedNames.join(', ')}, which the Gem Shop doesn't sell. They're estimated from their average
      Legendaries against a Destiny Star (or Wonder Orb for Titans). Exclusive Deals and Calendars come and go, so some
      may not be on sale now.
    </p>
    {unranked.length > 0 && (
      <p class="hint">
        Not ranked, because {unpricedNames.join(', ')} have no gem price:
        {' '}{unranked.map((p) => `${p.name} (${money(p.price)})`).join(', ')}.
      </p>
    )}
  </section>

  <section aria-labelledby="bank-title">
    <h2 id="bank-title">{gemIcon && <img class="h-icon" src={gemIcon} alt="" width="26" height="26" />}Bank</h2>
    <p class="hint">Bigger bundles give more gems per £. Each bundle's first purchase gives double.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Price</th>
            <th scope="col" class="num">Gems</th>
            <th scope="col" class="num">First purchase</th>
            <th scope="col" class="num">Gems per £</th>
          </tr>
        </thead>
        <tbody>
          {bankRows.map((b) => (
            <tr>
              <th scope="row">{money(b.price)}</th>
              <td class="num">{gems(b.gems)}</td>
              <td class="num">{b.first ? gems(b.first) : '–'}</td>
              <td class="num">{Math.round(b.perPound)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="shop-title">
    <h2 id="shop-title">{destinyIcon && <img class="h-icon" src={destinyIcon} alt="" width="26" height="26" />}What things cost in gems</h2>
    <p class="hint">Gem Shop prices for one of each, and that in £ at the Bank's best rate ({Math.round(bankGemsPerPound)} gems per £).</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col" class="num">Gems each</th>
            <th scope="col" class="num">£ each</th>
            <th scope="col">Limit</th>
          </tr>
        </thead>
        <tbody>
          {shopRows.map((s) => {
            const icon = itemIcon(s.id);
            return (
              <tr>
                <th scope="row">
                  <span class="item">{icon ? <img src={icon} alt="" width="26" height="26" loading="lazy" /> : <span class="icon-gap" />}{rewardName(s.id)}</span>
                </th>
                <td class="num">{s.gems >= 1 ? (+s.gems.toFixed(1)).toLocaleString('en-GB') : `${short(Math.round(1 / s.gems))} per gem`}</td>
                <td class="num">{s.gems / bankGemsPerPound >= 0.01 ? money(s.gems / bankGemsPerPound) : '<£0.01'}</td>
                <td>{s.limited ? 'Limited' : 'None'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="how-title">
    <h2 id="how-title">How it's worked out</h2>
    <ul class="text how">
      <li>Items are valued from their Gem Shop prices. Gems turn into £ at the Bank's best rate, the {money(bankRows.at(-1)?.price ?? 0)} bundle.</li>
      <li>Calendars count every day's rewards.</li>
      <li>Legendary averages use the <a href={href('summons')}>summon rates</a>, bonus summons included and mercy left out.</li>
      <li>Prices are UK store prices.</li>
    </ul>
  </section>

  <SeeAlso
    links={[
      { path: 'summons', label: 'Summons and odds' },
      { path: 'events', label: 'Events and energy' },
      { path: 'blog/destiny-star-odds', label: 'What 130 Destiny Stars buy you' },
    ]}
  />
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chips .chip');
  const rows = document.querySelectorAll<HTMLElement>('table.ranked tbody tr');
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
      const tab = chip.dataset.tab;
      for (const r of rows) r.hidden = !!tab && r.dataset.tab !== tab;
    });
  }
</script>

<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  h2 { font-size: 18px; font-weight: 600; margin: 32px 0 8px; }
  .h-icon { vertical-align: -6px; margin-right: 8px; }
  .lead, .text { color: var(--soft); max-width: 70ch; margin: 0; }
  .verdict { margin: 12px 0 20px; font-family: var(--display); font-size: 17px; max-width: 70ch; }
  .verdict strong { color: var(--accent); }
  .hint { color: var(--muted); font-size: 14px; margin: 0 0 12px; max-width: 80ch; }
  .how a { color: var(--accent); }
  .card { padding: 16px 20px 20px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
  .packs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 12px; }
  .pack-head { display: flex; align-items: baseline; gap: 10px; }
  .pack-head h2 { margin: 0; flex: 1; font-size: 18px; }
  .rank { font-family: var(--display); font-weight: 700; color: var(--accent); }
  .price { font-family: var(--display); font-weight: 700; font-size: 20px; }
  .limit { margin: 2px 0 12px; color: var(--muted); font-size: 14px; }
  .contents { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .contents li { display: grid; justify-items: center; gap: 2px; width: 64px; text-align: center; }
  .tile {
    display: flex; align-items: center; justify-content: center;
    width: 56px; height: 56px; border-radius: 12px;
    background: radial-gradient(circle at 50% 40%, color-mix(in srgb, var(--accent) 18%, var(--surface-2)), var(--surface-2));
    border: 1px solid var(--line);
  }
  .tile img { width: 80%; height: 80%; object-fit: contain; }
  .contents .n { font-family: var(--display); font-weight: 700; font-size: 15px; }
  .contents .what { color: var(--muted); font-size: 12px; line-height: 1.2; }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 0; }
  .stats div { padding: 10px 12px; border-radius: 12px; background: var(--surface-3); border: 1px solid var(--line); }
  .stats dt { color: var(--muted); font-size: 13px; }
  .stats dd { margin: 2px 0 0; font-family: var(--display); font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .stats small { font-size: 13px; color: var(--muted); font-weight: 500; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 12px; }
  .chip {
    min-height: 40px; padding: 0 16px; border-radius: 20px; background: transparent; border: 1px solid var(--line);
    color: var(--soft); font: inherit; font-size: 14px; cursor: pointer;
  }
  .chip[aria-pressed='true'] { border-color: var(--accent); color: var(--text); font-weight: 600; }
  .table-wrap { overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); }
  .table-wrap + .hint { margin-top: 12px; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: middle; }
  thead th { background: var(--surface-3); color: var(--muted); font-weight: 600; }
  tbody th { color: var(--text); font-weight: 500; }
  tbody th small { display: block; color: var(--muted); font-size: 12px; font-weight: 400; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  td.strong { font-weight: 700; color: var(--accent); }
  tbody tr:last-child > * { border-bottom: 0; }
  tr[hidden] { display: none; }
  .mini { display: flex; flex-wrap: wrap; gap: 4px 10px; min-width: 200px; color: var(--soft); font-size: 13px; }
  .mini span { display: inline-flex; align-items: center; gap: 3px; white-space: nowrap; }
  .item { display: inline-flex; align-items: center; gap: 8px; }
  .icon-gap { display: inline-block; width: 26px; }
  .how { padding-left: 20px; display: grid; gap: 4px; }

  @media (max-width: 720px) {
    h1 { font-size: 22px; }
    .card { padding: 14px 14px 14px; }
    .stats dd { font-size: 18px; }
  }
</style>
