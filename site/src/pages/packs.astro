---
import Base from '../layouts/Base.astro';
import SeeAlso from '../components/SeeAlso.astro';
import { itemIcon } from '../lib/art';
import { href, itemName } from '../lib/data';
import { energyPerGem, packData, packValue } from '../lib/packs';

const cur = packData.currency;
const money = (n: number) => (Number.isFinite(n) ? `${cur}${n.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : '–');
const whole = (n: number) => (Number.isFinite(n) ? `${cur}${Math.round(n).toLocaleString('en-GB')}` : '–');
const avg = (n = 0) => n.toFixed(n < 1 ? 3 : 2);
const count = (n: number) => (n >= 1000 && n % 1000 === 0 ? `${n / 1000}K` : n.toLocaleString('en-GB'));
const label = (id: string) => (id === 'Gem' ? 'Gems' : itemName(id));

const rows = packData.packs
  .map((p) => ({ ...p, v: packValue(p) }))
  .sort((a, b) => a.v.perLegendary - b.v.perLegendary);
const best = rows[0];

const monthly = rows.reduce(
  (t, r) => ({
    cost: t.cost + r.price * r.perMonth,
    legendary: t.legendary + (r.v.pulls.Legendary ?? 0) * r.perMonth,
    epic: t.epic + (r.v.pulls.Epic ?? 0) * r.perMonth,
  }),
  { cost: 0, legendary: 0, epic: 0 },
);

const gemIcon = itemIcon('Gem');
const starIcon = itemIcon('SI_DivineStar');
const calc = rows.map((r) => ({ id: r.id, name: r.name }));
---
<Base title="Pack value">
  <h1>Pack value</h1>
  <p class="lead">
    What each paid pack gives per {cur}, ranked best first. Averages describe many packs, not your next one.
  </p>
  {best && (
    <p class="verdict">
      Best value: <strong>{best.name}</strong>, {whole(best.v.perLegendary)} per Legendary on average.
    </p>
  )}

  <ul class="packs">
    {rows.map((r, i) => (
      <li class="card pack">
        <div class="pack-head">
          <span class="rank">#{i + 1}</span>
          <h2>{r.name}</h2>
          <span class="price">{money(r.price)}</span>
        </div>
        <p class="limit">{r.limit}</p>
        <ul class="contents">
          {r.items.map((it) => {
            const icon = itemIcon(it.item);
            return (
              <li title={label(it.item)}>
                <span class="tile">{icon && <img src={icon} alt="" width="44" height="44" loading="lazy" />}</span>
                <span class="n">{count(it.count)}</span>
                <span class="what">{label(it.item)}</span>
              </li>
            );
          })}
        </ul>
        <dl class="stats">
          <div><dt>Legendaries (avg)</dt><dd>{avg(r.v.pulls.Legendary)}</dd></div>
          <div><dt>Epics (avg)</dt><dd>{avg(r.v.pulls.Epic)}</dd></div>
          <div><dt>{cur} per Legendary</dt><dd>{whole(r.v.perLegendary)}</dd></div>
          <div><dt>Gems and energy, in gems</dt><dd>{Math.round(r.v.gemValue).toLocaleString('en-GB')}</dd></div>
        </dl>
      </li>
    ))}
  </ul>

  <section aria-labelledby="compare-title">
    <h2 id="compare-title">{starIcon && <img class="h-icon" src={starIcon} alt="" width="26" height="26" />}Side by side</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Pack</th>
            <th scope="col" class="num">Price</th>
            <th scope="col" class="num">Legendaries</th>
            <th scope="col" class="num">Epics</th>
            <th scope="col" class="num">{cur} per Legendary</th>
            <th scope="col" class="num">{cur} per Epic</th>
            <th scope="col" class="num">Per month</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">{r.name}</th>
              <td class="num">{money(r.price)}</td>
              <td class="num">{avg(r.v.pulls.Legendary)}</td>
              <td class="num">{avg(r.v.pulls.Epic)}</td>
              <td class="num">{whole(r.v.perLegendary)}</td>
              <td class="num">{money(r.v.perEpic)}</td>
              <td class="num">{r.perMonth === 1 ? '1' : `≈${r.perMonth}`}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="hint">
      Buying every pack each month costs about {whole(monthly.cost)} for {monthly.legendary.toFixed(2)} Legendaries and
      {' '}{monthly.epic.toFixed(1)} Epics on average.
    </p>
  </section>

  <section class="card" aria-labelledby="bank-title">
    <h2 id="bank-title">{gemIcon && <img class="h-icon" src={gemIcon} alt="" width="26" height="26" />}Count the gems too</h2>
    <p class="hint">
      Packs with gems and energy look worse per Legendary than they are. Enter a Bank price to take their value off
      and see what you pay for the stars alone.
    </p>
    <div class="calc">
      <label><span>Bank price ({cur})</span><input id="b-price" type="number" inputmode="decimal" min="0" step="0.01" placeholder="e.g. 9.99" /></label>
      <label><span>Gems you get</span><input id="b-gems" type="number" inputmode="numeric" min="1" placeholder="e.g. 1000" /></label>
    </div>
    <div class="table-wrap bank">
      <table>
        <thead>
          <tr>
            <th scope="col">Pack</th>
            <th scope="col" class="num">Gems and energy worth</th>
            <th scope="col" class="num">{cur} per Legendary, stars only</th>
          </tr>
        </thead>
        <tbody>
          {calc.map((c) => (
            <tr data-pack={c.id}>
              <th scope="row">{c.name}</th>
              <td class="num" data-out="worth">–</td>
              <td class="num" data-out="per">–</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="how-title">
    <h2 id="how-title">How it's worked out</h2>
    <ul class="text how">
      <li>Averages use the <a href={href('summons')}>summon rates</a>, with bonus summons included and mercy left out.</li>
      <li>Energy counts as gems at the refill price of {energyPerGem} energy per gem.</li>
      <li>Prices are UK store prices seen on {new Date(packData.seen).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}.</li>
    </ul>
  </section>

  <SeeAlso
    links={[
      { path: 'summons', label: 'Summons and odds' },
      { path: 'events', label: 'Events and energy' },
      { path: 'blog/destiny-star-odds', label: 'What 130 Destiny Stars buy you' },
    ]}
  />
</Base>

<script>
  import { packData, starPricePerLegendary, packValue } from '../lib/packs';

  const price = document.getElementById('b-price') as HTMLInputElement;
  const gems = document.getElementById('b-gems') as HTMLInputElement;
  const cur = packData.currency;
  const fmt = (n: number, dp: number) => `${cur}${n.toLocaleString('en-GB', { minimumFractionDigits: dp, maximumFractionDigits: dp })}`;

  function update() {
    const perGem = Number(price.value) / Number(gems.value);
    const ok = Number.isFinite(perGem) && perGem >= 0 && Number(gems.value) > 0 && price.value !== '';
    for (const row of document.querySelectorAll<HTMLElement>('.bank tr[data-pack]')) {
      const pack = packData.packs.find((p) => p.id === row.dataset.pack)!;
      const worth = row.querySelector<HTMLElement>('[data-out="worth"]')!;
      const per = row.querySelector<HTMLElement>('[data-out="per"]')!;
      if (!ok) {
        worth.textContent = per.textContent = '–';
        continue;
      }
      worth.textContent = fmt(packValue(pack).gemValue * perGem, 2);
      const p = starPricePerLegendary(pack, perGem);
      per.textContent = Number.isFinite(p) ? fmt(p, 0) : '–';
    }
  }
  price.addEventListener('input', update);
  gems.addEventListener('input', update);
</script>

<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  h2 { font-size: 18px; font-weight: 600; margin: 32px 0 8px; }
  .h-icon { vertical-align: -6px; margin-right: 8px; }
  .lead, .text { color: var(--soft); max-width: 70ch; margin: 0; }
  .verdict { margin: 12px 0 0; font-family: var(--display); font-size: 17px; }
  .verdict strong { color: var(--accent); }
  .hint { color: var(--muted); font-size: 14px; margin: 0 0 12px; max-width: 80ch; }
  .hint a, .how a { color: var(--accent); }
  .card { margin-top: 24px; padding: 4px 20px 20px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
  .card h2 { margin-top: 16px; }
  .packs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 12px; }
  .pack { padding-top: 16px; }
  .pack-head { display: flex; align-items: baseline; gap: 10px; }
  .pack-head h2 { margin: 0; flex: 1; font-size: 18px; }
  .rank { font-family: var(--display); font-weight: 700; color: var(--accent); }
  .price { font-family: var(--display); font-weight: 700; font-size: 20px; }
  .limit { margin: 2px 0 12px; color: var(--muted); font-size: 14px; }
  .contents { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .contents li { display: grid; justify-items: center; gap: 2px; width: 64px; text-align: center; }
  .tile {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    width: 56px; height: 56px; border-radius: 12px;
    background: radial-gradient(circle at 50% 40%, color-mix(in srgb, var(--accent) 18%, var(--surface-2)), var(--surface-2));
    border: 1px solid var(--line);
  }
  .tile img { width: 80%; height: 80%; object-fit: contain; }
  .contents .n { font-family: var(--display); font-weight: 700; font-size: 15px; }
  .contents .what { color: var(--muted); font-size: 12px; line-height: 1.2; }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 0; }
  .stats div { padding: 10px 12px; border-radius: 12px; background: var(--surface-3); border: 1px solid var(--line); }
  .stats dt { color: var(--muted); font-size: 13px; }
  .stats dd { margin: 2px 0 0; font-family: var(--display); font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .calc { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .calc label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--muted); }
  input[type='number'] {
    min-height: 44px; padding: 0 10px; border-radius: 10px; background: var(--surface-2);
    border: 1px solid var(--line); color: var(--text); font: inherit; font-size: 15px; width: 100%; box-sizing: border-box;
  }
  .table-wrap { overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); }
  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--line); }
  thead th { background: var(--surface-3); color: var(--muted); font-weight: 600; }
  tbody th { color: var(--text); font-weight: 500; white-space: nowrap; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  tbody tr:last-child > * { border-bottom: 0; }
  .table-wrap + .hint { margin-top: 12px; }
  .how { padding-left: 20px; display: grid; gap: 4px; }

  @media (max-width: 720px) {
    h1 { font-size: 22px; }
    .card { padding: 4px 14px 14px; }
    .pack { padding-top: 14px; }
    .packs { grid-template-columns: 1fr; }
    .stats dd { font-size: 18px; }
  }
</style>
