---
import Base from '../../layouts/Base.astro';
import HeroArt from '../../components/HeroArt.astro';
import TierBadge from '../../components/TierBadge.astro';
import { classIcon, elementIcon, skillIcon } from '../../lib/art';
import { heroes, heroHref, heroRefsByConfigId, heroSlug, href, ratingFor, skillsFor, type Hero } from '../../lib/data';
import {
  className,
  formatStat,
  rankNumber,
  rarityColor,
  richText,
  skillTypeName,
  statFields,
  tierColor,
} from '../../lib/format';
import { bestTier, heroTiers, tierNames } from '../../lib/tierData';
import { similarTo } from '../../lib/similar';
import { fullyAwakened } from '../../lib/awakening';
import { effectsFor, linkEffects } from '../../lib/effects';
import { legendaryPool, summons } from '../../lib/summons';

export function getStaticPaths() {
  return heroes.map((hero) => ({ params: { slug: heroSlug(hero.id) }, props: { hero } }));
}

const { hero } = Astro.props as { hero: Hero };
const skills = skillsFor(hero.id).filter((s) => s.levels && s.levels.length > 0);
const rating = ratingFor(hero.id);
// #skill-1, #skill-combo… for links to one skill.
const skillAnchor = (type: string) => `skill-${type.replace(/^ActiveSkill/, '').toLowerCase()}`;
const configId = Object.entries(heroRefsByConfigId).find(([, ref]) => ref.id === hero.id)?.[0] ?? '';
const color = rarityColor[hero.rarity] ?? '#B5B1D3';

const keyStats = statFields.slice(0, 6);
const otherStats = statFields.slice(6);

// Stats tab: first day, 6★ level 60, and 6★ level 60 with every Awakening node.
const awakened = fullyAwakened(hero);
const statCols = [
  { label: 'Lv 1', sub: `${rankNumber(hero.baseRank)}★`, stats: hero.statsByRank[hero.baseRank]['1'] },
  { label: 'Lv 60', sub: '6★', stats: hero.maxStats },
  ...(awakened ? [{ label: 'Awakened', sub: 'Lv 60, est.', stats: awakened.stats }] : []),
];

// Where this Invoker sits on each tier list, best first.
const tiers = heroTiers(hero.id).sort((a, b) => tierNames.indexOf(a.tier) - tierNames.indexOf(b.tier));

// The Compare link appears once the compare page (built in another thread) exists.
const hasCompare = Object.keys(import.meta.glob('./compare.astro')).length > 0;

// Summon items whose Legendary pool includes this Invoker.
const summonedBy = summons.items.filter((i) => legendaryPool(i).some((h) => h.id === hero.id)).map((i) => i.name);

// Buffs, debuffs and control in this kit, linked to the glossary; skill texts link each bracketed effect too.
const kitEffects = effectsFor(hero.id);
const effectHref = (slug: string) => href(`effects/${slug}`);

// Stand-ins for this Invoker; the ones in the player's box get marked by the script below.
const similar = similarTo(hero).map((h) => ({
  hero: h,
  best: bestTier(h.id),
  configId: Object.entries(heroRefsByConfigId).find(([, ref]) => ref.id === h.id)?.[0] ?? '',
}));

// Plain-text preview of a skill for the overview list.
const plain = (t: string) => t.replace(/<br\s*\/?>/g, ' ').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
---
<Base title={hero.name}>
  <a class="back" href={href('heroes')}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
    All Invokers
  </a>

  <section class="hero" style={`--rarity: ${color}`}>
    <div class="hero-art"><HeroArt hero={hero} large /></div>
    <div class="hero-info">
      <div class="title-row">
        <div>
          <span class="rarity">{hero.rarity}</span>
          <h1>{hero.name}</h1>
        </div>
        <TierBadge heroId={hero.id} size="lg" />
      </div>
      <ul class="tags">
        <li><a href={href(`heroes?element=${encodeURIComponent(hero.element)}`)} title={`All ${hero.element} Invokers`}>{elementIcon(hero.element) && <img src={elementIcon(hero.element)} alt="" width="18" height="18" />}{hero.element}</a></li>
        <li><a href={href(`heroes?faction=${encodeURIComponent(hero.faction)}`)} title={`All ${hero.faction} Invokers`}>{hero.faction}</a></li>
        <li><a href={href(`heroes?class=${encodeURIComponent(String(hero.class))}`)} title={`All ${className(hero.class)} Invokers`}>{classIcon(String(hero.class)) && <img src={classIcon(String(hero.class))} alt="" width="18" height="18" />}{className(hero.class)}</a></li>
        <li>Starts at {rankNumber(hero.baseRank)}★</li>
      </ul>
      {hasCompare && (
        <a class="compare" href={href(`heroes/compare?h=${heroSlug(hero.id)}`)}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v18M16 3v18M3 8h5M16 16h5"></path></svg>
          Compare
        </a>
      )}
      <a class="compare" href={href(`team?h=${heroSlug(hero.id)}`)}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"></circle><path d="M3 20c0-3 3-5 6-5s6 2 6 5M16 5a3 3 0 010 6M18 15c2 .5 3 2.5 3 5"></path></svg>
        Build a team
      </a>
      {summonedBy.length > 0 && <p class="summon">Legendary from <a href={href('summons#pools-title')}>{summonedBy.map((n) => `${n}s`).join(' and ')}</a></p>}
      {rating?.note && <p class="note">{rating.note}</p>}
      <p id="owned" class="owned" data-config-id={configId} data-box-href={href('my-box')} hidden></p>
    </div>
  </section>

  <div class="tabs" role="tablist" aria-label="Hero details" hidden>
    <button type="button" role="tab" id="tab-overview" aria-controls="overview" aria-selected="true">Overview</button>
    <button type="button" role="tab" id="tab-skills" aria-controls="skills" aria-selected="false" tabindex="-1">Skills</button>
    <button type="button" role="tab" id="tab-stats" aria-controls="stats" aria-selected="false" tabindex="-1">Stats</button>
  </div>

  <section id="overview" class="panel" role="tabpanel" aria-labelledby="tab-overview">
    <h2>Max stats</h2>
    <p class="hint">Rank 6, level 60, without gear or awakening. <a href={href(`heroes/compare?h=${heroSlug(hero.id)}`)}>Compare with others</a></p>
    <div class="stat-grid">
      {keyStats.map((f) => (
        <div class="stat">
          <span class="stat-label">{f.short}</span>
          <span class="stat-value">{formatStat(hero.maxStats[f.key], f.percent)}</span>
        </div>
      ))}
    </div>
    <dl class="stat-list">
      {otherStats.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{formatStat(hero.maxStats[f.key], f.percent)}</dd>
        </div>
      ))}
    </dl>

    <h2>Skills</h2>
    <ul class="skill-list">
      {skills.map((s) => (
        <li>
          <a href={`#${skillAnchor(s.type)}`} data-goto="skills">
            <span class="skill-icon">{skillIcon(hero.id, s.type) && <img src={skillIcon(hero.id, s.type)} alt="" width="40" height="40" loading="lazy" />}</span>
            <span class="skill-type">{skillTypeName(s.type)}</span>
            <span class="skill-title">{s.title}</span>
            <span class="skill-preview">{plain(s.levels![0].text)}</span>
          </a>
        </li>
      ))}
    </ul>

    {kitEffects.length > 0 && (
      <>
        <h2>Effects</h2>
        <ul class="effect-list">
          {kitEffects.map((e) => <li><a href={effectHref(e.slug)} title={e.text}>{e.name}</a></li>)}
        </ul>
      </>
    )}

    {tiers.length > 0 && (
      <>
        <h2>Tier lists</h2>
        <ul class="tier-list">
          {tiers.map((t) => (
            <li>
              <a href={href(`tiers/invokers/${t.list.id}`)}>
                <span class="tier-letter" style={`--tier: ${tierColor[t.tier] ?? '#5FDCF7'}`}>{t.tier}</span>
                {t.list.label}
              </a>
            </li>
          ))}
        </ul>
      </>
    )}

    {similar.length > 0 && (
      <>
        <h2 id="similar">Similar Invokers</h2>
        <p class="hint">Same class, {hero.element} first. <span id="similar-owned" hidden>Ones in your box are marked.</span></p>
        <ul class="similar">
          {similar.map(({ hero: h, best, configId: cid }) => (
            <li data-config-id={cid}>
              <a href={heroHref(h.id)} style={`--rarity: ${rarityColor[h.rarity] ?? '#B5B1D3'}`}>
                <span class="similar-art">
                  <HeroArt hero={h} />
                  {best && <span class="similar-tier" style={`--tier: ${tierColor[best.tier] ?? '#5FDCF7'}`} title={`${best.tier} on ${best.list.label}`}>{best.tier}</span>}
                  <span class="similar-owned">Owned</span>
                </span>
                <span class="similar-name">{h.name}</span>
                <span class="similar-meta">{elementIcon(h.element) && <img src={elementIcon(h.element)} alt="" width="14" height="14" loading="lazy" />}{h.element} · {h.rarity}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="hint more"><a href={href(`heroes?class=${encodeURIComponent(String(hero.class))}&element=${encodeURIComponent(hero.element)}`)}>All {hero.element} {className(hero.class)} Invokers</a> · <a href={href(`heroes/compare?h=${[hero, ...similar.slice(0, 3).map((x) => x.hero)].map((x) => heroSlug(x.id)).join(',')}`)}>Compare with the top 3</a></p>
      </>
    )}
  </section>

  <section id="skills" class="panel" role="tabpanel" aria-labelledby="tab-skills">
    <h2>Skills</h2>
    <p class="hint"><a href={href(`skill-costs?rarity=${hero.rarity}`)}>Upgrade costs for {hero.rarity} skills</a></p>
    {skills.map((s) => {
      const levels = s.levels!;
      const max = levels[levels.length - 1].level;
      return (
        <article class="skill" id={skillAnchor(s.type)}>
          <header>
            <span class="skill-icon">{skillIcon(hero.id, s.type) && <img src={skillIcon(hero.id, s.type)} alt="" width="48" height="48" loading="lazy" />}</span>
            <div>
              <span class="skill-type">{skillTypeName(s.type)}</span>
              <h3>{s.title}</h3>
            </div>
          </header>
          {levels.length > 1 && (
            <label class="level">
              <span>Level <output>{levels[0].level}</output> of {max}</span>
              <input type="range" min={levels[0].level} max={max} step="1" value={levels[0].level} />
            </label>
          )}
          {levels.map((l, i) => (
            <div class="skill-text" data-level={l.level} hidden={i > 0} set:html={linkEffects(richText(l.text), effectHref)} />
          ))}
        </article>
      );
    })}
  </section>

  <section id="stats" class="panel" role="tabpanel" aria-labelledby="tab-stats">
    <h2>Stats</h2>
    <p class="hint">Without gear. Awakened (estimated) has every Awakening node{awakened?.titanTime ? `, plus +${awakened.titanTime}s Titan Invokation Time` : ''}. <a href={href('ascension')}>Ascension costs</a> · <a href={href('blog/levelling-vs-awakening')}>Levelling vs Awakening</a></p>
    <div class="table-wrap">
      <table class="stat-cols">
        <caption class="visually-hidden">{hero.name} stats at level 1, level 60 and fully awakened</caption>
        <thead>
          <tr>
            <th scope="col">Stat</th>
            {statCols.map((c) => <th scope="col">{c.label}<span class="sub">{c.sub}</span></th>)}
          </tr>
        </thead>
        <tbody>
          {statFields.map((f) => (
            <tr>
              <th scope="row">{f.short}</th>
              {statCols.map((c) => <td>{formatStat(c.stats[f.key], f.percent)}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  // Shows how this invoker looks in the player's imported box, if they have one.
  // Only import the small store module here: lib/data pulls the whole data pack into the bundle.
  import { loadBox } from '../../lib/box/store';

  const STARS = ['Unknown', 'One', 'Two', 'Three', 'Four', 'Five', 'Six'];
  const el = document.getElementById('owned')!;
  loadBox().then((box) => {
    const copies = box?.heroes.filter((h) => h.configId === el.dataset.configId) ?? [];
    if (!copies.length) return;
    const best = copies.reduce((a, b) => (b.level > a.level ? b : a));
    const extra = copies.length > 1 ? ` (${copies.length} copies)` : '';
    el.replaceChildren(`In your box: ${STARS.indexOf(best.rank)}★, level ${best.level}, awakening ${best.awakenLevel}${extra}. `);
    const link = document.createElement('a');
    link.href = el.dataset.boxHref ?? '';
    link.textContent = 'My box';
    el.append(link);
    el.hidden = false;
  });

  // Marks the Similar Invokers the player owns.
  loadBox().then((box) => {
    const owned = new Set(box?.heroes.map((h) => h.configId) ?? []);
    let any = false;
    for (const li of document.querySelectorAll<HTMLElement>('.similar [data-config-id]')) {
      const has = owned.has(li.dataset.configId ?? '');
      li.classList.toggle('is-owned', has);
      any ||= has;
    }
    document.getElementById('similar-owned')!.hidden = !any;
  });
</script>

<script>
  // Tabs. Without JavaScript every panel simply shows, one after another.
  const tablist = document.querySelector<HTMLElement>('[role=tablist]')!;
  const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
  tablist.hidden = false;

  function select(id: string, focus = false) {
    tabs.forEach((t, i) => {
      const on = t.getAttribute('aria-controls') === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      panels[i].hidden = !on;
      if (on && focus) t.focus();
    });
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => {
      select(t.getAttribute('aria-controls')!);
      history.replaceState(null, '', `#${t.getAttribute('aria-controls')}`);
    });
    t.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (step) select(tabs[(i + step + tabs.length) % tabs.length].getAttribute('aria-controls')!, true);
    });
  });
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-goto]')) {
    a.addEventListener('click', () => select(a.dataset.goto!));
  }
  const hash = location.hash.slice(1);
  select(hash.startsWith('skill-') ? 'skills' : panels.some((p) => p.id === hash) ? hash : 'overview');
  if (hash.startsWith('skill-')) document.getElementById(hash)?.scrollIntoView();

  // Skill level sliders.
  for (const skill of document.querySelectorAll<HTMLElement>('.skill')) {
    const input = skill.querySelector<HTMLInputElement>('input[type=range]');
    if (!input) continue;
    const out = skill.querySelector('output')!;
    const texts = [...skill.querySelectorAll<HTMLElement>('.skill-text')];
    // Some skills skip levels (e.g. 1, 2, 6, 8); between them the last listed text still applies.
    input.addEventListener('input', () => {
      out.textContent = input.value;
      const level = Number(input.value);
      const shown = texts.filter((t) => Number(t.dataset.level) <= level).pop();
      for (const t of texts) t.hidden = t !== shown;
    });
  }
</script>

<style>
  .owned { margin: 12px 0 0; background: var(--surface-2); border-left: 3px solid var(--accent); padding: 8px 12px; border-radius: 8px; }
  .compare {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    margin-top: 12px;
    padding: 0 14px;
    border-radius: 18px;
    border: 1px solid var(--line);
    color: var(--soft);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .compare:hover { border-color: var(--accent); color: var(--text); }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--soft);
  }
  .hero {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 32px;
    align-items: end;
    margin-bottom: 24px;
  }
  .hero-art {
    height: 360px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-bottom: 3px solid var(--rarity);
  }
  .title-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .rarity { color: var(--rarity); font-weight: 600; font-size: 14px; }
  h1 { margin: 4px 0 0; font-size: 40px; font-weight: 700; }
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 16px 0 0; }
  .tags li {
    padding: 6px 12px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .tags img { display: block; }
  .tags a { display: inline-flex; align-items: center; gap: 6px; color: inherit; text-decoration: none; }
  .tags li:has(a:hover) { border-color: var(--accent); }
  .summon { margin: 12px 0 0; color: var(--soft); font-size: 14px; }
  .compare + .compare { margin-left: 8px; }
  .note { color: var(--soft); margin: 16px 0 0; max-width: 60ch; }

  .tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin-bottom: 8px; }
  .tabs[hidden] { display: none; }
  .tabs button {
    min-height: 44px;
    padding: 0 14px;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--soft);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] { color: var(--text); font-weight: 600; border-bottom-color: var(--accent); }
  .panel h2 { font-size: 18px; font-weight: 600; margin: 24px 0 8px; }
  .hint { color: var(--muted); font-size: 14px; margin: -4px 0 12px; }

  .effect-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .effect-list a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    font-size: 14px;
  }
  .effect-list a:hover { border-color: var(--accent); }
  .skill-text :global(.effect-link) { color: inherit; text-decoration: underline dotted; text-underline-offset: 3px; }
  .tier-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tier-list a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 12px 0 4px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
  }
  .tier-list a:hover { border-color: var(--accent); color: var(--text); }
  .tier-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--tier);
    color: var(--bg);
    font-family: var(--display);
    font-weight: 800;
    font-size: 13px;
  }

  .similar { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 10px; }
  .similar a { display: flex; flex-direction: column; gap: 2px; color: var(--text); text-decoration: none; font-size: 13px; }
  .similar-art {
    position: relative;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-bottom: 2px solid var(--rarity);
    margin-bottom: 4px;
  }
  .similar a:hover .similar-art { border-color: var(--accent); }
  .similar-tier {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tier);
    color: var(--bg);
    font-family: var(--display);
    font-weight: 800;
    font-size: 12px;
  }
  .similar-owned {
    display: none;
    position: absolute;
    left: 6px;
    bottom: 6px;
    padding: 2px 8px;
    border-radius: 10px;
    background: var(--accent);
    color: var(--bg);
    font-size: 11px;
    font-weight: 700;
  }
  .similar .is-owned .similar-owned { display: block; }
  .similar .is-owned .similar-art { border-color: var(--accent); }
  .similar-name { font-weight: 600; line-height: 1.25; }
  .similar-meta { display: inline-flex; align-items: center; gap: 4px; color: var(--muted); font-size: 12px; }
  .hint.more { margin: 10px 0 0; }

  .stat-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; }
  .stat {
    padding: 12px;
    border-radius: 10px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat-label { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .stat-value { font-family: var(--display); font-weight: 600; font-size: 20px; }
  .stat-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0 24px;
    margin: 12px 0 0;
  }
  .stat-list div {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }
  .stat-list dt { color: var(--soft); }
  .stat-list dd { margin: 0; font-weight: 600; }

  .skill-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .skill-list a {
    display: grid;
    grid-template-columns: 40px 96px 1fr;
    align-items: center;
    gap: 2px 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
  }
  .skill-list a:hover { background: var(--surface-2); }
  .skill-type { font-size: 12px; color: var(--accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }
  .skill-title { font-weight: 600; }
  .skill-icon {
    width: 40px;
    height: 40px;
