---
import SeeAlso from '../../components/SeeAlso.astro';
import Base from '../../layouts/Base.astro';
import HeroArt from '../../components/HeroArt.astro';
import TierBadge from '../../components/TierBadge.astro';
import { classIcon, elementIcon, factionCard, rarityCard } from '../../lib/art';
import { heroes, heroHref, href } from '../../lib/data';
import { className, rarityColor, rarityOrder } from '../../lib/format';
import { effects, effectsFor } from '../../lib/effects';
import { corruptionLabel, hasHeroTolerances, heroTolerances } from '../../lib/tolerances';

const sorted = [...heroes].sort(
  (a, b) => rarityOrder.indexOf(a.rarity) - rarityOrder.indexOf(b.rarity) || a.name.localeCompare(b.name),
);

const distinct = (key: 'element' | 'faction' | 'class') => [...new Set(heroes.map((h) => h[key]))].sort();

// A picture on each filter option: element and class icons, the faction's card, the rarity's card colour.
const optionArt = (key: string, value: string) =>
  key === 'element' ? elementIcon(value) : key === 'class' ? classIcon(value) : key === 'faction' ? factionCard(value) : key === 'rarity' ? rarityCard(value) : undefined;

const groups = [
  { key: 'element', label: 'Element', options: distinct('element').map((v) => [v, v]) },
  { key: 'faction', label: 'Faction', options: distinct('faction').map((v) => [v, v]) },
  { key: 'class', label: 'Class', options: distinct('class').map((v) => [v, className(v)]) },
  {
    key: 'rarity',
    label: 'Rarity',
    options: rarityOrder.filter((r) => heroes.some((h) => h.rarity === r)).map((v) => [v, v]),
  },
  { key: 'effect', label: 'Effect', options: effects.filter((e) => heroes.some((h) => effectsFor(h.id).includes(e))).map((e) => [e.slug, e.name]) },
  // Shown once the data says which tolerances each Invoker has; boss pages link here with ?tolerance=daze.
  ...(hasHeroTolerances
    ? [{
        key: 'tolerance',
        label: 'Tolerance',
        options: [...new Set([...heroTolerances.values()].flat())].sort().map((v) => [v, corruptionLabel(v)]),
      }]
    : []),
];
---
<Base title="Invokers">
  <div class="head">
    <h1>Invokers</h1>
    <span class="count" id="count" aria-live="polite">{sorted.length} total</span>
  </div>
  <p class="links">
    <a href={href('tiers')}>Tier lists</a>
    <span aria-hidden="true">·</span>
    <a href={href('titans')}>Titans</a>
    <span aria-hidden="true">·</span>
    <a href={href('effects')}>Status effects</a>
    <span aria-hidden="true">·</span>
    <a href={href('heroes/compare')}>Compare Invokers</a>
    <span aria-hidden="true">·</span>
    <a href={href('team')}>Team builder</a>
  </p>

  <div class="controls">
    <label class="search">
      <span class="visually-hidden">Find an Invoker</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
      <input id="q" type="search" placeholder="Find an Invoker" autocomplete="off" />
    </label>
    <div class="chips" role="group" aria-label="Filters">
      <button type="button" class="chip" id="clear" aria-pressed="true">All</button>
      {groups.map((g) => (
        <button type="button" class="chip" data-group={g.key} data-label={g.label} aria-expanded="false" aria-controls={`panel-${g.key}`}>
          {g.label}
        </button>
      ))}
    </div>
    {groups.map((g) => (
      <div class="panel" id={`panel-${g.key}`} hidden>
        {g.options.map(([value, label]) => (
          <button type="button" class="chip option" data-filter={g.key} data-value={value} aria-pressed="false">{optionArt(g.key, value) && <img class:list={['opt-art', `opt-${g.key}`]} src={optionArt(g.key, value)} alt="" width="22" height="22" loading="lazy" />}{label}</button>
        ))}
      </div>
    ))}
  </div>

  <ul class="grid" id="grid">
    {sorted.map((h) => (
      <li
        data-name={h.name.toLowerCase()}
        data-element={h.element}
        data-faction={h.faction}
        data-class={h.class}
        data-rarity={h.rarity}
        data-tolerance={heroTolerances.get(h.id)?.join(' ')}
        data-effect={effectsFor(h.id).map((e) => e.slug).join(' ')}
      >
        <a class="card" href={heroHref(h.id)} style={`--rarity: ${rarityColor[h.rarity] ?? '#E2D7BF'}`}>
          <div class="card-art">
            <HeroArt hero={h} />
            <span class="card-tier"><TierBadge heroId={h.id} /></span>
          </div>
          <div class="card-body">
            <span class="card-name">{h.name}</span>
            <span class="card-meta"><span class="rarity">{h.rarity}</span> · {elementIcon(h.element) && <img src={elementIcon(h.element)} alt="" width="14" height="14" loading="lazy" />}{h.element} · {className(h.class)}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
  <p class="empty" id="empty" hidden>No Invokers match these filters.</p>
  <SeeAlso links={[
    { path: 'tiers', label: 'Tier lists' },
    { path: 'heroes/compare', label: 'Compare Invokers' },
    { path: 'team', label: 'Team builder' },
    { path: 'simulator', label: 'Simulator' },
    { path: 'titans', label: 'Titans' },
  ]} />
</Base>

<script>
  const keys = ['element', 'faction', 'class', 'rarity', 'effect', 'tolerance'] as const;
  type Key = (typeof keys)[number];
  const state: Record<Key, string> & { q: string } = { element: '', faction: '', class: '', rarity: '', effect: '', tolerance: '', q: '' };

  const items = [...document.querySelectorAll<HTMLLIElement>('#grid > li')];
  const q = document.querySelector<HTMLInputElement>('#q')!;
  const count = document.querySelector<HTMLElement>('#count')!;
  const empty = document.querySelector<HTMLElement>('#empty')!;
  const clear = document.querySelector<HTMLButtonElement>('#clear')!;
  const groupButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-group]')];
  const options = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];

  // Filters live in the URL so a filtered list can be shared.
  const params = new URLSearchParams(location.search);
  for (const k of keys) state[k] = params.get(k) ?? '';
  state.q = params.get('q') ?? '';
  q.value = state.q;

  function apply() {
    const needle = state.q.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const ok =
        keys.every((k) => !state[k] || (k === 'tolerance' || k === 'effect' ? (li.dataset[k] ?? '').split(' ').includes(state[k]) : li.dataset[k] === state[k])) && (!needle || li.dataset.name!.includes(needle));
      li.hidden = !ok;
      if (ok) shown++;
    }
    const filtered = keys.some((k) => state[k]) || needle;
    count.textContent = filtered ? `${shown} of ${items.length}` : `${items.length} total`;
    empty.hidden = shown > 0;
    clear.setAttribute('aria-pressed', String(!filtered));
    for (const b of groupButtons) {
      const k = b.dataset.group as Key;
      const picked = options.find((o) => o.dataset.filter === k && o.dataset.value === state[k]);
      b.textContent = picked ? `${b.dataset.label}: ${picked.textContent}` : b.dataset.label!;
      b.classList.toggle('active', !!state[k]);
    }
    for (const o of options) o.setAttribute('aria-pressed', String(state[o.dataset.filter as Key] === o.dataset.value));

    const next = new URLSearchParams();
    for (const k of keys) if (state[k]) next.set(k, state[k]);
    if (state.q) next.set('q', state.q);
    const qs = next.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function openPanel(key: string | null) {
    for (const b of groupButtons) {
      const open = b.dataset.group === key && b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(open));
      document.getElementById(`panel-${b.dataset.group}`)!.hidden = !open;
    }
  }

  for (const b of groupButtons) b.addEventListener('click', () => openPanel(b.dataset.group!));
  for (const o of options) {
    o.addEventListener('click', () => {
      const k = o.dataset.filter as Key;
      state[k] = state[k] === o.dataset.value ? '' : o.dataset.value!;
      openPanel(null);
      apply();
    });
  }
  clear.addEventListener('click', () => {
    for (const k of keys) state[k] = '';
    state.q = '';
    q.value = '';
    openPanel(null);
    apply();
  });
  q.addEventListener('input', () => {
    state.q = q.value;
    apply();
  });

  apply();
</script>

<style>
  .links { margin: 0 0 16px; display: flex; flex-wrap: wrap; gap: 8px; color: var(--muted); font-size: 15px; }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin: 16px 0 12px;
  }
  h1 { margin: 0; font-size: 28px; font-weight: 700; }
  .count { font-size: 14px; color: var(--muted); }
  .controls { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 360px;
    height: 44px;
    padding: 0 16px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .search:focus-within { border-color: var(--accent); }
  .search input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: none;
    color: var(--text);
    font: inherit;
    font-size: 15px;
  }
  .chips, .panel { display: flex; flex-wrap: wrap; gap: 8px; }
  .panel[hidden] { display: none; }
  .panel {
    padding: 12px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .chip {
    min-height: 40px;
    padding: 0 16px;
    border-radius: var(--radius);
    background: transparent;
    border: 1px solid var(--line);
    color: var(--soft);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
    white-space: nowrap;
  }
  .chip.option { display: inline-flex; align-items: center; gap: 8px; }
  .chip.option:has(.opt-art) { padding-left: 8px; }
  .opt-art { width: 22px; height: 22px; object-fit: contain; flex: none; }
  .opt-faction, .opt-rarity { border-radius: 50%; object-fit: cover; object-position: 50% 18%; }
  .chip:hover { border-color: var(--muted); color: var(--text); }
  .chip[aria-pressed='true'], .chip.active, .chip[aria-expanded='true'] {
    background: var(--surface-2);
    border-color: var(--accent);
    color: var(--text);
    font-weight: 600;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(176px, 1fr));
    gap: 16px;
  }
  .grid li[hidden] { display: none; }
  .card {
    display: flex;
    flex-direction: column;
    height: 300px;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--text);
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover { color: var(--text); border-color: var(--rarity); transform: translateY(-2px); }
  .card-art { position: relative; flex: 1; min-height: 0; }
  .card-tier { position: absolute; top: 10px; right: 10px; }
  .card-body {
    padding: 12px 14px;
    background: var(--surface-3);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .card-name { font-family: var(--display); font-weight: 600; font-size: 16px; line-height: 1.25; }
  .card-meta { font-size: 13px; color: var(--soft); }
  .card-meta img { vertical-align: -2px; margin-right: 3px; }
  .rarity { color: var(--rarity); font-weight: 600; }
  .empty { color: var(--soft); }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    h1 { font-size: 22px; }
    .search { max-width: none; }
    .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin: 0 -16px;
      padding: 0 16px;
      scrollbar-width: none;
    }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .card { height: 236px; }
    .card-name { font-size: 15px; }
    .card-meta { font-size: 12px; }
  }
</style>
