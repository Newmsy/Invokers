---
import Base from '../../layouts/Base.astro';
import HeroArt from '../../components/HeroArt.astro';
import TierBadge from '../../components/TierBadge.astro';
import { heroes, heroRefsByConfigId, href, ratingFor, skillsFor, type Hero } from '../../lib/data';
import {
  className,
  formatStat,
  rankNumber,
  rankOrder,
  rarityColor,
  richText,
  skillTypeName,
  statFields,
} from '../../lib/format';

export function getStaticPaths() {
  return heroes.map((hero) => ({ params: { id: hero.id }, props: { hero } }));
}

const { hero } = Astro.props as { hero: Hero };
const skills = skillsFor(hero.id).filter((s) => s.levels && s.levels.length > 0);
const rating = ratingFor(hero.id);
const configId = Object.entries(heroRefsByConfigId).find(([, ref]) => ref.id === hero.id)?.[0] ?? '';
const color = rarityColor[hero.rarity] ?? '#B5B1D3';

const keyStats = statFields.slice(0, 6);
const otherStats = statFields.slice(6);

const ranks = rankOrder.filter((r) => hero.statsByRank[r]);
const levelsOf = (rank: string) =>
  Object.keys(hero.statsByRank[rank] ?? {}).sort((a, b) => Number(a) - Number(b));
const topRank = ranks[ranks.length - 1];

// Plain-text preview of a skill for the overview list.
const plain = (t: string) => t.replace(/<br\s*\/?>/g, ' ').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
---
<Base title={hero.name}>
  <a class="back" href={href('heroes')}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
    All Invokers
  </a>

  <section class="hero" style={`--rarity: ${color}`}>
    <div class="hero-art"><HeroArt hero={hero} /></div>
    <div class="hero-info">
      <div class="title-row">
        <div>
          <span class="rarity">{hero.rarity}</span>
          <h1>{hero.name}</h1>
        </div>
        <TierBadge heroId={hero.id} size="lg" />
      </div>
      <ul class="tags">
        <li>{hero.element}</li>
        <li>{hero.faction}</li>
        <li>{className(hero.class)}</li>
        <li>Starts at {rankNumber(hero.baseRank)}★</li>
      </ul>
      {rating?.note && <p class="note">{rating.note}</p>}
      <p id="owned" class="owned" data-config-id={configId} data-box-href={href('my-box')} hidden></p>
    </div>
  </section>

  <div class="tabs" role="tablist" aria-label="Hero details" hidden>
    <button type="button" role="tab" id="tab-overview" aria-controls="overview" aria-selected="true">Overview</button>
    <button type="button" role="tab" id="tab-skills" aria-controls="skills" aria-selected="false" tabindex="-1">Skills</button>
    <button type="button" role="tab" id="tab-stats" aria-controls="stats" aria-selected="false" tabindex="-1">Stats</button>
  </div>

  <section id="overview" class="panel" role="tabpanel" aria-labelledby="tab-overview">
    <h2>Max stats</h2>
    <p class="hint">Rank 6, level 60, without gear or awakening.</p>
    <div class="stat-grid">
      {keyStats.map((f) => (
        <div class="stat">
          <span class="stat-label">{f.short}</span>
          <span class="stat-value">{formatStat(hero.maxStats[f.key], f.percent)}</span>
        </div>
      ))}
    </div>
    <dl class="stat-list">
      {otherStats.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{formatStat(hero.maxStats[f.key], f.percent)}</dd>
        </div>
      ))}
    </dl>

    <h2>Skills</h2>
    <ul class="skill-list">
      {skills.map((s) => (
        <li>
          <a href={`#skill-${s.type}`} data-goto="skills">
            <span class="skill-type">{skillTypeName(s.type)}</span>
            <span class="skill-title">{s.title}</span>
            <span class="skill-preview">{plain(s.levels![0].text)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="skills" class="panel" role="tabpanel" aria-labelledby="tab-skills">
    <h2>Skills</h2>
    {skills.map((s) => {
      const levels = s.levels!;
      const max = levels[levels.length - 1].level;
      return (
        <article class="skill" id={`skill-${s.type}`}>
          <header>
            <span class="skill-type">{skillTypeName(s.type)}</span>
            <h3>{s.title}</h3>
          </header>
          {levels.length > 1 && (
            <label class="level">
              <span>Level <output>{levels[0].level}</output> of {max}</span>
              <input type="range" min={levels[0].level} max={max} step="1" value={levels[0].level} />
            </label>
          )}
          {levels.map((l, i) => (
            <div class="skill-text" data-level={l.level} hidden={i > 0} set:html={richText(l.text)} />
          ))}
        </article>
      );
    })}
  </section>

  <section id="stats" class="panel" role="tabpanel" aria-labelledby="tab-stats">
    <h2>Stats by rank and level</h2>
    <p class="hint">Base stats without gear or awakening.</p>
    <div class="rank-picker" role="group" aria-label="Rank">
      {ranks.map((r) => (
        <button type="button" class="chip" data-rank={r} aria-pressed={r === topRank ? 'true' : 'false'}>{rankNumber(r)}★</button>
      ))}
    </div>
    {ranks.map((r) => (
      <div class="table-wrap" data-rank-table={r} hidden={r !== topRank}>
        <table>
          <caption class="visually-hidden">Rank {rankNumber(r)} stats</caption>
          <thead>
            <tr>
              <th scope="col">Level</th>
              {levelsOf(r).map((lv) => <th scope="col">{lv}</th>)}
            </tr>
          </thead>
          <tbody>
            {statFields.map((f) => (
              <tr>
                <th scope="row">{f.short}</th>
                {levelsOf(r).map((lv) => <td>{formatStat(hero.statsByRank[r][lv][f.key], f.percent)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </section>
</Base>

<script>
  // Shows how this invoker looks in the player's imported box, if they have one.
  // Only import the small store module here: lib/data pulls the whole data pack into the bundle.
  import { loadBox } from '../../lib/box/store';

  const STARS = ['Unknown', 'One', 'Two', 'Three', 'Four', 'Five', 'Six'];
  const el = document.getElementById('owned')!;
  loadBox().then((box) => {
    const copies = box?.heroes.filter((h) => h.configId === el.dataset.configId) ?? [];
    if (!copies.length) return;
    const best = copies.reduce((a, b) => (b.level > a.level ? b : a));
    const extra = copies.length > 1 ? ` (${copies.length} copies)` : '';
    el.replaceChildren(`In your box: ${STARS.indexOf(best.rank)}★, level ${best.level}, awakening ${best.awakenLevel}${extra}. `);
    const link = document.createElement('a');
    link.href = el.dataset.boxHref ?? '';
    link.textContent = 'My box';
    el.append(link);
    el.hidden = false;
  });
</script>

<script>
  // Tabs. Without JavaScript every panel simply shows, one after another.
  const tablist = document.querySelector<HTMLElement>('[role=tablist]')!;
  const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
  tablist.hidden = false;

  function select(id: string, focus = false) {
    tabs.forEach((t, i) => {
      const on = t.getAttribute('aria-controls') === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      panels[i].hidden = !on;
      if (on && focus) t.focus();
    });
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => {
      select(t.getAttribute('aria-controls')!);
      history.replaceState(null, '', `#${t.getAttribute('aria-controls')}`);
    });
    t.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (step) select(tabs[(i + step + tabs.length) % tabs.length].getAttribute('aria-controls')!, true);
    });
  });
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-goto]')) {
    a.addEventListener('click', () => select(a.dataset.goto!));
  }
  const hash = location.hash.slice(1);
  select(hash.startsWith('skill-') ? 'skills' : panels.some((p) => p.id === hash) ? hash : 'overview');
  if (hash.startsWith('skill-')) document.getElementById(hash)?.scrollIntoView();

  // Skill level sliders.
  for (const skill of document.querySelectorAll<HTMLElement>('.skill')) {
    const input = skill.querySelector<HTMLInputElement>('input[type=range]');
    if (!input) continue;
    const out = skill.querySelector('output')!;
    const texts = [...skill.querySelectorAll<HTMLElement>('.skill-text')];
    // Some skills skip levels (e.g. 1, 2, 6, 8); between them the last listed text still applies.
    input.addEventListener('input', () => {
      out.textContent = input.value;
      const level = Number(input.value);
      const shown = texts.filter((t) => Number(t.dataset.level) <= level).pop();
      for (const t of texts) t.hidden = t !== shown;
    });
  }

  // Rank picker on the stats tab.
  const rankButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-rank]')];
  for (const b of rankButtons) {
    b.addEventListener('click', () => {
      for (const o of rankButtons) o.setAttribute('aria-pressed', String(o === b));
      for (const t of document.querySelectorAll<HTMLElement>('[data-rank-table]')) {
        t.hidden = t.dataset.rankTable !== b.dataset.rank;
      }
    });
  }
</script>

<style>
  .owned { margin: 12px 0 0; background: var(--surface-2); border-left: 3px solid var(--accent); padding: 8px 12px; border-radius: 8px; }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--soft);
  }
  .hero {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 32px;
    align-items: end;
    margin-bottom: 24px;
  }
  .hero-art {
    height: 360px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-bottom: 3px solid var(--rarity);
  }
  .title-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .rarity { color: var(--rarity); font-weight: 600; font-size: 14px; }
  h1 { margin: 4px 0 0; font-size: 40px; font-weight: 700; }
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 16px 0 0; }
  .tags li {
    padding: 6px 12px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 14px;
  }
  .note { color: var(--soft); margin: 16px 0 0; max-width: 60ch; }

  .tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin-bottom: 8px; }
  .tabs[hidden] { display: none; }
  .tabs button {
    min-height: 44px;
    padding: 0 14px;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--soft);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] { color: var(--text); font-weight: 600; border-bottom-color: var(--accent); }
  .panel h2 { font-size: 18px; font-weight: 600; margin: 24px 0 8px; }
  .hint { color: var(--muted); font-size: 14px; margin: -4px 0 12px; }

  .stat-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; }
  .stat {
    padding: 12px;
    border-radius: 10px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat-label { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .stat-value { font-family: var(--display); font-weight: 600; font-size: 20px; }
  .stat-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0 24px;
    margin: 12px 0 0;
  }
  .stat-list div {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }
  .stat-list dt { color: var(--soft); }
  .stat-list dd { margin: 0; font-weight: 600; }

  .skill-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .skill-list a {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 2px 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
  }
  .skill-list a:hover { background: var(--surface-2); }
  .skill-type { font-size: 12px; color: var(--accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }
  .skill-title { font-weight: 600; }
  .skill-preview {
    grid-column: 2;
    font-size: 13px;
    color: var(--soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .skill {
    padding: 16px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    margin-bottom: 12px;
    scroll-margin-top: 16px;
  }
  .skill header { display: flex; flex-direction: column; gap: 2px; margin-bottom: 8px; }
  .skill h3 { margin: 0; font-size: 18px; font-weight: 600; }
  .level { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--soft); margin-bottom: 10px; max-width: 320px; }
  .level input { accent-color: var(--accent); width: 100%; min-height: 32px; }
  .skill-text { font-size: 15px; line-height: 1.6; }
  .skill-text[hidden] { display: none; }

  .rank-picker { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .chip {
    min-height: 40px;
    padding: 0 16px;
    border-radius: 20px;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--soft);
    font: inherit;
    cursor: pointer;
  }
  .chip[aria-pressed='true'] { background: var(--surface-2); border-color: var(--accent); color: var(--text); font-weight: 600; }
  .table-wrap { overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); }
  .table-wrap[hidden] { display: none; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; font-variant-numeric: tabular-nums; }
  th, td { padding: 8px 12px; text-align: right; white-space: nowrap; border-bottom: 1px solid var(--line); }
  thead th { background: var(--surface-3); color: var(--muted); font-weight: 600; }
  thead th:first-child { text-align: left; }
  tbody th { text-align: left; color: var(--soft); font-weight: 500; position: sticky; left: 0; background: var(--bg); }
  tbody tr:last-child > * { border-bottom: 0; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 720px) {
    .hero { grid-template-columns: 1fr; gap: 16px; }
    .hero-art { height: 260px; }
    h1 { font-size: 28px; }
    .stat-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .stat-value { font-size: 17px; }
    .skill-list a { grid-template-columns: 1fr; }
    .skill-preview { grid-column: 1; }
    .tabs { margin: 0 -16px 8px; padding: 0 16px; }
  }
</style>
