---
import Base from '../../layouts/Base.astro';
import SeeAlso from '../../components/SeeAlso.astro';
import { titanArt } from '../../lib/art';
import { href, titanHref, titans } from '../../lib/data';
import { initials, rarityColor } from '../../lib/format';
import { bonusLabel, maxBonus, titansByFaction } from '../../lib/titans';

const groups = titansByFaction();
---
<Base title="Titans">
  <div class="head">
    <h1>Titans</h1>
    <span class="count">{titans.length} total</span>
  </div>
  <p class="lead">An Invoker can bind Titans from their own faction. Bonuses shown are at full Empowerment.</p>
  <p class="links">
    <a href={href('tiers/titans/campaign')}>Titan tier lists</a>
    <span aria-hidden="true">·</span>
    <a href={href('heroes')}>All Invokers</a>
  </p>

  {groups.map((g) => (
    <section class="group">
      <h2>
        {g.faction ? <a href={href(`heroes?faction=${encodeURIComponent(g.faction)}`)}>{g.faction}</a> : 'Any faction'}
        <span class="sub">{g.titans.length}</span>
      </h2>
      <ul class="grid">
        {g.titans.map((t) => {
          const bonus = maxBonus(t.id);
          const art = titanArt(t.id);
          return (
            <li>
              <a class="card" href={titanHref(t.slug)}>
                <span class="card-art">{art ? <img src={art} alt="" loading="lazy" /> : <span class="ph">{initials(t.name)}</span>}</span>
                <span class="card-name">{t.name}</span>
                {t.rarity && <span class="card-rarity" style={`color: ${rarityColor[t.rarity] ?? 'inherit'}`}>{t.rarity}{t.role && ` · ${t.role}`}</span>}
                {bonus && <span class="card-meta">{bonusLabel(bonus)}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}

  <SeeAlso links={[
    { path: 'tiers/titans/campaign', label: 'Titan tier lists' },
    { path: 'team', label: 'Team builder' },
    { path: 'bosses', label: 'Boss guides' },
    { path: 'heroes', label: 'Invokers' },
  ]} />
</Base>

<style>
  .head { display: flex; align-items: center; gap: 12px; }
  h1 { margin: 0; font-size: 32px; }
  .count { color: var(--muted); font-size: 14px; }
  .lead { color: var(--soft); margin: 12px 0 4px; }
  .links { display: flex; gap: 8px; color: var(--muted); font-size: 14px; margin: 0 0 8px; }
  .group h2 { display: flex; align-items: baseline; gap: 8px; font-size: 18px; margin: 28px 0 12px; }
  .group h2 a { color: var(--text); }
  .sub { color: var(--muted); font-size: 14px; font-weight: 400; }
  .card-rarity { padding: 0 12px; font-size: 12px; font-weight: 600; }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
  }
  .card:hover { border-color: var(--accent); }
  .card-art { aspect-ratio: 1; background: var(--surface-2); display: flex; align-items: center; justify-content: center; }
  .card-art img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
  .ph { font-family: var(--display); font-weight: 800; font-size: 32px; color: var(--muted); }
  .card-name { font-weight: 600; padding: 10px 12px 2px; }
  .card-meta { font-size: 13px; color: var(--soft); padding: 0 12px 12px; }
  @media (max-width: 720px) {
    h1 { font-size: 26px; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
