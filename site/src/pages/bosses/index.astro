---
import Base from '../../layouts/Base.astro';
import SeeAlso from '../../components/SeeAlso.astro';
import { bosses, bossLabel, bossSlug, href } from '../../lib/data';
import { elementColor } from '../../lib/format';
import { elementIcon } from '../../lib/art';
import { tierLists, tierRows } from '../../lib/tierData';

// The first three S-tier Invokers for each boss, as small portraits on its card.
const topArt = (b: (typeof bosses)[number]) => {
  const list = tierLists.find((l) => l.id === bossSlug(b));
  return list ? (tierRows('invokers', list)[0]?.picks ?? []).filter((p) => p.art).slice(0, 3) : [];
};

// Group by game mode, in the order players meet them.
const groups = [
  { mode: 'relic boss', title: 'Relic bosses' },
  { mode: 'clan boss', title: 'Clan boss' },
  { mode: 'other', title: 'Crest bosses' },
  { mode: 'Pentiax', title: 'Pentiax' },
  { mode: 'Omnissi', title: 'Omnissi' },
]
  .map((g) => ({ ...g, bosses: bosses.filter((b) => b.mode === g.mode) }))
  .filter((g) => g.bosses.length > 0);
const known = new Set(groups.map((g) => g.mode));
const rest = bosses.filter((b) => !known.has(b.mode));
if (rest.length) groups.push({ mode: 'rest', title: 'Other bosses', bosses: rest });
---
<Base title="Boss guides">
  <h1>Boss guides</h1>
  <p class="lead">Each boss's own dos and don'ts from the game, the corruptions it uses, and the energy cost of each stage.</p>

  {groups.map((g) => (
    <section aria-labelledby={`g-${g.mode.toLowerCase().replace(/\s+/g, '-')}`}>
      <h2 id={`g-${g.mode.toLowerCase().replace(/\s+/g, '-')}`}>{g.title}</h2>
      <ul class="grid">
        {g.bosses.map((b) => (
          <li>
            <a class="card" href={href(`bosses/${bossSlug(b)}`)} style={b.element ? `--tint: ${elementColor[b.element] ?? '#5FDCF7'}` : undefined}>
              <span class="name">{b.element && elementIcon(b.element) && <img src={elementIcon(b.element)} alt="" width="22" height="22" />}{bossLabel(b)}</span>
              {b.title && <span class="title">{b.title}</span>}
              <span class="corr">{b.corruptions.join(' · ')}</span>
              {topArt(b).length > 0 && (
                <span class="top" aria-hidden="true">{topArt(b).map((p) => <img src={p.art} alt="" width="32" height="32" loading="lazy" />)}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <SeeAlso links={[
    { path: 'tiers', label: 'Tier lists' },
    { path: 'gear#tolerance', label: 'Tolerance gear sets' },
    { path: 'blog/boss-corruptions-and-tolerance-sets', label: 'Which Tolerance set to build first' },
    { path: 'events', label: 'Events' },
  ]} />
</Base>

<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  h2 { font-size: 18px; font-weight: 600; margin: 28px 0 12px; }
  .lead { color: var(--soft); max-width: 70ch; margin: 0; }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .card {
    --tint: var(--accent);
    display: flex;
    flex-direction: column;
    gap: 2px;
    height: 100%;
    padding: 16px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
  }
  .card:hover { color: var(--text); border-color: var(--tint); }
  .top { display: flex; gap: 4px; margin-top: 10px; }
  .top img { width: 32px; height: 32px; border-radius: 8px; object-fit: cover; object-position: top center; }
  .name { font-family: var(--display); font-weight: 600; font-size: 17px; display: flex; align-items: center; gap: 8px; }
  .title { color: var(--soft); font-size: 14px; }
  .corr { margin-top: 8px; font-size: 13px; color: var(--tint); font-weight: 600; }

  @media (max-width: 720px) {
    h1 { font-size: 22px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
