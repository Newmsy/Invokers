---
import Base from '../../layouts/Base.astro';
import SeeAlso from '../../components/SeeAlso.astro';
import { bossLabel, bosses, bossSlug, corruptionNames, href, toleranceFor, type Boss } from '../../lib/data';
import { richText } from '../../lib/format';
import { tierLists } from '../../lib/tiers/lists';

export function getStaticPaths() {
  return bosses.map((boss) => ({ params: { slug: bossSlug(boss) }, props: { boss } }));
}

const { boss } = Astro.props as { boss: Boss };
const hasTiers = tierLists.some((l) => l.id === bossSlug(boss));

// Gear sets for this boss's corruptions, then the pages that plan a run at it.
const setAnchor = (c: string) => `gear#set-${c.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-tolerance`;
const seeAlso = [
  ...boss.corruptions.map((c) => ({ path: setAnchor(c), label: `${c} Tolerance set` })),
  { path: 'blog/boss-corruptions-and-tolerance-sets', label: 'Which Tolerance set to build first' },
  { path: 'events', label: 'Events energy planner' },
];

// Stages that share an energy cost collapse into one row: "1–6 · 8 energy".
const stageRanges: { from: number; to: number; energy: number }[] = [];
for (const s of [...boss.stages].sort((a, b) => a.stage - b.stage)) {
  const last = stageRanges[stageRanges.length - 1];
  if (last && last.energy === s.energy && last.to === s.stage - 1) last.to = s.stage;
  else stageRanges.push({ from: s.stage, to: s.stage, energy: s.energy });
}

// The tolerance help texts end with "Useful against: …"; on a boss page only the effect matters.
// A boss's own Do list sometimes names a tolerance its corruption list leaves out (Koltmos: Bloodrot),
// so the page lists both.
const advice = boss.dos.join(' ');
const named = corruptionNames.filter((c) => !boss.corruptions.some((b) => b.replace(/\s+/g, '').toLowerCase() === c.toLowerCase()) && new RegExp(`\\b${c}\\b`, 'i').test(advice));
const tolerances = [...boss.corruptions, ...named].map((c) => {
  const stat = toleranceFor(c);
  const text = stat?.description
    ?.split('Useful against')[0]
    .replace(/\s*by\s*(<color=[^>]*>)?\{0\}(<\/color>)?/g, '')
    .replace(/[.\s]+$/, '');
  return { corruption: c, name: stat?.name ?? `${c} Tolerance`, text };
});

// Long briefings (some run to hundreds of words) show their first paragraph up top; the rest folds away
// below the Do and Don't lists.
const paragraphs = (boss.description ?? '').split(/(?:<br\s*\/?>\s*){2,}/).filter((p) => p.trim());
const longBriefing = (boss.description ?? '').split(/\s+/).length > 80 && paragraphs.length > 1;
const intro = longBriefing ? paragraphs[0] : boss.description;
const rest = longBriefing ? paragraphs.slice(1) : [];

---
<Base title={bossLabel(boss)}>
  <a class="back" href={href('bosses')}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
    All bosses
  </a>

  <header class="head">
    {boss.title && <span class="title">{boss.title}</span>}
    <h1>{bossLabel(boss)}</h1>
    {intro && <p class="desc" set:html={richText(intro)} />}
    {hasTiers && (
      <p class="tiers">
        Best picks: <a href={href(`tiers/invokers/${bossSlug(boss)}`)}>Invokers</a> · <a href={href(`tiers/titans/${bossSlug(boss)}`)}>Titans</a>
      </p>
    )}
  </header>

  <div class="advice">
    <section class="do" aria-labelledby="do-title">
      <h2 id="do-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg>
        Do
      </h2>
      <ul>{boss.dos.map((d) => <li set:html={richText(d)} />)}</ul>
    </section>
    <section class="dont" aria-labelledby="dont-title">
      <h2 id="dont-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        Don't
      </h2>
      <ul>{boss.donts.map((d) => <li set:html={richText(d)} />)}</ul>
    </section>
  </div>

  {rest.length > 0 && (
    <details class="briefing">
      <summary>Full boss briefing</summary>
      {rest.map((p) => <p set:html={richText(p)} />)}
    </details>
  )}

  {tolerances.length > 0 && (
    <section aria-labelledby="corr-title">
      <h2 id="corr-title">Corruptions</h2>
      <p class="hint">Bring Invokers or relics with these tolerances.</p>
      <ul class="corr">
        {tolerances.map((t) => (
          <li>
            <span class="corr-name">{t.name}</span>
            {t.text && <span class="corr-text" set:html={richText(t.text)} />}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="stage-title">
    <h2 id="stage-title">Energy per stage</h2>
    <ul class="stages">
      {stageRanges.map((r) => (
        <li>
          <span class="stage">{r.from === r.to ? `Stage ${r.from}` : `Stages ${r.from}–${r.to}`}</span>
          <span class="energy">{r.energy} energy</span>
        </li>
      ))}
    </ul>
  </section>

  <SeeAlso links={seeAlso} />
</Base>

<style>
  .tiers { margin: 10px 0 0; color: var(--soft); font-weight: 500; }
  .back { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--soft); }
  .head { margin-bottom: 24px; }
  .title { color: var(--accent); font-weight: 600; font-size: 14px; }
  h1 { margin: 4px 0 12px; font-size: 40px; font-weight: 700; }
  .desc { color: var(--soft); max-width: 70ch; margin: 0; line-height: 1.6; }
  h2 { font-size: 18px; font-weight: 600; margin: 28px 0 10px; display: flex; align-items: center; gap: 8px; }
  .hint { color: var(--muted); font-size: 14px; margin: -4px 0 12px; }

  .advice { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .advice section {
    padding: 4px 20px 16px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .advice h2 { margin-top: 16px; }
  .do h2 { color: #7be0a0; }
  .dont h2 { color: #ff9a8a; }
  .advice ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
  .advice li { line-height: 1.5; }

  .briefing {
    margin-top: 16px;
    padding: 4px 20px 12px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .briefing summary { cursor: pointer; color: var(--soft); min-height: 44px; display: flex; align-items: center; }
  .briefing p { margin: 8px 0 0; color: var(--soft); max-width: 70ch; line-height: 1.6; }

  .corr { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .corr li {
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .corr-name { font-weight: 600; }
  .corr-text { font-size: 14px; color: var(--soft); }

  .stages { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .stages li {
    display: flex;
    flex-direction: column;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--surface);
    min-width: 120px;
  }
  .stage { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .energy { font-family: var(--display); font-weight: 600; font-size: 17px; }

  @media (max-width: 720px) {
    h1 { font-size: 28px; }
    .advice { grid-template-columns: 1fr; }
    .stages li { flex: 1 1 140px; }
  }
</style>
