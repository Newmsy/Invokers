---
import Base from '../../layouts/Base.astro';
import SeeAlso from '../../components/SeeAlso.astro';
import { href } from '../../lib/data';
import { pools, tierLists, tierRows, tiersDraft, type PoolKind } from '../../lib/tierData';

// The first two S-tier picks of a list, as small portraits on its link.
const topArt = (kind: PoolKind, list: (typeof tierLists)[number]) =>
  (tierRows(kind, list)[0]?.picks ?? []).filter((p) => p.art).slice(0, 2);
const groups = [...new Set(tierLists.map((l) => l.group))].map((g) => ({ group: g, lists: tierLists.filter((l) => l.group === g) }));
---
<Base title="Tier lists">
  <h1>Tier lists</h1>
  <p class="lead">The best Invokers and Titans for each mode and boss, S to D.</p>
  {tiersDraft && <p class="draft">Draft: these tiers are still being reviewed.</p>}

  {pools.map((p) => (
    <section aria-labelledby={`pool-${p.kind}`}>
      <h2 id={`pool-${p.kind}`}>{p.label}</h2>
      {groups.map((g) => (
        <div class="group">
          <h3>{g.group}</h3>
          <ul class="links">
            {g.lists.map((l) => (
              <li>
                <a href={href(`tiers/${p.kind}/${l.id}`)}>
                  <span class="faces" aria-hidden="true">{topArt(p.kind, l).map((t) => <img src={t.art} alt="" width="28" height="28" loading="lazy" />)}</span>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
  <SeeAlso links={[
    { path: 'bosses', label: 'Boss guides' },
    { path: 'team', label: 'Team builder' },
    { path: 'heroes/compare', label: 'Compare Invokers' },
  ]} />
</Base>

<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  h2 { font-size: 20px; font-weight: 700; margin: 28px 0 4px; }
  h3 { font-size: 13px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin: 14px 0 8px; }
  .lead { color: var(--soft); max-width: 70ch; margin: 0; }
  .draft {
    display: inline-block;
    margin: 12px 0 0;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px dashed var(--line);
    color: var(--soft);
    font-size: 14px;
  }
  .links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    font-weight: 600;
    font-size: 14px;
  }
  .links a:has(.faces img) { padding-left: 6px; gap: 8px; }
  .faces { display: inline-flex; }
  .faces img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; object-position: top center; border: 2px solid var(--surface); }
  .faces img + img { margin-left: -8px; }
  .faces:empty { display: none; }
  .links a:hover { border-color: var(--accent); color: var(--text); }
  @media (max-width: 720px) { h1 { font-size: 22px; } }
</style>
