---
import Base from '../../layouts/Base.astro';
import SeeAlso from '../../components/SeeAlso.astro';
import { bossArt, elementIcon, modeArt } from '../../lib/art';
import { bosses, bossSlug, href } from '../../lib/data';
import { pools, tierLists, tiersDraft } from '../../lib/tierData';

// One picture per list: the boss's portrait (Omnissi with its element badge), or the mode's card.
const bossByList = new Map(bosses.map((b) => [bossSlug(b), b]));
const modeCard: Record<string, string> = { campaign: 'Campaign', spires: 'spires', arena: 'Arena' };
const iconFor = (id: string) => {
  const boss = bossByList.get(id);
  if (boss) return { art: bossArt(boss.id), badge: boss.element ? elementIcon(boss.element === 'Astral' ? 'Neutral' : boss.element) : undefined, mode: false };
  return { art: modeCard[id] ? modeArt(modeCard[id]) : undefined, badge: undefined, mode: true };
};
const groups = [...new Set(tierLists.map((l) => l.group))].map((g) => ({ group: g, lists: tierLists.filter((l) => l.group === g) }));
---
<Base title="Tier lists">
  <h1>Tier lists</h1>
  <p class="lead">The best Invokers and Titans for each mode and boss, S to D.</p>
  {tiersDraft && <p class="draft">Draft: these tiers are still being reviewed.</p>}

  {pools.map((p) => (
    <section aria-labelledby={`pool-${p.kind}`}>
      <h2 id={`pool-${p.kind}`}>{p.label}</h2>
      {groups.map((g) => (
        <div class="group">
          <h3>{g.group}</h3>
          <ul class="links">
            {g.lists.map((l) => (
              <li>
                {(() => {
                  const icon = iconFor(l.id);
                  return (
                    <a href={href(`tiers/${p.kind}/${l.id}`)}>
                      {icon.art && (
                        <span class:list={['icon', { mode: icon.mode }]} aria-hidden="true">
                          <img src={icon.art} alt="" width="36" height="36" loading="lazy" />
                          {icon.badge && <img class="badge" src={icon.badge} alt="" width="16" height="16" loading="lazy" />}
                        </span>
                      )}
                      {l.label}
                    </a>
                  );
                })()}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
  <SeeAlso links={[
    { path: 'bosses', label: 'Boss guides' },
    { path: 'team', label: 'Team builder' },
    { path: 'heroes/compare', label: 'Compare Invokers' },
  ]} />
</Base>

<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  h2 { font-size: 20px; font-weight: 700; margin: 28px 0 4px; }
  h3 { font-size: 13px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin: 14px 0 8px; }
  .lead { color: var(--soft); max-width: 70ch; margin: 0; }
  .draft {
    display: inline-block;
    margin: 12px 0 0;
    padding: 6px 12px;
    border-radius: var(--radius);
    border: 1px dashed var(--line);
    color: var(--soft);
    font-size: 14px;
  }
  .links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    font-weight: 600;
    font-size: 14px;
  }
  .links a:has(.icon) { padding-left: 4px; gap: 10px; min-height: 46px; }
  .icon { position: relative; display: inline-flex; flex: none; }
  .icon > img:first-child { width: 36px; height: 36px; object-fit: cover; border: 1px solid var(--line); background: var(--bg); }
  /* Mode cards are tall: show the figure near the top. */
  .icon.mode > img:first-child { object-position: center 22%; }
  .icon .badge { position: absolute; right: -5px; bottom: -5px; width: 16px; height: 16px; border-radius: 50%; box-shadow: 0 0 0 2px var(--surface); }
  .links a:hover { border-color: var(--accent); color: var(--text); }
  @media (max-width: 720px) { h1 { font-size: 22px; } }
</style>
