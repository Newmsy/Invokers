---
import Base from '../../layouts/Base.astro';
import SeeAlso from '../../components/SeeAlso.astro';
import { bossArt, elementIcon, modeArt } from '../../lib/art';
import { bosses, bossSlug, href } from '../../lib/data';
import { elementColor } from '../../lib/format';
import { listCorruptions, pools, tierLists, tiersDraft } from '../../lib/tierData';

// One tile per list: the boss's portrait on the right in its element colour (Omnissi with its element badge),
// or the mode's card filling the tile, faded to dark under the name.
const bossByList = new Map(bosses.map((b) => [bossSlug(b), b]));
const modeCard: Record<string, string> = { campaign: 'Campaign', spires: 'spires', arena: 'Arena' };
const tileFor = (id: string) => {
  const boss = bossByList.get(id);
  if (boss) {
    const el = boss.element === 'Astral' ? 'Neutral' : boss.element;
    return {
      art: bossArt(boss.id),
      badge: el ? elementIcon(el) : undefined,
      mode: false,
      tint: boss.element ? `--tint: ${elementColor[boss.element] ?? '#EBB84C'}` : undefined,
      sub: (listCorruptions.get(id) ?? []).join(' · '),
    };
  }
  return { art: modeCard[id] ? modeArt(modeCard[id]) : undefined, badge: undefined, mode: true, tint: undefined, sub: '' };
};
const groups = [...new Set(tierLists.map((l) => l.group))].map((g) => ({ group: g, lists: tierLists.filter((l) => l.group === g) }));
---
<Base title="Tier lists">
  <h1>Tier lists</h1>
  <p class="lead">The best Invokers and Titans for each mode and boss, S to D.</p>
  {tiersDraft && <p class="draft">Draft: these tiers are still being reviewed.</p>}

  {pools.map((p) => (
    <section aria-labelledby={`pool-${p.kind}`}>
      <h2 id={`pool-${p.kind}`}>{p.label}</h2>
      {groups.map((g) => (
        <div class="group">
          <h3>{g.group}</h3>
          <ul class="tiles">
            {g.lists.map((l) => {
              const t = tileFor(l.id);
              return (
                <li>
                  <a class:list={['tile', { mode: t.mode, portrait: !t.mode && t.art }]} href={href(`tiers/${p.kind}/${l.id}`)} style={t.tint}>
                    {t.art && <img class="art" src={t.art} alt="" width="256" height="256" loading="lazy" />}
                    <span class="name">
                      {t.badge && <img src={t.badge} alt="" width="22" height="22" loading="lazy" />}
                      {g.group === 'Omnissi' ? l.label.replace(/^Omnissi \((.+)\)$/, '$1') : l.label}
                    </span>
                    {t.sub && <span class="sub">{t.sub}</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </section>
  ))}
  <SeeAlso links={[
    { path: 'bosses', label: 'Boss guides' },
    { path: 'team', label: 'Team builder' },
    { path: 'heroes/compare', label: 'Compare Invokers' },
  ]} />
</Base>

<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  h2 { font-size: 20px; font-weight: 700; margin: 28px 0 4px; }
  h3 { font-size: 13px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin: 14px 0 8px; }
  .lead { color: var(--soft); max-width: 70ch; margin: 0; }
  .draft {
    display: inline-block;
    margin: 12px 0 0;
    padding: 6px 12px;
    border-radius: var(--radius);
    border: 1px dashed var(--line);
    color: var(--soft);
    font-size: 14px;
  }
  .tiles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 10px;
  }
  .tile {
    --tint: var(--accent);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2px;
    height: 100%;
    min-height: 120px;
    padding: 12px 14px;
    border-radius: var(--radius);
    background: var(--surface-2, var(--bg));
    border: 1px solid var(--line);
    color: var(--text);
  }
  .tile:hover { color: var(--text); border-color: var(--tint); }
  .art { position: absolute; z-index: -1; pointer-events: none; }
  /* A boss portrait sits on the right in its element colour, fading into the tile. */
  .portrait { background: radial-gradient(circle at 85% 40%, color-mix(in srgb, var(--tint) 28%, transparent), transparent 60%), var(--surface-2, var(--bg)); }
  .portrait .art { top: 0; right: 0; height: 100%; width: 50%; object-fit: cover; object-position: top center; }
  .portrait::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to right, rgb(17 14 10 / 0.97) 45%, rgb(17 14 10 / 0.5) 75%, transparent 100%); }
  /* A mode card fills the tile and fades to dark under the name. */
  .mode .art { inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 22%; }
  .mode::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgb(17 14 10 / 0.97) 0%, rgb(17 14 10 / 0.75) 45%, rgb(17 14 10 / 0.45) 100%); }
  .portrait .name, .portrait .sub { max-width: 58%; }
  .name { font-family: var(--display); font-weight: 600; font-size: 18px; display: flex; align-items: center; gap: 8px; text-shadow: 0 1px 4px rgb(0 0 0 / 0.8); }
  .sub { font-size: 13px; color: var(--tint); font-weight: 600; text-shadow: 0 1px 4px rgb(0 0 0 / 0.8); }
  @media (max-width: 720px) {
    h1 { font-size: 22px; }
    .tiles { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .tile { min-height: 96px; padding: 10px; }
    .name { font-size: 15px; }
  }
</style>
