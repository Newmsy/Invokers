---
import Base from '../../../layouts/Base.astro';
import SeeAlso from '../../../components/SeeAlso.astro';
import { elementIcon } from '../../../lib/art';
import { bosses, bossSlug, href } from '../../../lib/data';
import { elementColor, initials, tierColor } from '../../../lib/format';
import { listCorruptions, pools, tierLists, tierRows, tiersDraft, type PoolKind } from '../../../lib/tierData';
import type { TierListDef } from '../../../lib/tiers/lists';

export function getStaticPaths() {
  return pools.flatMap((p) => tierLists.map((list) => ({ params: { kind: p.kind, list: list.id }, props: { kind: p.kind, list } })));
}

const { kind, list } = Astro.props as { kind: PoolKind; list: TierListDef };
const pool = pools.find((p) => p.kind === kind)!;
const rows = tierRows(kind, list);
const boss = bosses.find((b) => bossSlug(b) === list.id);
const groups = [...new Set(tierLists.map((l) => l.group))];

// Invokers filter by element (Spires want one element per team); Titans by the faction that can bind them.
const picks = rows.flatMap((r) => r.picks);
const filterKey = kind === 'invokers' ? 'element' : 'faction';
// Top picks straight into the team builder and compare page; plus pages that go with this mode or boss.
const topSlugs = picks.map((p) => p.slug);
const seeAlso = [
  ...(kind === 'invokers' && topSlugs.length > 1
    ? [
        { path: `team?h=${topSlugs.slice(0, 5).join(',')}&name=${encodeURIComponent(list.label)}`, label: 'Try the top 5 in the Team builder' },
        { path: `heroes/compare?h=${topSlugs.slice(0, 4).join(',')}`, label: 'Compare the top 4' },
      ]
    : []),
  ...(list.id === 'spires' ? [{ path: 'spires', label: 'Spire floors guide' }] : []),
  ...(list.id === 'arena' ? [{ path: 'blog/arena-guide', label: 'Arena guide' }, { path: 'trophies', label: 'Trophy Room' }, { path: 'events#arena-title', label: 'Arena Rush calculator' }] : []),
];
const filterValues = [...new Set(picks.map((p) => (kind === 'invokers' ? p.element : p.meta) ?? ''))].filter(Boolean).sort();
---
<Base title={`${pool.label} tier list: ${list.label}`}>
  <a class="back" href={href('tiers')}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
    All tier lists
  </a>

  <header class="head">
    <h1>{pool.label}: {list.label}</h1>
    <p class="lead">{list.summary}{boss && <> <a href={href(`bosses/${list.id}`)}>Boss guide</a></>}</p>
    {kind === 'invokers' && listCorruptions.get(list.id) && (
      <p class="lead">Invokers with {listCorruptions.get(list.id)!.join(' or ')} Tolerance rank higher here.</p>
    )}
    {tiersDraft && <p class="draft">Draft: these tiers are still being reviewed.</p>}
  </header>

  <div class="controls">
    <div class="pool" role="group" aria-label="Invokers or Titans">
      {pools.map((p) => <a href={href(`tiers/${p.kind}/${list.id}`)} aria-current={p.kind === kind ? 'page' : undefined}>{p.label}</a>)}
    </div>
    <label class="switch">
      <select id="list" aria-label="Tier list">
        {groups.map((g) => (
          <optgroup label={g}>
            {tierLists.filter((l) => l.group === g).map((l) => <option value={href(`tiers/${kind}/${l.id}`)} selected={l.id === list.id}>{l.label}</option>)}
          </optgroup>
        ))}
      </select>
    </label>
  </div>

  <div class="chips" role="group" aria-label={`Filter by ${filterKey}`}>
    <button type="button" class="chip" data-value="" aria-pressed="true">All</button>
    {filterValues.map((v) => (
      <button type="button" class="chip" data-value={v} aria-pressed="false">
        {kind === 'invokers' && elementIcon(v) && <img src={elementIcon(v)} alt="" width="16" height="16" loading="lazy" />}
        {v}
      </button>
    ))}
  </div>

  <div class="rows">
    {rows.map((r) => (
      <section class="row" style={`--tier: ${tierColor[r.tier] ?? '#EBB84C'}`} aria-label={`Tier ${r.tier}`}>
        <span class="tier" aria-hidden="true">{r.tier}</span>
        <ul class="picks">
          {r.picks.map((p) => {
            const Tag = p.href ? 'a' : 'div';
            return (
              <li data-filter={kind === 'invokers' ? p.element : p.meta}>
                <Tag class="pick" href={p.href} style={p.element ? `--tint: ${elementColor[p.element] ?? '#EBB84C'}` : undefined}>
                  <span class="art">
                    {p.art ? <img src={p.art} alt="" width="52" height="52" loading="lazy" /> : <span>{initials(p.name)}</span>}
                  </span>
                  <span class="body">
                    <span class="name">{p.name}</span>
                    <span class="meta">
                      {p.element && elementIcon(p.element) && <img src={elementIcon(p.element)} alt="" width="13" height="13" loading="lazy" />}
                      {p.element && `${p.element} · `}{p.meta}
                    </span>
                    {p.brings.length > 0 && <span class="brings">{p.brings.map((b) => <span>{b}</span>)}</span>}
                  </span>
                </Tag>
              </li>
            );
          })}
        </ul>
        <p class="none" hidden={r.picks.length > 0}>None</p>
      </section>
    ))}
  </div>

  <SeeAlso links={seeAlso} />
</Base>

<script>
  const select = document.querySelector<HTMLSelectElement>('#list')!;
  select.addEventListener('change', () => (location.href = select.value + location.search));

  // Filter in the URL (?f=Fire) so a filtered list can be shared and survives switching lists.
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chips .chip')];
  const rows = [...document.querySelectorAll<HTMLElement>('.row')];
  function apply(value: string) {
    for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.value === value));
    for (const row of rows) {
      let shown = 0;
      for (const li of row.querySelectorAll<HTMLLIElement>('.picks > li')) {
        li.hidden = !!value && li.dataset.filter !== value;
        if (!li.hidden) shown++;
      }
      row.querySelector<HTMLElement>('.none')!.hidden = shown > 0;
    }
    const url = new URL(location.href);
    if (value) url.searchParams.set('f', value);
    else url.searchParams.delete('f');
    history.replaceState(null, '', url);
  }
  for (const c of chips) c.addEventListener('click', () => apply(c.getAttribute('aria-pressed') === 'true' ? '' : c.dataset.value!));
  const start = new URLSearchParams(location.search).get('f') ?? '';
  if (chips.some((c) => c.dataset.value === start)) apply(start);
</script>

<style>
  .back { display: inline-flex; align-items: center; gap: 4px; margin-top: 12px; color: var(--soft); font-weight: 500; }
  h1 { margin: 12px 0 6px; font-size: 28px; font-weight: 700; }
  .lead { color: var(--soft); max-width: 70ch; margin: 0; }
  .draft {
    display: inline-block;
    margin: 10px 0 0;
    padding: 6px 12px;
    border-radius: var(--radius);
    border: 1px dashed var(--line);
    color: var(--soft);
    font-size: 14px;
  }
  .controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 18px 0 10px; }
  .pool { display: inline-flex; padding: 3px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .pool a { padding: 7px 14px; border-radius: var(--radius); color: var(--soft); font-weight: 600; font-size: 14px; }
  .pool a[aria-current='page'] { background: var(--accent); color: var(--bg); }
  .switch select {
    min-height: 40px;
    padding: 0 12px;
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line);
    font: inherit;
    font-weight: 600;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 12px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--soft);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
  .chip[aria-pressed='true'] { border-color: var(--accent); color: var(--text); background: var(--surface-2); }
  .rows { display: flex; flex-direction: column; gap: 10px; }
  .row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 12px;
    padding: 12px;
    border-radius: var(--radius);
    background: var(--surface-3);
    border: 1px solid var(--line);
  }
  .tier {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    background: var(--tier);
    color: var(--bg);
    font-family: var(--display);
    font-weight: 800;
    font-size: 24px;
    min-height: 56px;
  }
  .picks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 8px;
  }
  .pick {
    --tint: var(--accent);
    display: flex;
    gap: 10px;
    align-items: center;
    height: 100%;
    padding: 8px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
  }
  a.pick:hover { border-color: var(--tint); color: var(--text); }
  .art {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--tint) 18%, var(--surface-2));
    font-family: var(--display);
    font-weight: 800;
    color: var(--soft);
  }
  .art img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .name { font-weight: 600; font-size: 15px; line-height: 1.2; }
  .meta { display: inline-flex; align-items: center; gap: 4px; color: var(--muted); font-size: 12px; }
  .brings { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 3px; }
  .brings span {
    padding: 1px 7px;
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--soft);
    font-size: 11px;
    font-weight: 600;
  }
  .none { margin: 0; align-self: center; color: var(--muted); }
  @media (max-width: 720px) {
    h1 { font-size: 22px; }
    .row { grid-template-columns: 1fr; }
    .tier { min-height: 36px; justify-content: flex-start; padding-left: 12px; font-size: 18px; }
    .picks { grid-template-columns: 1fr; }
  }
</style>
