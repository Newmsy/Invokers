---
import Base from '../layouts/Base.astro';
import SeeAlso from '../components/SeeAlso.astro';
import curvesJson from '../../../data/stat_curves.json';
import damageJson from '../../../data/damage.json';

interface Curve { id: string; stat: string; meaning: string; values: number[] }
const curves = (curvesJson as unknown as { curves: Curve[] }).curves;
const byId = (id: string) => curves.find((c) => c.id === id);

// Small steps where the curves change fastest, wider ones once they flatten.
const ratings = [0, 25, 50, 75, 100, 150, 200, 250, 300, 400, 500, 750, 1000, 1500, 2000, 3000];
const n = (v: number, dp = 1) => v.toLocaleString('en-GB', { minimumFractionDigits: dp, maximumFractionDigits: dp });

// Plain words for each curve, and how to show its value.
const rows = [
  { id: 'SkillSpeedFactorPct', name: 'Skill Speed', short: 'Skill spd', what: 'Skills play out faster', fmt: (v: number) => (v ? `+${n(v)}%` : "0") },
  // Combo Speed uses the same curve as Skill Speed: listed with the breakpoints, not repeated in the rating grid.
  { id: 'SkillSpeedFactorPct', name: 'Combo Speed', short: 'Combo spd', what: 'Combos play out faster', fmt: (v: number) => (v ? `+${n(v)}%` : "0"), sameAs: 'Skill Speed' },
  { id: 'SkillRecoveryPct', name: 'Skill Recovery', short: 'Skill rec', what: 'Skill cooldowns recover faster', fmt: (v: number) => (v ? `+${n(v)}%` : "0") },
  { id: 'ManaRegenRecoveryPct', name: 'Mana Generation', short: 'Mana gen', what: 'More mana for the Ultimate', fmt: (v: number) => (v ? `+${n(v)}%` : "0") },
  { id: 'InstinctFactorPct01', name: 'Instinct', short: 'Instinct', what: 'Chance to dodge danger zones while the AI controls the Invoker', fmt: (v: number) => `${n(v * 100, 0)}%` },
  { id: 'RunSpeed', name: 'Move Speed', short: 'Move', what: 'Run speed bonus', fmt: (v: number) => (v ? `+${n(v, 2)}` : "0") },
  { id: 'DefenseFactor', name: 'Defense', short: 'Defense', what: 'Share of damage still taken (100% = full damage)', fmt: (v: number) => `${n(v * 100)}%` },
]
  .map((r) => ({ ...r, curve: byId(r.id) }))
  .filter((r) => r.curve);

// The rating grid skips stats that share another stat's curve.
const gridRows = rows.filter((r) => !('sameAs' in r));
// Two tables of three stats each, so every column fits on a phone without stacking.
const gridParts = [gridRows.slice(0, 3), gridRows.slice(3)].filter((p) => p.length);
const fmtRating = (r: number) => r.toLocaleString('en-GB');
// Breakpoints: the rating that gives half, three quarters and 90% of the effect a 3,000 rating gives.
const shares = [0.5, 0.75, 0.9];
const breakpoints = rows.map((r) => {
  const v = r.curve!.values;
  const span = v[3000] - v[0];
  return { ...r, at: shares.map((s) => v.findIndex((x) => (x - v[0]) / span >= s - 1e-9)), top: v[3000] };
});

const instinct = byId('InstinctFactorPct01');
const instinctFull = instinct?.values.findIndex((v) => v >= 1);
const defense = byId('DefenseFactor');

// Resist uses Resistance minus the attacker's Accuracy, stored with an offset so the middle row is "equal".
const resist = byId('ResistChance_ResMinusAcc');
const offset = resist ? (resist.values.length - 1) / 2 : 0;
const diffs = [-1000, -500, -300, -200, -150, -100, -75, -50, -25, 0, 25, 50, 75, 100, 150, 200, 300, 500, 1000];
// Element advantage moves the resist chance (points taken off it when the attacker has the edge).
const elementShift = (damageJson as { elements?: { debuffApplicationChance?: { advantage: number; disadvantage: number } } }).elements?.debuffApplicationChance;
const resistAt = (pct: number) => (resist ? resist.values.findIndex((x) => x >= pct) - offset : 0);
const pctSigned = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${n(Math.abs(v))}%`;
const signed = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toLocaleString('en-GB')}`;
---
<Base title="What stats do">
  <h1>What stats do</h1>
  <p class="lead">What each stat rating turns into in battle, from 0 to 3,000. The first few hundred points do the most.</p>

  <section aria-labelledby="breaks-title">
    <h2 id="breaks-title">Breakpoints</h2>
    <p>The rating where each stat gives half, three quarters and 90% of what 3,000 rating gives. Past the 90% mark, extra points add very little.</p>
    <div class="table-wrap">
      <table class="stack breaks">
        <thead>
          <tr>
            <th scope="col">Stat</th>
            <th scope="col" class="num">Half</th>
            <th scope="col" class="num">75%</th>
            <th scope="col" class="num">90%</th>
            <th scope="col" class="num">At 3,000</th>
          </tr>
        </thead>
        <tbody>
          {breakpoints.map((r) => (
            <tr>
              <th scope="row"><strong>{r.name}</strong><small>{r.what}</small></th>
              {r.at.map((x, i) => <td class="num" data-label={['Half', '75%', '90%'][i]}>{fmtRating(x)}</td>)}
              <td class="num" data-label="At 3,000">{r.fmt(r.top)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="notes">
      {instinctFull != null && instinctFull > 0 && <li><strong>Instinct</strong> is the chance an Invoker you aren't steering dodges a danger zone (and, in some fights, switches to the right target). It starts at {n((instinct?.values[0] ?? 0) * 100, 0)}% and reaches 100% at rating {instinctFull}; more does nothing. It never changes damage or crits.</li>}
      {defense && <li><strong>Defense</strong> never flattens: 3,000 rating cuts damage taken by {n((1 - defense.values[3000]) * 100)}%, and each point keeps helping.</li>}
    </ul>
  </section>

  <section aria-labelledby="curves-title">
    <h2 id="curves-title">Rating to effect</h2>
    <div class="grids">
    {gridParts.map((part) => (
      <div class="table-wrap">
        <table class="grid">
          <thead>
            <tr>
              <th scope="col">Rating</th>
              {part.map((r) => <th scope="col" class="num"><span class="long">{r.name}</span><span class="short" aria-hidden="true">{r.short}</span></th>)}
            </tr>
          </thead>
          <tbody>
            {ratings.map((x) => (
              <tr>
                <th scope="row" class="num">{fmtRating(x)}</th>
                {part.map((r) => <td class="num">{r.fmt(r.curve!.values[x])}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
    </div>
    <p class="hint">{gridRows.map((r) => `${r.name}: ${r.what[0].toLowerCase()}${r.what.slice(1)}`).join('. ')}. Combo Speed uses the Skill Speed column: same curve, for combos.</p>
  </section>

  {resist && (
    <section aria-labelledby="resist-title">
      <h2 id="resist-title">Resist against Accuracy</h2>
      <p>Resisting an effect uses <strong>your Resistance minus the attacker’s Accuracy</strong>, not either stat alone.</p>
      <ul class="notes">
        <li>Each point of gap is worth <strong>1%</strong> up to a gap of 50 either way; after that each point is worth less.</li>
        <li>A gap of <strong>+{resistAt(100)}</strong> already gives a resist chance of 100%.</li>
        {elementShift && (
          <li>
            Elements shift it: when the attacker has element advantage your resist chance is <strong>{elementShift.advantage} points lower</strong>;
            when you have the advantage it is <strong>{-elementShift.disadvantage} points higher</strong>.
          </li>
        )}
        <li>At 0% or below the effect always lands; at 100% or above it is always resisted. Effects that can't be resisted skip the roll.</li>
      </ul>
      <div class="table-wrap narrow">
        <table class="grid">
          <thead>
            <tr>
              <th scope="col">RES minus ACC</th>
              <th scope="col" class="num">Resist chance</th>
            </tr>
          </thead>
          <tbody>
            {diffs.map((d) => (
              <tr class={d === 0 ? 'even' : undefined}>
                <th scope="row" class="num">{signed(d)}</th>
                <td class="num">{pctSigned(resist.values[offset + d])}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="hint">The game’s resist chance in percent for each gap between RES and ACC. 0 means RES and ACC are equal; a negative gap gives a negative chance.</p>
    </section>
  )}

  <SeeAlso links={[
    { path: 'blog/stats-that-stop-working', label: 'Stats that stop working' },
    { path: 'gear', label: 'Gear sets' },
    { path: 'tactics', label: 'Tactics' },
    { path: 'trophies', label: 'Trophies' },
    { path: 'heroes/compare', label: 'Compare Invokers' },
  ]} />
</Base>

<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  h2 { font-size: 20px; font-weight: 600; margin: 32px 0 8px; }
  p { max-width: 70ch; }
  .lead { color: var(--soft); margin: 0; }
  .hint { color: var(--muted); font-size: 14px; }
  .notes { max-width: 70ch; padding-left: 20px; color: var(--soft); font-size: 15px; }
  .notes li { margin: 4px 0; }
  .table-wrap { overflow-x: auto; border-radius: var(--radius); border: 1px solid var(--line); }
  .grids { display: grid; gap: 12px; }
  @media (min-width: 900px) { .grids { grid-template-columns: 1fr 1fr; align-items: start; } }
  table { border-collapse: collapse; width: 100%; font-size: 14px; font-variant-numeric: tabular-nums; }
  th, td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--line); }
  thead th { background: var(--surface-3); color: var(--muted); font-weight: 600; white-space: nowrap; }
  th.num, td.num { text-align: right; white-space: nowrap; }
  tbody th { position: sticky; left: 0; background: var(--bg); font-weight: 500; min-width: 150px; }
  tbody th strong { display: block; color: var(--text); font-weight: 600; }
  tbody th small { display: block; color: var(--muted); font-size: 12px; font-weight: 400; }
  tbody tr:last-child > * { border-bottom: 0; }

  .narrow { max-width: 360px; }
  table.grid .short { display: none; }
  table.grid tbody th { min-width: 0; font-weight: 600; }
  tr.even > * { background: var(--surface-3); }
  table.grid thead th { white-space: normal; vertical-align: bottom; }

  @media (max-width: 720px) {
    table.grid { font-size: 11px; }
    table.grid th, table.grid td { padding: 5px 3px; }
    table.grid thead th { font-size: 10px; }
    table.grid .long { display: none; }
    table.grid .short { display: inline; }
    h1 { font-size: 22px; }
    th, td { padding: 6px 8px; }
    /* Phones: each stat becomes a card with its values in a grid, nothing scrolls sideways. */
    table.stack thead { display: none; }
    table.stack, table.stack tbody { display: block; }
    table.stack tr { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px 8px; padding: 10px 12px; border-bottom: 1px solid var(--line); }
    table.stack tbody tr:last-child { border-bottom: 0; }
    table.stack th, table.stack td { display: block; padding: 0; border: 0; text-align: left; position: static; min-width: 0; max-width: none; white-space: normal; background: none; }
    table.stack tbody th { grid-column: 1 / -1; }
    table.stack td::before { content: attr(data-label); display: block; color: var(--muted); font-size: 11px; }
  }
</style>
