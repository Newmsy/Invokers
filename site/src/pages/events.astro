---
import Base from '../layouts/Base.astro';
import SeeAlso from '../components/SeeAlso.astro';
import { bosses, href } from '../lib/data';
import guide from '../data/event-guide.json';
import { itemIcon } from '../lib/art';
import { arenaLeagues, stageScore } from '../lib/eventScoring';
import { shop } from '../lib/packs';

const fmt = (n: number) => n.toLocaleString('en-GB');
const energyIcon = itemIcon('Energy');
const gemIcon = itemIcon('Gem');
const arenaIcon = itemIcon('Arena_Token');

// Energy per stage for each farming event, from the boss list (every boss of a kind costs the same).
const farming = guide.events
  .filter((e) => e.bossMode || e.difficulties)
  .map((e) => {
    const boss = e.bossMode ? bosses.find((b) => b.mode === e.bossMode) : undefined;
    // Points per run come from each stage's drop rates and points per drop (estimated: they are averages).
    const stages = boss
      ? [...boss.stages].sort((a, b) => a.stage - b.stage).flatMap((s) => {
          const score = stageScore(e.bossMode, s.stage);
          // Only stages with a points estimate are offered, so nothing needs typing in.
          return score ? [{ label: `Stage ${s.stage}`, energy: s.energy, points: score.pointsPerRun, lines: score.lines }] : [];
        })
      : [];
    const options = e.difficulties
      ? e.difficulties.map((d) => ({ label: d.name, energy: d.energy, points: d.points, lines: [] as (typeof stages)[number]['lines'] }))
      : stages;
    const perChase = 'perChase' in e ? (e.perChase as number) : 1;
    return { id: e.id, name: e.name, target: e.target, perChase, estimated: !e.difficulties, options };
  })
  .filter((e) => e.options.length);

const arenaEvent = guide.events.find((e) => e.id === 'arena')!;
const recharge = Math.floor((24 * 60) / guide.income.rechargeMinutes);
// Gems buy energy at the Gem Shop's unlimited energy price (the cheaper daily offers are one a day, in the income list).
const gemEnergy = shop.packs.find(
  (p) => p.tab === 'GemShop' && p.purchaseLimit === 'Unlimited' && p.price.resources?.Gem && p.rewards?.length === 1 && p.rewards[0].id === 'Energy',
);
const gemPrice = gemEnergy ? { gems: gemEnergy.price.resources!.Gem, energy: gemEnergy.rewards![0].amount } : { gems: 150, energy: 100 };
const income = { ...guide.income, energyPerGem: gemPrice.energy / gemPrice.gems };


const calc = {
  farming,
  income,
  chaseDays: guide.chase.days,
  arena: { ...guide.arena, chaseDays: guide.chase.days, target: arenaEvent.target, leagues: arenaLeagues },
};
---
<Base title="Events">
  <h1>Events</h1>
  <p class="lead">
    Points each event needs, and the energy a whole chase takes. Pick your stages and what you claim; everything else
    is worked out.
  </p>

  <section aria-labelledby="how-title">
    <h2 id="how-title">How events work</h2>
    <p class="text">
      Events come in two layers. Standalone events run for 3 to 7 days, with a bracket of 50 players and ten reward
      thresholds. They run inside a {guide.chase.days}-day <strong>Get Legendary chase</strong> (a bracket of
      {' '}{guide.chase.bracket}, {fmt(guide.chase.entry)} points to enter), whose tiers pay {guide.chase.crowns} Gold
      Crowns in total. Points from each standalone event also count toward the chase.
    </p>
  </section>

  <section class="card" aria-labelledby="farm-title">
    <h2 id="farm-title">{energyIcon && <img class="h-icon" src={energyIcon} alt="" width="26" height="26" />}Energy for a chase</h2>
    <p class="hint">
      Pick the highest stage you clear comfortably: points per energy rises with stage. Points per run are estimated
      from each stage's drop rates and the points each drop scores.
    </p>
    <div class="farm">
      {farming.map((e, i) => (
        <div class="frow" data-event={i}>
          <label class="inc"><input type="checkbox" checked data-include={i} /><span class="fname">{e.name}</span></label>
          <select data-stage={i} aria-label={`${e.name} stage`}>
            {e.options.map((o, j) => <option value={j} selected={j === e.options.length - 1}>{o.label} · {o.energy} energy</option>)}
          </select>
          <span class="fmeta" data-meta={i}></span>
          <span class="fenergy" data-energy={i}>–</span>
        </div>
      ))}
      <div class="frow total"><span>Energy for the chase</span><span class="fenergy" id="f-total">–</span></div>
    </div>
    <details class="how">
      <summary>How this is worked out</summary>
      <p class="hint">
        Runs = target ÷ points per run, rounded up. Energy = runs × energy per run × how many of that event a chase
        holds. Points per run are averages over each stage's drops, so real runs vary.
      </p>
      <div id="f-how"></div>
    </details>
  </section>

  <section class="card" aria-labelledby="plan-title">
    <h2 id="plan-title">{energyIcon && <img class="h-icon" src={energyIcon} alt="" width="26" height="26" />}Energy you'll have</h2>
    <p class="hint">
      Over the {guide.chase.days}-day chase. Untick anything you don't claim. The recharge is {recharge} a day (one every
      {' '}{guide.income.rechargeMinutes} minutes), and gems buy {gemPrice.energy} energy for {gemPrice.gems}.
    </p>
    <div class="cols">
      <div>
        <h3>Every day</h3>
        <div class="rows">
          <div class="row fixed"><span>Natural recharge</span><span>{recharge}</span></div>
          {guide.income.daily.map((r, i) => (
            <label class="row check"><span><input type="checkbox" checked data-daily={i} /> {r.name}</span><span>{r.energy}</span></label>
          ))}
          <div class="row total"><span>Per day</span><span id="p-daily">–</span></div>
        </div>
      </div>
      <div>
        <h3>Over the chase</h3>
        <div class="rows">
          {guide.income.extras.map((r, i) => (
            <label class="row check"><span><input type="checkbox" checked data-extra={i} /> {r.name}</span><span>{fmt(r.energy)}</span></label>
          ))}
          <div class="row total"><span>Income</span><span id="p-income">–</span></div>
        </div>
      </div>
    </div>

    <div class="summary" aria-live="polite">
      <div><span class="label">You need</span><span class="value" id="s-need">–</span></div>
      <div><span class="label">You'll have</span><span class="value" id="s-have">–</span></div>
      <div><span class="label">Short by</span><span class="value" id="s-short">–</span></div>
      <div><span class="label">{gemIcon && <img class="l-icon" src={gemIcon} alt="" width="16" height="16" />}Gems to cover it</span><span class="value" id="s-gems">–</span></div>
    </div>
  </section>

  <section class="card" aria-labelledby="arena-title">
    <h2 id="arena-title">{arenaIcon && <img class="h-icon" src={arenaIcon} alt="" width="26" height="26" />}Arena Rush</h2>
    <p class="hint">
      {guide.arena.battlesPerDay} battles a day (one an hour plus five from playtime rewards). A {guide.chase.days}-day
      chase holds three 3-day Arena Rush events, and wins score double during them ({guide.arena.doubleDays} days).
      Chase: points over the whole chase. Days: days at normal points to reach the {fmt(arenaEvent.target)}-point
      final reward. Top tier: whether the chase total reaches {fmt(guide.arena.chaseTarget)}.
    </p>
    <div class="calc">
      <label><span>Win rate</span><select id="a-rate">{guide.arena.winRates.map((r) => <option value={r} selected={r === 100}>{r}%</option>)}</select></label>
    </div>
    <div class="table-wrap arena-table">
      <table>
        <thead><tr><th scope="col">League</th><th scope="col" class="num">A day</th><th scope="col" class="num">Chase</th><th scope="col" class="num">Days</th><th scope="col">Top tier?</th></tr></thead>
        <tbody id="a-rows"></tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="list-title">
    <h2 id="list-title">Every event and its target</h2>
    <p class="hint">Final reward targets from recent events. Targets can differ between divisions and from one event to the next.</p>
    <div class="table-wrap">
      <table class="list">
        <thead><tr><th scope="col">Event</th><th scope="col" class="num">Final reward</th><th scope="col">How it scores</th></tr></thead>
        <tbody>
          {guide.events.map((e) => (
            <tr>
              <th scope="row">{e.name}</th>
              <td class="num">{fmt(e.target)}</td>
              <td class="wrap">{e.scoring}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="hint">
      Energy per stage for each boss is on its <a href={href('bosses')}>boss guide</a>. For summon events, the
      <a href={href('summons')}> Summons</a> page has the rates.
    </p>
  </section>

  <script type="application/json" id="event-data" set:html={JSON.stringify(calc).replace(/</g, '\\u003c')} />
  <SeeAlso links={[
    { path: 'bosses', label: 'Boss guides' },
    { path: 'tiers/invokers/arena', label: 'Arena tier list' },
    { path: 'trophies', label: 'Trophy Room' },
    { path: 'summons', label: 'Summons' },
  ]} />
</Base>

<script>
  import { arena, dailyIncome, periodIncome, shortfall, toFinish } from '../lib/events';

  interface Line { key: string; chance: number; amount: string; points: number }
  interface Option { label: string; energy: number; points: number; lines: Line[] }
  interface Data {
    farming: { id: string; name: string; target: number; perChase: number; estimated: boolean; options: Option[] }[];
    income: { rechargeMinutes: number; energyPerGem: number; daily: { name: string; energy: number }[]; extras: { name: string; energy: number }[] };
    chaseDays: number;
    arena: { battlesPerDay: number; chaseDays: number; doubleDays: number; chaseTarget: number; target: number; leagues: { league: string; win: number; loss: number }[] };
  }

  const data: Data = JSON.parse(document.getElementById('event-data')!.textContent!);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const all = <T extends HTMLElement>(sel: string) => [...document.querySelectorAll<T>(sel)];
  const fmt = (n: number) => (Number.isFinite(n) ? Math.round(n).toLocaleString('en-GB') : '–');

  const stageEls = all<HTMLSelectElement>('[data-stage]');
  const includeEls = all<HTMLInputElement>('[data-include]');
  const dailyEls = all<HTMLInputElement>('[data-daily]');
  const extraEls = all<HTMLInputElement>('[data-extra]');
  const aRate = $<HTMLSelectElement>('a-rate');

  // Per-viewer convenience: remember choices in this browser only.
  const KEY = 'events-planner-v2';
  interface Saved { stages?: Record<string, string>; include?: Record<string, boolean>; daily?: boolean[]; extra?: boolean[]; rate?: string }
  const save = () => {
    try {
      const saved: Saved = {
        // Stages by label and events by id, so choices survive new stages or events in the data.
        stages: Object.fromEntries(data.farming.map((e, i) => [e.id, e.options[Number(stageEls[i].value)]?.label ?? ''])),
        include: Object.fromEntries(data.farming.map((e, i) => [e.id, includeEls[i].checked])),
        daily: dailyEls.map((el) => el.checked),
        extra: extraEls.map((el) => el.checked),
        rate: aRate.value,
      };
      localStorage.setItem(KEY, JSON.stringify(saved));
    } catch {
      /* storage blocked: the page still works, it just forgets */
    }
  };
  const restore = () => {
    let saved: Saved = {};
    try {
      saved = JSON.parse(localStorage.getItem(KEY) ?? '{}');
    } catch {
      return;
    }
    data.farming.forEach((e, i) => {
      const j = e.options.findIndex((o) => o.label === saved.stages?.[e.id]);
      if (j >= 0) stageEls[i].value = String(j);
      const on = saved.include?.[e.id];
      if (typeof on === 'boolean') includeEls[i].checked = on;
    });
    dailyEls.forEach((el, i) => typeof saved.daily?.[i] === 'boolean' && (el.checked = saved.daily[i]));
    extraEls.forEach((el, i) => typeof saved.extra?.[i] === 'boolean' && (el.checked = saved.extra[i]));
    if (saved.rate && aRate.querySelector(`option[value="${CSS.escape(saved.rate)}"]`)) aRate.value = saved.rate;
  };

  // Chase energy: every included event at its chosen stage, times how many run in a chase.
  function chaseNeed(): number {
    let total = 0;
    const how: HTMLElement[] = [];
    data.farming.forEach((e, i) => {
      const o = e.options[Number(stageEls[i].value)] ?? e.options[e.options.length - 1];
      const one = toFinish(e.target, o.points, o.energy);
      const energy = one.energy * e.perChase;
      const on = includeEls[i].checked;
      if (on) total += energy;
      const row = document.querySelector(`[data-event="${i}"]`)!;
      row.classList.toggle('off', !on);
      document.querySelector(`[data-meta="${i}"]`)!.textContent =
        `${fmt(o.points)} points a run${e.estimated ? ' (est.)' : ''} · ${fmt(one.runs)} runs to ${fmt(e.target)}${e.perChase > 1 ? ` · ×${e.perChase} a chase` : ''}`;
      document.querySelector(`[data-energy="${i}"]`)!.textContent = fmt(energy);
      if (on && o.lines.length) how.push(breakdown(`${e.name}, ${o.label.toLowerCase()}`, o));
    });
    $('f-total').textContent = fmt(total);
    $('f-how').replaceChildren(...how);
    return total;
  }

  function breakdown(title: string, o: Option): HTMLElement {
    const wrap = document.createElement('div');
    const h = document.createElement('h3');
    h.textContent = `${title}: ${fmt(o.points)} points a run`;
    const table = document.createElement('table');
    const head = table.createTHead().insertRow();
    for (const [t, n] of [['Drop', false], ['Chance', true], ['Amount', true], ['Points', true]] as const) {
      const th = document.createElement('th');
      th.scope = 'col';
      th.textContent = t;
      if (n) th.className = 'num';
      head.append(th);
    }
    const body = table.createTBody();
    for (const l of o.lines) {
      const tr = body.insertRow();
      [l.key, `${(l.chance * 100).toFixed(l.chance < 0.01 ? 2 : 1)}%`, l.amount, fmt(l.points)].forEach((text, i) => {
        const cell = document.createElement(i ? 'td' : 'th');
        if (i) cell.className = 'num';
        else cell.scope = 'row';
        cell.textContent = text;
        tr.append(cell);
      });
    }
    const scroll = document.createElement('div');
    scroll.className = 'table-wrap';
    scroll.append(table);
    wrap.append(h, scroll);
    return wrap;
  }

  function update() {
    const need = chaseNeed();
    const daily = dailyIncome(dailyEls.map((el, i) => ({ name: '', energy: el.checked ? data.income.daily[i].energy : 0 })), data.income.rechargeMinutes);
    const income = periodIncome(daily, data.chaseDays, extraEls.map((el, i) => ({ name: '', energy: el.checked ? data.income.extras[i].energy : 0 })));
    const short = shortfall(need, income, data.income.energyPerGem);
    $('p-daily').textContent = fmt(daily);
    $('p-income').textContent = fmt(income);
    $('s-need').textContent = fmt(need);
    $('s-have').textContent = fmt(income);
    $('s-short').textContent = short.energy ? fmt(short.energy) : 'Nothing';
    $('s-gems').textContent = short.energy ? fmt(short.gems) : 'None';
    updateArena();
    save();
  }

  // Arena: a row per league at the chosen win rate, so there's nothing to type.
  function updateArena() {
    const rate = Number(aRate.value) / 100;
    $('a-rows').replaceChildren(
      ...data.arena.leagues.map((l) => {
        const r = arena({
          battlesPerDay: data.arena.battlesPerDay,
          winRate: rate,
          winPoints: l.win,
          lossPoints: l.loss,
          days: data.arena.chaseDays,
          doubleDays: data.arena.doubleDays,
          target: data.arena.chaseTarget,
        });
        // Days to the standalone target at normal points, as the event guide counts it.
        const days = r.perDay > 0 ? data.arena.target / r.perDay : Infinity;
        const tr = document.createElement('tr');
        [l.league, fmt(r.perDay), fmt(r.total), Number.isFinite(days) ? days.toFixed(1) : '–', r.total >= data.arena.chaseTarget ? 'Yes' : 'No'].forEach((text, i) => {
          const cell = document.createElement(i ? 'td' : 'th');
          if (i) cell.className = i === 4 ? (text === 'Yes' ? 'yes' : 'no') : 'num';
          else cell.scope = 'row';
          cell.textContent = text;
          tr.append(cell);
        });
        return tr;
      }),
    );
  }

  restore();
  for (const el of [...stageEls, ...includeEls, ...dailyEls, ...extraEls, aRate]) {
    el?.addEventListener(el instanceof HTMLSelectElement || (el as HTMLInputElement).type === 'checkbox' ? 'change' : 'input', update);
  }
  update();
</script>


<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  h2 { font-size: 18px; font-weight: 600; margin: 32px 0 8px; }
  .h-icon { vertical-align: -6px; margin-right: 8px; }
  .l-icon { vertical-align: -3px; margin-right: 4px; }
  h3 { font-size: 15px; font-weight: 600; margin: 20px 0 8px; color: var(--soft); }
  .lead, .text { color: var(--soft); max-width: 70ch; margin: 0; }
  .hint { color: var(--muted); font-size: 14px; margin: 0 0 12px; max-width: 80ch; }
  .hint a { color: var(--accent); }
  .muted { color: var(--muted); font-size: 15px; font-weight: 400; }
  .card {
    margin-top: 24px;
    padding: 4px 20px 20px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .card h2 { margin-top: 16px; }
  .calc { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; }
  .calc label, .inline { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--muted); }
  .inline { max-width: 240px; }
  select, input[type='number'] {
    min-height: 44px;
    padding: 0 10px;
    border-radius: 10px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--text);
    font: inherit;
    font-size: 15px;
    width: 100%;
    box-sizing: border-box;
  }
  input:disabled { opacity: 0.6; }
  .out { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; }
  .out p { margin: 0; font-family: var(--display); font-weight: 600; font-size: 18px; }
  .big { font-size: 32px; font-weight: 700; color: var(--accent); }
  .chip {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 22px;
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--text);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .plan { list-style: none; padding: 0; margin: 0 0 8px; display: grid; gap: 6px; }
  /* Plan rows are built by the script, so they need global selectors. */
  .plan :global(li) { display: grid; grid-template-columns: 1fr auto auto; gap: 12px; align-items: center; padding: 8px 12px; border-radius: 10px; background: var(--surface-2); }
  .plan :global(.n) { font-variant-numeric: tabular-nums; font-weight: 600; }
  .plan :global(.remove) { min-height: 36px; padding: 0 12px; border-radius: 18px; background: transparent; border: 1px solid var(--line); color: var(--soft); font: inherit; font-size: 13px; cursor: pointer; }
  .empty { color: var(--muted); font-size: 14px; margin: 0 0 8px; }
  .empty[hidden] { display: none; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .rows { display: grid; gap: 4px; }
  .row { display: grid; grid-template-columns: 1fr 110px; gap: 12px; align-items: center; min-height: 44px; color: var(--soft); font-size: 14px; }
  .row input { min-height: 38px; text-align: right; }
  .row.fixed span:last-child, .row.total span:last-child { text-align: right; padding-right: 11px; font-variant-numeric: tabular-nums; }
  .row.total { border-top: 1px solid var(--line); font-weight: 600; color: var(--text); }
  .summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 20px; }
  .summary div { padding: 12px 14px; border-radius: 12px; background: var(--surface-3); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 2px; }
  .summary .label { color: var(--muted); font-size: 13px; }
  .summary .value { font-family: var(--display); font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .plan-actions { margin-top: 16px; }
  .plan-actions .chip { border-color: var(--line); color: var(--soft); font-weight: 500; }
  .result { margin: 16px 0 0; font-family: var(--display); font-weight: 600; font-size: 18px; }
  .table-wrap { overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); }
  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
  thead th { background: var(--surface-3); color: var(--muted); font-weight: 600; }
  tbody th { color: var(--text); font-weight: 500; white-space: nowrap; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  td.wrap { color: var(--soft); min-width: 260px; }
  tbody tr:last-child > * { border-bottom: 0; }
  .table-wrap + .hint { margin-top: 12px; }
  .farm { display: grid; gap: 6px; }
  .frow { display: grid; grid-template-columns: minmax(150px, 1fr) 220px minmax(0, 1.4fr) 90px; gap: 12px; align-items: center; padding: 8px 12px; border-radius: 10px; background: var(--surface-2); }
  .frow.off { opacity: 0.5; }
  .frow.total { background: transparent; border-top: 1px solid var(--line); border-radius: 0; grid-template-columns: 1fr auto; font-weight: 600; }
  .inc { display: flex; align-items: center; gap: 8px; min-height: 44px; cursor: pointer; }
  .inc input, .check input { width: 18px; height: 18px; accent-color: var(--accent); }
  .fname { font-weight: 600; }
  .fmeta { color: var(--muted); font-size: 13px; }
  .fenergy { text-align: right; font-family: var(--display); font-weight: 700; font-variant-numeric: tabular-nums; }
  .frow.total .fenergy { font-size: 22px; color: var(--accent); }
  .row.check span:first-child { display: flex; align-items: center; gap: 8px; cursor: pointer; }
  .row.check span:last-child { text-align: right; padding-right: 11px; font-variant-numeric: tabular-nums; }
  .how :global(h3) { margin: 16px 0 8px; }
  .arena-table { margin-top: 12px; }
  .arena-table :global(tbody th), .arena-table :global(tbody td) { white-space: nowrap; padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; }
  .arena-table :global(tbody td) { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .arena-table :global(tbody tr:last-child > *) { border-bottom: 0; }
  .arena-table :global(td.yes), .arena-table :global(td.no) { text-align: left; }
  .arena-table :global(td.yes) { color: var(--accent); font-weight: 600; }
  .arena-table :global(td.no) { color: var(--muted); }
  .missing { margin: 12px 0 0; }
  .missing[hidden], .how[hidden] { display: none; }
  .how { margin-top: 16px; }
  .how summary { cursor: pointer; color: var(--accent); font-size: 14px; min-height: 32px; }
