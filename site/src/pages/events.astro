---
import Base from '../layouts/Base.astro';
import SeeAlso from '../components/SeeAlso.astro';
import { bosses, bossSlug, events, href } from '../lib/data';
import guide from '../data/event-guide.json';
import { difficultyName, withLiveTargets } from '../lib/eventCalendar';
import { itemIcon } from '../lib/art';
import { arenaLeagues, stageScore } from '../lib/eventScoring';
import { shop } from '../lib/packs';
import { arena, chestAverage, dailyIncome, perDay, type TopUp } from '../lib/events';
import chestsJson from '../../../data/chests.json';
import { chaseSchedule, plannedOnly } from '../lib/chases';
import planned from '../data/planned-events.json';

const fmt = (n: number) => n.toLocaleString('en-GB');
// Targets and Campaign Rush points follow the newest listed event of each kind; the rest are from recent events.
const plannerEvents = withLiveTargets(guide.events, events);
const energyIcon = itemIcon('Energy');
const gemIcon = itemIcon('Gem');
const arenaIcon = itemIcon('Arena_Token');

// Energy per stage for each farming event, from the boss list (every boss of a kind costs the same).
// One row per farming event, or per boss where each relic boss has its own event: pick a stage, the rest is worked out.
// The tournament type each farming event runs as, to place it on the chase's days (relic bosses: one type per boss).
const eventTypes: Record<string, string> = { accessory: 'ClanBoss', crest: 'RoleMedals', omnissi: 'Garudas', pentiax: 'Dragon', campaign: 'Campaign' };

// The chase on now (or next), with every tournament that pays into it placed on its days.
const now = Date.now();
const chase = events.filter((e) => e.type === 'GetLegendary' && Date.parse(e.end) > now).sort((a, b) => a.start.localeCompare(b.start))[0];
const schedule = chase ? chaseSchedule(chase, [...events, ...plannedOnly(planned.events, events)]) : undefined;
const chaseDays = schedule?.days.length ?? guide.chase.days;
const runsOf = (type: string | undefined) =>
  type && schedule ? schedule.rows.filter((r) => r.source.startsWith(type)).flatMap((r) => r.runs.map((x) => ({ from: x.from, to: x.to, name: x.name }))) : [];

const farming = plannerEvents
  .filter((e) => e.bossMode || e.difficulties)
  .flatMap((e) => {
    const perBoss = 'perBoss' in e ? (e.perBoss as Record<string, number>) : undefined;
    const kinds = bosses.filter((b) => b.mode === e.bossMode);
    const rows = perBoss
      ? Object.entries(perBoss).map(([name, count]) => ({ boss: kinds.find((b) => b.name === name), name: `${e.name}: ${name}`, perChase: count }))
      : [{ boss: kinds[0], name: e.name, perChase: 'perChase' in e ? (e.perChase as number) : 1 }];
    return rows.map((r, k) => {
      // Points per run come from each stage's drop rates and points per drop (estimated: they are averages).
      const stages = r.boss
        ? [...r.boss.stages].sort((a, b) => a.stage - b.stage).flatMap((s) => {
            const score = stageScore(e.bossMode, s.stage);
            return score ? [{ label: `Stage ${s.stage}`, energy: s.energy, points: score.pointsPerRun, lines: score.lines }] : [];
          })
        : [];
      const options = e.difficulties
        ? e.difficulties.map((d) => ({ label: difficultyName(d.name), energy: d.energy, points: d.points, lines: [] as (typeof stages)[number]['lines'] }))
        : stages;
      // The boss guide link: the event's own boss, or the boss list for groups (Crest, Omnissi).
      const link = r.boss && (perBoss || kinds.length === 1) ? href(`bosses/${bossSlug(r.boss)}`) : e.bossMode ? href('bosses') : undefined;
      const runs = runsOf(perBoss ? `RelicBoss${r.boss?.name ?? ''}` : eventTypes[e.id]);
      // On the chase's schedule, the runs it holds set how many of this event there are.
      const perChase = runs.length || r.perChase;
      return { id: perBoss ? `${e.id}-${k}` : e.id, name: r.name, link, target: e.target, perChase, runs, estimated: !e.difficulties, options };
    });
  })
  .filter((e) => e.options.length);

const arenaEvent = plannerEvents.find((e) => e.id === 'arena')!;
const recharge = Math.floor((24 * 60) / guide.income.rechargeMinutes);
// Gems buy energy at the Gem Shop's unlimited energy price (the cheaper daily offers are one a day, in the income list).
const gemEnergy = shop.packs.find(
  (p) => p.tab === 'GemShop' && p.purchaseLimit === 'Unlimited' && p.price.resources?.Gem && p.rewards?.length === 1 && p.rewards[0].id === 'Energy',
);
const gemPrice = gemEnergy ? { gems: gemEnergy.price.resources!.Gem, energy: gemEnergy.rewards![0].amount } : { gems: 150, energy: 100 };
// The Gem Shop's once-a-day energy offers: the free one is income, the cheap paid ones are bought before the unlimited one.
const dailyOffers = shop.packs
  .filter((p) => p.tab === 'GemShop' && p.purchaseLimit === 'PerDay' && p.rewards?.length === 1 && p.rewards[0].id === 'Energy')
  .map((p) => ({ gems: p.price.resources?.Gem ?? 0, energy: p.rewards![0].amount, perDay: p.purchaseLimitCount || 1 }));
// One clan activity chest a day (the quests are daily), counted at the Silver chest's average Energy.
const clanChest = chestsJson.chests.find((c) => c.chest === 'Activity' && c.tier === 'Silver');
const dailyRows = [
  ...guide.income.daily,
  ...(clanChest ? [{ name: 'Clan activity chest (Silver, average)', energy: chestAverage(clanChest.items, 'Energy') }] : []),
  ...dailyOffers.filter((o) => !o.gems).map((o) => ({ name: 'Free daily shop', energy: o.energy * o.perDay })),
];
const topUps: TopUp[] = [
  ...guide.income.topUps,
  ...dailyOffers.filter((o) => o.gems).sort((a, b) => a.gems / a.energy - b.gems / b.energy).map((o) => ({ name: `Gem shop daily offer (${o.gems} gems)`, energy: o.energy, gems: o.gems, perDay: o.perDay })),
  { name: `Gem shop (${gemPrice.gems} gems, no limit)`, energy: gemPrice.energy, gems: gemPrice.gems },
];
const dailyTotal = dailyIncome(dailyRows, guide.income.rechargeMinutes);

// Energy from tournament rewards, on the day each tournament starts. A tournament not open yet counts the rewards of
// the last one of its kind, or none if there hasn't been one.
const rewardEnergy = (e: { personalRewards?: { reward: ({ itemId: string; amount: number } | object)[] }[] } | undefined) =>
  (e?.personalRewards ?? []).reduce((n, r) => n + r.reward.reduce((m, x) => m + ('itemId' in x && x.itemId === 'Energy' ? x.amount : 0), 0), 0);
const latestOf = (type: string) => events.filter((e) => e.type === type).sort((a, b) => b.start.localeCompare(a.start))[0];
const tournamentEnergy = (schedule?.rows ?? []).flatMap((r) =>
  r.runs.map((x) => ({ day: x.from, energy: rewardEnergy(events.find((e) => e.type === r.source && e.start === x.start) ?? latestOf(r.source)) })),
).filter((t) => t.energy > 0 && t.day < chaseDays);
const extras = guide.income.extras.map((r) =>
  'fromTournaments' in r && schedule ? { name: 'Tournament rewards', energy: tournamentEnergy.reduce((n, t) => n + t.energy, 0), spread: false } : { name: r.name, energy: r.energy, spread: true },
);
// Free energy each day of the chase: the daily sources, the chase-long extras spread evenly, and tournament rewards.
const spreadExtras = extras.filter((r) => r.spread).reduce((n, r) => n + r.energy, 0);
const incomeByDay = Array.from({ length: chaseDays }, () => dailyTotal + spreadExtras / chaseDays);
for (const t of tournamentEnergy) incomeByDay[t.day] += t.energy;
const incomeTotal = Math.round(incomeByDay.reduce((n, x) => n + x, 0));
const arenaRows = arenaLeagues.map((l) => {
  const r = arena({ battlesPerDay: guide.arena.battlesPerDay, winRate: 1, winPoints: l.win, lossPoints: l.loss, days: guide.chase.days, doubleDays: guide.arena.doubleDays, target: guide.arena.chaseTarget });
  return { league: l.league, perDay: r.perDay, total: r.total, days: arenaEvent.target / r.perDay, top: r.total >= guide.arena.chaseTarget };
});


// The day-by-day table: one row per chase day, with the energy events that run that day.
const dayRows = schedule
  ? schedule.days.map((d, i) => ({
      date: d,
      label: new Date(d).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }),
      events: [...new Set(farming.flatMap((e) => e.runs.filter((x) => x.from <= i && i < x.to).map((x) => x.name)))],
    }))
  : [];

const calc = { farming, topUps, incomeByDay, days: dayRows.map((d) => d.date) };
---
<Base title="Events">
  <h1>Events</h1>
  <p class="lead">
    Pick the highest stage you clear for each boss. The page works out the energy a whole chase takes, what you'll
    earn, and the gems to cover the gap.
  </p>
  <p class="calendar-link">What's on now and next, with points and rewards: <a href={href('event-calendar')}>Event calendar</a>.</p>

  <section aria-labelledby="how-title">
    <h2 id="how-title">How events work</h2>
    <p class="text">
      Events come in two layers. Standalone events run for 3 to 7 days, with a bracket of 50 players and ten reward
      thresholds. They run inside a {guide.chase.days}-day <strong>Get Legendary chase</strong> (a bracket of
      {' '}{guide.chase.bracket}, {fmt(guide.chase.entry)} points to enter), whose tiers pay {guide.chase.crowns} Gold
      Crowns in total. Points from each standalone event also count toward the chase. Your level sets your bracket:
      Beginner (levels 1–30), Intermediate (31–45) or Veteran (46+). Lower brackets need fewer points but earn the same
      Crowns.
    </p>
  </section>

  <section class="card" aria-labelledby="farm-title">
    <h2 id="farm-title">{energyIcon && <img class="h-icon" src={energyIcon} alt="" width="26" height="26" />}Energy for a chase</h2>
    <p class="hint">
      Pick the highest stage you clear comfortably: points per energy rises with stage. Points per run are averages
      from each stage's drop rates and the points each drop scores.
    </p>
    <div class="farm">
      {farming.map((e, i) => (
        <div class="frow" data-event={i}>
          <span class="fname">{e.link ? <a href={e.link}>{e.name}</a> : e.name}</span>
          <select data-stage={i} aria-label={`${e.name} stage`}>
            {e.options.map((o, j) => <option value={j} selected={j === e.options.length - 1}>{o.label} · {o.energy} energy</option>)}
          </select>
          <span class="fmeta" data-meta={i}></span>
          <span class="fenergy" data-energy={i}>–</span>
        </div>
      ))}
      <div class="frow total"><span>Energy for the chase</span><span class="fenergy" id="f-total">–</span></div>
    </div>
    <details class="how">
      <summary>How this is worked out</summary>
      <p class="hint">
        Runs = target ÷ points per run, rounded up. Energy = runs × energy per run × how many of that event a chase
        holds. Points per run are averages over each stage's drops, so real runs vary.
      </p>
      <div id="f-how"></div>
    </details>
  </section>

  <section class="card" aria-labelledby="plan-title">
    <h2 id="plan-title">{energyIcon && <img class="h-icon" src={energyIcon} alt="" width="26" height="26" />}Energy you'll have</h2>
    <p class="hint">
      Over the {chaseDays}-day chase, claiming every free source. The recharge is {recharge} a day (one every
      {' '}{guide.income.rechargeMinutes} minutes), and the clan chest counts one Silver activity chest a day at its
      average energy. When that runs short, the cheapest top-ups are bought first.
    </p>
    <div class="cols">
      <div>
        <h3>Every day</h3>
        <div class="rows">
          <div class="row fixed"><span>Natural recharge</span><span>{recharge}</span></div>
          {dailyRows.map((r) => (
            <div class="row fixed"><span>{r.name}</span><span>{fmt(Math.round(perDay(r)))}</span></div>
          ))}
          <div class="row total"><span>Per day</span><span>{fmt(Math.round(dailyTotal))}</span></div>
        </div>
      </div>
      <div>
        <h3>Over the chase</h3>
        <div class="rows">
          {extras.map((r) => (
            <div class="row fixed"><span>{r.name}</span><span>{fmt(r.energy)}</span></div>
          ))}
          <div class="row total"><span>Free energy</span><span>{fmt(incomeTotal)}</span></div>
        </div>
        <h3>Top-ups, cheapest first</h3>
        <div class="rows">
          {topUps.map((t, i) => (
            <div class="row fixed"><span>{t.name}: {t.energy}{t.perDay ? `, ${t.perDay === 1 ? 'once' : `${t.perDay} times`} a day` : ''}</span><span data-topup={i}>–</span></div>
          ))}
        </div>
      </div>
    </div>

    <div class="summary" aria-live="polite">
      <div><span class="label">You need</span><span class="value" id="s-need">–</span></div>
      <div><span class="label">Free energy</span><span class="value">{fmt(incomeTotal)}</span></div>
      <div><span class="label">To buy</span><span class="value" id="s-short">–</span></div>
      <div><span class="label">{gemIcon && <img class="l-icon" src={gemIcon} alt="" width="16" height="16" />}Gems to cover it</span><span class="value" id="s-gems">–</span></div>
    </div>
  </section>

  {chase && dayRows.length > 0 && (
    <section class="card" aria-labelledby="days-title">
      <h2 id="days-title">{energyIcon && <img class="h-icon" src={energyIcon} alt="" width="26" height="26" />}Day by day: {chase.name}</h2>
      <p class="hint">
        Each event's energy is spread evenly over its days, and spare energy carries over. Bought: the top-ups that day,
        cheapest first, so you never run out. Days run 12:00 to 12:00 UTC. Dates are on the <a href={href('chase-calendar')}>chase calendar</a>.
      </p>
      <div class="table-wrap">
        <table class="days">
          <thead><tr><th scope="col">Day</th><th scope="col" class="num">In</th><th scope="col" class="num">Out</th><th scope="col" class="num">Bought</th><th scope="col" class="num">Left</th></tr></thead>
          <tbody>
            {dayRows.map((d, i) => (
              <tr data-day={i}>
                <th scope="row">{d.label}{d.events.length > 0 && <span class="ev">{d.events.join(', ')}</span>}</th>
                <td class="num" data-in></td><td class="num" data-out></td><td class="num" data-bought></td><td class="num" data-left></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="card" aria-labelledby="arena-title">
    <h2 id="arena-title">{arenaIcon && <img class="h-icon" src={arenaIcon} alt="" width="26" height="26" />}Arena Rush</h2>
    <p class="hint">
      {guide.arena.battlesPerDay} battles a day (one an hour plus five from playtime rewards). A {guide.chase.days}-day
      chase holds three 3-day Arena Rush events, and wins score double during them ({guide.arena.doubleDays} days).
      Counting every battle won. Chase: points over the whole chase. Days: days at normal points to reach the {fmt(arenaEvent.target)}-point
      final reward. Top tier: whether the chase total reaches {fmt(guide.arena.chaseTarget)}.
    </p>
    <div class="table-wrap arena-table">
      <table>
        <thead><tr><th scope="col">League</th><th scope="col" class="num">A day</th><th scope="col" class="num">Chase</th><th scope="col" class="num">Days</th><th scope="col">Top tier?</th></tr></thead>
        <tbody>
          {arenaRows.map((r) => (
            <tr><th scope="row">{r.league}</th><td class="num">{fmt(r.perDay)}</td><td class="num">{fmt(r.total)}</td><td class="num">{r.days.toFixed(1)}</td><td class={r.top ? 'yes' : 'no'}>{r.top ? 'Yes' : 'No'}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="list-title">
    <h2 id="list-title">Every event and its target</h2>
    <p class="hint">Final reward targets from recent events. Targets can differ between divisions and from one event to the next.</p>
    <div class="table-wrap">
      <table class="list">
        <thead><tr><th scope="col">Event</th><th scope="col" class="num">Final reward</th><th scope="col">How it scores</th></tr></thead>
        <tbody>
          {plannerEvents.map((e) => (
            <tr>
              <th scope="row">{e.name}</th>
              <td class="num">{fmt(e.target)}</td>
              <td class="wrap">{e.scoring}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="hint">
      Energy per stage for each boss is on its <a href={href('bosses')}>boss guide</a>. For summon events, the
      <a href={href('summons')}> Summons</a> page has the rates.
    </p>
  </section>

  <script type="application/json" id="event-data" set:html={JSON.stringify(calc).replace(/</g, '\\u003c')} />
  <SeeAlso links={[
    { path: 'event-calendar', label: 'Event calendar' },
    { path: 'news', label: 'News' },
    { path: 'farming', label: 'Where to farm' },
    { path: 'bosses', label: 'Boss guides' },
    { path: 'tiers/invokers/arena', label: 'Arena tier list' },
    { path: 'trophies', label: 'Trophy Room' },
    { path: 'summons', label: 'Summons' },
  ]} />
</Base>

<script>
  import { dayPlan, spreadRuns, toFinish, type TopUp } from '../lib/events';

  interface Line { key: string; perRun: number; amount: string; points: number }
  interface Option { label: string; energy: number; points: number; lines: Line[] }
  interface Data {
    farming: { id: string; name: string; target: number; perChase: number; runs: { from: number; to: number }[]; estimated: boolean; options: Option[] }[];
    topUps: TopUp[];
    incomeByDay: number[];
    /** Start of each chase day, when there is a chase schedule. */
    days: string[];
  }

  const data: Data = JSON.parse(document.getElementById('event-data')!.textContent!);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const fmt = (n: number) => (Number.isFinite(n) ? Math.round(n).toLocaleString('en-GB') : '–');
  const stageEls = [...document.querySelectorAll<HTMLSelectElement>('[data-stage]')];

  // Per-viewer convenience: remember the stage picks in this browser only, by event id and stage label.
  const KEY = 'events-planner-v3';
  const save = () => {
    try {
      localStorage.setItem(KEY, JSON.stringify(Object.fromEntries(data.farming.map((e, i) => [e.id, e.options[Number(stageEls[i].value)]?.label ?? '']))));
    } catch {
      /* storage blocked: the page still works, it just forgets */
    }
  };
  const restore = () => {
    let saved: Record<string, string> = {};
    try {
      saved = JSON.parse(localStorage.getItem(KEY) ?? '{}') ?? {};
    } catch {
      return;
    }
    data.farming.forEach((e, i) => {
      const j = e.options.findIndex((o) => o.label === saved[e.id]);
      if (j >= 0) stageEls[i].value = String(j);
    });
  };

  function breakdown(title: string, o: Option): HTMLElement {
    const wrap = document.createElement('div');
    const h = document.createElement('h3');
    h.textContent = `${title}: ${fmt(o.points)} points a run`;
    const table = document.createElement('table');
    const head = table.createTHead().insertRow();
    for (const [t, n] of [['Drop', false], ['Drops a run', true], ['Amount', true], ['Points', true]] as const) {
      const th = document.createElement('th');
      th.scope = 'col';
      th.textContent = t;
      if (n) th.className = 'num';
      head.append(th);
    }
    const body = table.createTBody();
    for (const l of o.lines) {
      const tr = body.insertRow();
      [l.key, l.perRun.toLocaleString('en-GB', { maximumFractionDigits: l.perRun < 0.1 ? 3 : 2 }), l.amount, fmt(l.points)].forEach((text, i) => {
        const cell = document.createElement(i ? 'td' : 'th');
        if (i) cell.className = 'num';
        else cell.scope = 'row';
        cell.textContent = text;
        tr.append(cell);
      });
    }
    const scroll = document.createElement('div');
    scroll.className = 'table-wrap';
    scroll.append(table);
    wrap.append(h, scroll);
    return wrap;
  }

  const dayEls = [...document.querySelectorAll<HTMLTableRowElement>('tr[data-day]')];
  const today = data.days.findIndex((d) => Date.now() >= Date.parse(d) && Date.now() < Date.parse(d) + 86_400_000);
  dayEls[today]?.classList.add('today');

  // Every event at its chosen stage, times how many run in a chase; then the cheapest top-ups, day by day.
  function update() {
    let need = 0;
    const n = data.incomeByDay.length;
    const spend = new Array<number>(n).fill(0);
    const how: HTMLElement[] = [];
    const seen = new Set<string>();
    data.farming.forEach((e, i) => {
      const o = e.options[Number(stageEls[i].value)] ?? e.options[e.options.length - 1];
      const one = toFinish(e.target, o.points, o.energy);
      const energy = one.energy * e.perChase;
      need += energy;
      // Placed on the event's own days when the chase schedule has them, else spread over the whole chase.
      const byDay = e.runs.length ? spreadRuns(n, e.runs, one.energy) : new Array<number>(n).fill(energy / n);
      byDay.forEach((x, d) => (spend[d] += x));
      document.querySelector(`[data-meta="${i}"]`)!.textContent =
        `${fmt(o.points)} points a run${e.estimated ? ' (est.)' : ''} · ${fmt(one.runs)} runs to ${fmt(e.target)}${e.perChase > 1 ? ` · ×${e.perChase} a chase` : ''}`;
      document.querySelector(`[data-energy="${i}"]`)!.textContent = fmt(energy);
      // Bosses that share drop tables show each stage's breakdown once.
      const key = o.lines.map((l) => l.key + l.perRun).join();
      if (o.lines.length && !seen.has(key)) {
        seen.add(key);
        how.push(breakdown(`${e.name}, ${o.label.toLowerCase()}`, o));
      }
    });
    const plan = dayPlan(data.incomeByDay, spend, data.topUps);
    const bought = plan.reduce((x, d) => x + d.bought, 0);
    const gems = plan.reduce((x, d) => x + d.gems, 0);
    $('f-total').textContent = fmt(need);
    $('f-how').replaceChildren(...how);
    $('s-need').textContent = fmt(need);
    $('s-short').textContent = bought ? fmt(bought) : 'Nothing';
    $('s-gems').textContent = gems ? fmt(gems) : 'None';
    data.topUps.forEach((t, i) => {
      const count = plan.reduce((x, d) => x + (d.buys[t.name] ?? 0), 0);
      document.querySelector(`[data-topup="${i}"]`)!.textContent = count ? `${fmt(count)}×` : '–';
    });
    dayEls.forEach((tr, i) => {
      const d = plan[i];
      if (!d) return;
      tr.querySelector('[data-in]')!.textContent = fmt(d.income);
      tr.querySelector('[data-out]')!.textContent = fmt(d.spend);
      const cell = tr.querySelector('[data-bought]')!;
      cell.textContent = d.bought ? fmt(d.bought) : '–';
      if (d.gems) {
        const sub = document.createElement('span');
        sub.className = 'ev';
        sub.textContent = `${fmt(d.gems)} gems`;
        cell.append(sub);
      }
      tr.querySelector('[data-left]')!.textContent = fmt(d.balance);
    });
    save();
  }

  restore();
  for (const el of stageEls) el.addEventListener('change', update);
  update();
</script>

<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  h2 { font-size: 18px; font-weight: 600; margin: 32px 0 8px; }
  .h-icon { vertical-align: -6px; margin-right: 8px; }
  .l-icon { vertical-align: -3px; margin-right: 4px; }
  h3 { font-size: 15px; font-weight: 600; margin: 20px 0 8px; color: var(--soft); }
  .lead, .text { color: var(--soft); max-width: 70ch; margin: 0; }
  .calendar-link { margin: 8px 0 0; font-size: 14px; color: var(--muted); }
