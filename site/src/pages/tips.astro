---
// The loading-screen tips, each with its picture, in the game's order.
import Base from '../layouts/Base.astro';
import SeeAlso from '../components/SeeAlso.astro';
import { richText } from '../lib/format';
import { hintArt } from '../lib/art';
import tipsJson from '../../../data/tips.json';

const plain = (s: string) => s.replace(/<(?!\/?(?:b|i|br|color)\b)[^>]+>/g, '');
const tips = (tipsJson.tips as { order?: number; title?: string; text: string }[])
  .filter((t): t is { order: number; title: string; text: string } => t.order !== undefined && !!t.title)
  .sort((a, b) => a.order - b.order);
---
<Base title="Loading tips">
  <h1>Loading tips</h1>
  <p class="lead">All {tips.length} tips the game shows while it loads, with their pictures.</p>

  <ol class="tips">
    {tips.map((t) => (
      <li>
        {hintArt(t.order) && <img src={hintArt(t.order)} alt="" width="800" height="200" loading="lazy" />}
        <h2 set:html={richText(plain(t.title))} />
        <p set:html={richText(plain(t.text))} />
      </li>
    ))}
  </ol>
  <SeeAlso links={[
    { path: 'blog/loading-tips-fact-checked', label: 'The loading screen tips, fact-checked' },
    { path: 'guides', label: 'All guides' },
  ]} />
</Base>

<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  .lead { color: var(--soft); max-width: 70ch; margin: 0 0 24px; }
  .tips { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 16px; }
  .tips li { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .tips img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 1; object-fit: cover; background: var(--surface-2); }
  .tips h2 { font-size: 17px; font-weight: 600; margin: 14px 16px 6px; }
  .tips p { color: var(--soft); margin: 0 16px 16px; font-size: 15px; }
</style>
