---
// Phone menu: every section, including the ones not in the bottom bar.
import Base from '../layouts/Base.astro';
import NavIcon from '../components/NavIcon.astro';
import SectionArt from '../components/SectionArt.astro';
import SearchForm from '../components/SearchForm.astro';
import { href } from '../lib/data';
import { inMenu, menus, nav, topLevel } from '../lib/nav';

// Top-level pages (the Simulator) come first, then News and the menus.
const groups = [
  ...(topLevel.length ? [{ label: '', items: topLevel }] : []),
  ...(nav[0].path === 'news' ? [{ label: 'News', items: [nav[0]] }] : []),
  ...menus.map((m) => ({ label: m.label, items: inMenu(m.group) })),
  { label: 'Site', items: inMenu('site') },
];
---
<Base title="More">
  <h1>All sections</h1>
  <div class="search"><SearchForm /></div>
  <section class="install" id="install" hidden>
    <img src={href('icons/icon-192-v2.png')} alt="" width="48" height="48" />
    <div>
      <strong>Install on your phone</strong>
      <span id="install-text">Opens like an app, and pages you've visited work offline.</span>
    </div>
    <button type="button" id="install-button" hidden>Install</button>
  </section>
  {groups.map((g) => (<>
  {g.label && <h2>{g.label}</h2>}
  <ul class="list">
    {g.items.map((n) => (
      <li class:list={{ 'box-only': n.boxOnly }}>
        <a href={href(n.path)}>
          {n.art ? <SectionArt art={n.art} size={36} /> : <NavIcon icon={n.icon} />}
          <span>{n.label}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        </a>
      </li>
    ))}
  </ul>
  </>))}
</Base>

<script>
  // Install card: a button where the browser offers installing (Android Chrome), Share-menu steps on iPhone,
  // nothing once the site already runs as an installed app.
  const card = document.getElementById('install')!;
  const button = document.getElementById('install-button')!;
  const text = document.getElementById('install-text')!;
  const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as Navigator & { standalone?: boolean }).standalone;
  const ios = /iphone|ipad|ipod/i.test(navigator.userAgent);
  type InstallPrompt = Event & { prompt: () => Promise<void> };
  if (!standalone) {
    if (ios) {
      text.textContent = 'In Safari, tap Share, then Add to Home Screen. Pages you\'ve visited then work offline.';
      card.hidden = false;
    }
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      card.hidden = false;
      button.hidden = false;
      button.onclick = async () => {
        await (e as InstallPrompt).prompt();
        card.hidden = true;
      };
    });
  }
</script>

<style>
  h1 { margin: 16px 0 12px; font-size: 22px; font-weight: 700; }
  .search { margin-bottom: 12px; }
  h2 { margin: 20px 0 8px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--soft); }
  .install {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
    padding: 14px 16px;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--accent);
  }
  .install[hidden] { display: none; }
  .install img { border-radius: var(--radius); flex: none; }
  .install div { flex: 1; display: flex; flex-direction: column; gap: 2px; font-size: 14px; color: var(--soft); }
  .install strong { color: var(--text); font-size: 15px; }
  .install button {
    min-height: 40px;
    padding: 0 16px;
    border-radius: var(--radius);
    border: 0;
    background: var(--accent);
    color: var(--bg);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .install button[hidden] { display: none; }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .list a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 0 16px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    font-weight: 600;
  }
  .list a span { flex: 1; }
  .list a svg:last-child { color: var(--muted); }
</style>
