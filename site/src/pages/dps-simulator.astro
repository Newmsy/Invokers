---
// The Simulator's old address: sends visitors (and old links, with their ?hero= and ?tab=) to /simulator.
import { href } from '../lib/data';

const to = href('simulator');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Simulator</title>
    <link rel="canonical" href={to} />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <script is:inline define:vars={{ to }}>location.replace(to + location.search + location.hash);</script>
  </head>
  <body>
    <p>The simulator has moved: <a href={to}>open the Simulator</a>.</p>
  </body>
</html>
