---
import Base from '../layouts/Base.astro';
import SeeAlso from '../components/SeeAlso.astro';
import { gearStatLabels, href, setNames } from '../lib/data';
import { gearIcons, setIcon } from '../lib/art';
import { BOSS, STAGES } from '../lib/dps/data';
import { FIGHT_SEC } from '../lib/dps/constants';
import { rarityColor } from '../lib/format';

const setIcons = Object.fromEntries(Object.keys(setNames).flatMap((id) => (setIcon(id) ? [[id, setIcon(id)]] : [])));
const labels = Object.fromEntries(Object.entries(gearStatLabels).map(([id, l]) => [id, l.name]));
---
<Base title="DPS simulator">
  <h1>DPS simulator</h1>
  <p class="lead">
    Estimated damage per second for one Invoker against {BOSS}, and how much one normal 5★ substat roll of each stat
    would add. Pick an Invoker from your box to use its own gear, or any Invoker at 6★ level 60, fully awakened, with
    no gear.
  </p>

  <div id="dps" data-base={href('/')} data-boss={BOSS} data-box={href('my-box')} data-labels={JSON.stringify(labels)} data-sets={JSON.stringify(setNames)} data-set-icons={JSON.stringify(setIcons)} data-gear-icons={JSON.stringify(gearIcons())} data-rarity={JSON.stringify(rarityColor)}>
    <div id="d-nobox" class="import-cta" hidden>
      <div>
        <strong>See your own numbers</strong>
        <p>Import your box to simulate your Invokers with their real gear, skill levels and Awakening, and to get the best gear swaps from what you own.</p>
      </div>
      <a class="btn primary" href={href('my-box')}>Import my box</a>
    </div>

    <section class="picker-box" aria-label="Invoker">
      <div class="current-row">
        <div id="d-current"></div>
        <button type="button" class="btn" id="d-change" hidden>Change Invoker</button>
      </div>
      <div id="d-browse">
        <p class="picking" id="d-picking-mate" hidden>Pick a teammate. Its buffs, and its DEF Down or Weaken on the boss, will count for the Invoker above.</p>
        <div class="pick-bar">
          <input id="d-search" type="search" placeholder="Search Invokers" autocomplete="off" />
          <select id="d-source" aria-label="Which Invokers">
            <option value="box">My box (with gear)</option>
            <option value="any">Any Invoker (6★, fully awakened, no gear)</option>
          </select>
          <select id="d-sort" aria-label="Sort">
            <option value="dps">Highest DPS</option>
            <option value="tough">Toughest (effective HP)</option>
            <option value="stars">Stars and level</option>
            <option value="rarity">Rarity</option>
            <option value="name">Name</option>
          </select>
        </div>
        <ul class="pick-grid" id="d-grid"></ul>
        <p class="hint" id="d-grid-empty" hidden>No Invokers match.</p>
      </div>
    </section>

    <div class="tabs" role="tablist" aria-label="What to calculate">
      <button type="button" role="tab" id="tab-dps" aria-controls="panel-dps" aria-selected="true">DPS</button>
      <button type="button" role="tab" id="tab-toughness" aria-controls="panel-toughness" aria-selected="false" tabindex="-1">Toughness</button>
    </div>

    <div class="filters">
      <label id="d-mode-label">Mode
        <select id="d-mode">
          <option value="pve">PvE: every skill ready</option>
          <option value="arena">Arena: skills start at half cooldown, {FIGHT_SEC.arena}-second fight</option>
        </select>
      </label>
      <label>{BOSS} stage
        <select id="d-stage">
          {STAGES.map((s) => <option value={s} selected={s === 16}>Stage {s}</option>)}
        </select>
      </label>
    </div>
    <div class="team-row" id="d-team-row">
      <span class="team-title">Teammates</span>
      <ul class="mates" id="d-mates"></ul>
      <button type="button" class="btn" id="d-add-mate">Add teammate</button>
    </div>

    <section id="d-out" hidden>
      <div id="panel-dps" role="tabpanel" aria-labelledby="tab-dps">
      <div class="summary">
        <div class="card">
          <h2 id="d-dps-label">Estimated DPS</h2>
          <p class="big" id="d-dps"></p>
          <p class="hint" id="d-total"></p>
        </div>
        <div class="card">
          <h2>Stats used</h2>
          <dl class="stats" id="d-stats"></dl>
        </div>
      </div>

      <h2>Where the damage comes from</h2>
      <table>
        <thead><tr><th>Source</th><th class="num">Uses</th><th class="num">Damage</th><th class="num">Share</th></tr></thead>
        <tbody id="d-sources"></tbody>
      </table>

      <section id="d-skills-box" hidden>
        <h2>What levelling a skill is worth</h2>
        <p class="hint">DPS gained by levelling each skill that isn't maxed yet.</p>
        <table>
          <thead><tr><th>Skill</th><th class="num">Level</th><th class="num">+1 level</th><th class="num">To max</th></tr></thead>
          <tbody id="d-skills"></tbody>
        </table>
      </section>

      <section id="d-debuffs-box" hidden>
        <h2>Debuffs on the boss</h2>
        <p class="hint" id="d-acc"></p>
        <table>
          <thead><tr><th>Skill</th><th>Debuff</th><th class="num">Lands</th><th class="num">Landed in the fight</th><th class="num">Up</th><th class="num">DPS gain</th></tr></thead>
          <tbody id="d-debuffs"></tbody>
        </table>
      </section>

      <section id="d-buffs-box" hidden>
        <h2>Buffs it casts on itself</h2>
        <p class="hint">Each buff multiplies the stat while it lasts (Skill Recovery and speed buffs add to the stat instead). Faster cooldowns keep it up longer. Buffs that need a crit count by Crit Rate.</p>
        <table>
          <thead><tr><th>Skill</th><th>Buff</th><th class="num">Up</th><th class="num">DPS gain</th></tr></thead>
          <tbody id="d-buffs"></tbody>
        </table>
      </section>

      <section id="d-mates-box" hidden>
        <h2>What teammates add</h2>
        <p class="hint">DPS each teammate's buffs and boss debuffs add to this Invoker, on top of the other teammates. Group buffs count by their chance to reach it.</p>
        <table>
          <thead><tr><th>Teammate</th><th>Buffs</th><th class="num">DPS added</th><th class="num">Gain</th></tr></thead>
          <tbody id="d-mates-out"></tbody>
        </table>
      </section>

      <section id="d-fx-box" hidden>
        <h2>Cooldown cuts and bonus mana</h2>
        <p class="hint">What its skills give back to itself in the fight. Effects that need a crit count by Crit Rate.</p>
        <table>
          <thead><tr><th>Skill</th><th>Effect</th><th class="num">In the fight</th><th class="num">DPS gain</th></tr></thead>
          <tbody id="d-fx"></tbody>
        </table>
      </section>

      <h2>What one more substat roll is worth</h2>
      <p class="hint">DPS gained by adding one normal (B grade) 5★ substat roll to this build.</p>
      <table>
        <thead><tr><th>Substat roll</th><th class="num">DPS gain</th></tr></thead>
        <tbody id="d-values"></tbody>
      </table>

      <section id="o-box" hidden>
        <h2>Best gear from your box</h2>
        <p class="loading" id="o-loading" role="status" hidden><span class="spinner" aria-hidden="true"></span>Checking the gear in your box…</p>
        <div id="o-result">
        <p class="hint" id="o-summary"></p>
        <ul class="hint sets" id="o-sets"></ul>
        <p class="hint">Each swap's DPS gain is what that piece adds on top of the other suggested pieces, so set bonuses count.</p>
        <label class="check"><input type="checkbox" id="o-others" checked /> Use gear other Invokers are wearing</label>
        <table>
          <thead><tr><th>Slot</th><th>Now</th><th>Best</th><th class="num">DPS gain</th></tr></thead>
          <tbody id="o-rows"></tbody>
        </table>
      </div>
      </section>

      <p class="hint note">
        Estimates: one target, element advantage against each stage counts, buffs, cooldown cuts and mana it gives itself count, and so do its own DEF Down and Weaken on the boss, and other Invokers' buffs count only for teammates you add, average crits, a {FIGHT_SEC.pve}-second fight in PvE and {FIGHT_SEC.arena} seconds in Arena (about how long a top-level Arena fight lasts).
        Burn and Bleed count at their per-tick limit and only when they land. The numbers will sharpen as the battle rules are confirmed.
      </p>
      </div>
      <div id="panel-toughness" role="tabpanel" aria-labelledby="tab-toughness" hidden>
      <h2 id="toughness" class="first">Toughness against {BOSS}</h2>
      <p class="hint">Effective HP is how much damage this Invoker can take before falling once DEF is counted: HP divided by the share of each hit that gets through DEF. DEF takes the same share off every hit, whatever its size.</p>
      <div class="summary">
        <div class="card">
          <h2>Effective HP</h2>
          <p class="big" id="t-ehp"></p>
          <p class="hint" id="t-line"></p>
          <div id="t-buffed" hidden>
            <p class="hint">With its own buffs, on average: <strong id="t-buffed-ehp"></strong></p>
            <p class="hint" id="t-buffed-line"></p>
          </div>
        </div>
        <div class="card">
          <h2>Against this stage</h2>
          <dl class="stats" id="t-stats"></dl>
        </div>
      </div>
      <h3>HP or DEF: what one more roll adds</h3>
      <p class="hint">Effective HP gained by one normal (B grade) 5★ roll of flat or % HP and DEF.</p>
      <table>
        <thead><tr><th>Substat roll</th><th class="num">Effective HP</th><th class="num">Gain</th></tr></thead>
        <tbody id="t-values"></tbody>
      </table>

      <section id="t-o-box" hidden>
        <h2>Toughest gear from your box</h2>
        <p class="loading" id="t-o-loading" role="status" hidden><span class="spinner" aria-hidden="true"></span>Checking the gear in your box…</p>
        <div id="t-o-result">
        <p class="hint" id="t-o-summary"></p>
        <ul class="hint sets" id="t-o-sets"></ul>
        <p class="hint">Each swap's gain is the effective HP that piece adds on top of the other suggested pieces, so set bonuses count.</p>
        <label class="check"><input type="checkbox" id="t-o-others" checked /> Use gear other Invokers are wearing</label>
        <table>
          <thead><tr><th>Slot</th><th>Now</th><th>Best</th><th class="num">Effective HP gain</th></tr></thead>
          <tbody id="t-o-rows"></tbody>
        </table>
      </div>
      </section>
      <p class="hint note">
        Toughness counts HP, DEF and the DEF Up and shields it casts on itself (shields as the average standing in a fight, assuming none is broken early), but not healing, other Invokers' buffs or Tolerances, and the hits line assumes each hit deals {BOSS}'s ATK.
      </p>
      </div>
    </section>
  </div>

  <SeeAlso links={[
    { path: 'my-box', label: 'My box' },
    { path: 'bosses', label: 'Bosses' },
    { path: 'gear', label: 'Gear sets' },
    { path: 'planner', label: 'Planner' },
  ]} />
</Base>

<script>
  import { start } from '../lib/dps/page';
  start();
</script>

<style>
  h1 { margin: 16px 0 8px; font-size: 28px; font-weight: 700; }
  h2 { font-size: 18px; font-weight: 600; margin: 28px 0 10px; }
  .tabs { display: flex; gap: 4px; margin: 4px 0 16px; border-bottom: 1px solid var(--line); }
  .tabs [role='tab'] {
    padding: 10px 18px; border: 0; border-bottom: 3px solid transparent; background: none; color: var(--soft);
    font: inherit; font-size: 16px; font-weight: 600; cursor: pointer; margin-bottom: -1px;
  }
  .tabs [role='tab']:hover { color: var(--text); }
  .tabs [role='tab'][aria-selected='true'] { color: var(--text); border-bottom-color: var(--accent); }
  #d-mode-label[hidden], #d-team-row[hidden], #d-add-mate[hidden] { display: none; }
  .team-row { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; margin: 0 0 16px; }
  .team-title { color: var(--muted); font-size: 13px; }
  .mates { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; min-width: 0; }
  :global(.mate) { display: flex; align-items: stretch; min-width: 0; max-width: 100%; }
  :global(.mate .tile) { min-width: 0; }
  :global(.mate-remove) { border: 1px solid var(--line); border-left: 0; background: transparent; color: var(--soft); padding: 0 12px; font-size: 18px; cursor: pointer; }
  :global(.mate-remove:hover), :global(.mate-remove:focus-visible) { color: var(--accent); background: var(--line); }
  .picking { margin: 0 0 8px; padding: 8px 12px; border-left: 3px solid var(--accent); color: var(--soft); font-size: 14px; }
  .picking[hidden] { display: none; }
  h2.first { margin-top: 16px; }
  h3 { font-size: 16px; font-weight: 600; margin: 20px 0 6px; }
  .card h2 { margin: 0 0 8px; font-size: 15px; color: var(--soft); }
  .lead { color: var(--soft); max-width: 70ch; margin: 0 0 16px; }
  .hint { color: var(--muted); font-size: 14px; }
  .note { margin-top: 20px; max-width: 70ch; }
  .filters { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; }
  .filters label { display: grid; gap: 4px; color: var(--muted); font-size: 13px; min-width: 0; flex: 1 1 200px; }
  .filters select {
    background: var(--surface); color: var(--text); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 8px 10px; font: inherit; font-size: 15px; width: 100%; min-width: 0;
  }
  .picker-box { margin-bottom: 16px; }
  .current-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-bottom: 12px; }
  .current-row #d-current { flex: 1 1 260px; min-width: 0; }
  .btn { padding: 8px 14px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); color: var(--text); font: inherit; cursor: pointer; }
  .btn:hover { border-color: var(--accent); }
  .btn.primary { background: var(--accent); color: #110E0A; border-color: var(--accent); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .import-cta {
    display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; justify-content: space-between;
    padding: 16px; margin-bottom: 16px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--accent);
  }
  .import-cta[hidden] { display: none; }
  .import-cta > div { flex: 1 1 280px; min-width: 0; }
  .import-cta strong { font-size: 16px; }
  .import-cta p { margin: 4px 0 0; color: var(--soft); font-size: 14px; }
  .pick-bar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .pick-bar input, .pick-bar select {
    background: var(--surface); color: var(--text); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 8px 10px; font: inherit; font-size: 15px; min-width: 0; flex: 1 1 180px;
  }
  .pick-grid {
    list-style: none; margin: 0; padding: 2px; display: grid; gap: 8px;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); max-height: 420px; overflow-y: auto;
  }
  :global(.tile) {
    display: flex; gap: 10px; align-items: center; width: 100%; text-align: left; padding: 8px 10px;
    border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--rarity);
    color: var(--text); font: inherit; cursor: pointer; min-width: 0;
  }
  :global(button.tile:hover), :global(.tile.on) { border-color: var(--accent); border-left-color: var(--rarity); }
  :global(div.tile) { cursor: default; }
  :global(.tile-text) { display: grid; min-width: 0; }
  :global(.tile-text strong) { font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.tile-text small) { color: var(--muted); font-size: 12px; }
  :global(.tile-text .tile-dps) { color: var(--soft); font-weight: 600; }
  .summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin-top: 16px; }
  .card { padding: 16px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); min-width: 0; }
  .big { font-family: var(--display); font-weight: 700; font-size: 36px; margin: 0; }
  .card .hint { margin: 4px 0 0; }
  .stats { display: grid; grid-template-columns: auto auto; justify-content: start; gap: 4px 16px; margin: 0; font-variant-numeric: tabular-nums; }
  :global(.stats dt) { color: var(--muted); }
  :global(.stats dd) { margin: 0; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; }
  th, :global(td) { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); }
  .num, :global(td.num) { text-align: right; font-variant-numeric: tabular-nums; }
  .loading { display: flex; gap: 10px; align-items: center; color: var(--soft); font-size: 14px; margin: 12px 0; }
  .loading[hidden] { display: none; }
  .spinner { width: 16px; height: 16px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; flex: none; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .spinner { animation-duration: 2.4s; } }
  .check { display: flex; gap: 8px; align-items: center; margin: 8px 0 12px; font-size: 14px; color: var(--soft); }
  :global(td.piece) { font-size: 14px; }
  :global(td.piece small) { display: block; color: var(--muted); }
  :global(td.piece .piece-wrap) { display: flex; gap: 10px; align-items: flex-start; }
  :global(td.piece .piece-info) { min-width: 0; }
  :global(table.stack td.piece .piece-wrap) { justify-content: flex-end; }
  :global(img.gear-icon) { width: 40px; height: 40px; flex: none; border-radius: var(--radius); border: 1px solid var(--line, rgba(255, 255, 255, 0.12)); background: rgba(0, 0, 0, 0.25); }
  :global(td.slot-cell span) { display: inline-flex; gap: 8px; align-items: center; }
  :global(td.slot-cell img) { width: 28px; height: 28px; opacity: 0.7; flex: none; }
  :global(img.set-icon) { width: 22px; height: 22px; flex: none; vertical-align: middle; }
  :global(.sets li) { display: flex; flex-wrap: wrap; gap: 4px 6px; align-items: center; }
  :global(.sets .set-chip) { display: inline-flex; gap: 4px; align-items: center; }
  :global(table.stack td.piece > div) { text-align: right; min-width: 0; }
  :global(td.piece .equipped) { display: inline-block; margin-top: 4px; font-size: 12px; color: var(--soft); }
  :global(td.piece .equipped b) { padding: 1px 6px; margin-right: 2px; border-radius: var(--radius); background: var(--accent); color: #110E0A; font-weight: 700; }
  .sets { margin: 0 0 8px; padding-left: 18px; }
  :global(tr.same td) { color: var(--muted); }
  :global(.pos) { color: var(--uncommon, #7be0a0); }
</style>
