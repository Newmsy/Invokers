---
import { getCollection } from 'astro:content';
import SeeAlso from '../../components/SeeAlso.astro';
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog">
  <h1>Blog</h1>
  <p class="lede">The numbers behind Invokers, worked out in plain language.</p>
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <StoryCard path={`blog/${p.id}`} title={p.data.title} description={p.data.description} meta={`${fmt(p.data.date)} · game version ${p.data.gameVersion}`} />
      </li>
    ))}
  </ul>
  <SeeAlso links={[
    { path: 'guides', label: 'All guides by topic' },
    { path: 'news', label: 'News' },
    { path: 'tiers', label: 'Tier lists' },
  ]} />
</Base>

<style>
  .lede { color: var(--soft); margin-top: -8px; }
  .posts { list-style: none; padding: 0; margin: 24px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 540px), 1fr)); gap: 16px; }
</style>
