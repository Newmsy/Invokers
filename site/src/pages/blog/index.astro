---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/data';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog">
  <h1>Blog</h1>
  <p class="lede">The numbers behind Invokers, worked out in plain language.</p>
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <a href={href(`blog/${p.id}`)}>
          <h2>{p.data.title}</h2>
          <p>{p.data.description}</p>
          <span class="meta">{fmt(p.data.date)} · game version {p.data.gameVersion}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .lede { color: var(--soft); margin-top: -8px; }
  .posts { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 16px; max-width: 760px; }
  .posts a {
    display: block;
    padding: 20px 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    color: var(--text);
  }
  .posts a:hover { border-color: var(--accent); }
  .posts h2 { margin: 0 0 6px; font-size: 20px; }
  .posts p { margin: 0 0 10px; color: var(--soft); }
  .meta { font-size: 13px; color: var(--muted); }
  @media (max-width: 720px) {
    .posts a { padding: 16px; }
    .posts h2 { font-size: 18px; }
  }
</style>
