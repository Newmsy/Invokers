---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArtStrip from '../../components/ArtStrip.astro';
import SeeAlso from '../../components/SeeAlso.astro';
import SectionArt from '../../components/SectionArt.astro';
import { pack, href } from '../../lib/data';
import { bannerArt } from '../../lib/art';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Other posts that share a tag, most shared tags first.
  const related = (post: (typeof posts)[number]) =>
    posts
      .filter((p) => p.id !== post.id)
      .map((p) => ({ p, shared: p.data.tags.filter((t) => post.data.tags.includes(t)).length }))
      .filter((r) => r.shared > 0)
      .sort((a, b) => b.shared - a.shared || b.p.data.date.getTime() - a.p.data.date.getTime())
      .slice(0, 3)
      .map((r) => ({ path: `blog/${r.p.id}`, label: r.p.data.title, art: r.p.data.art[0] }));
  return posts.map((post) => ({ params: { id: post.id }, props: { post, related: related(post) } }));
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
// Desktop side rail: the post's sections, for jumping around long data posts.
const sections = headings.filter((h) => h.depth === 2);
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const banner = post.data.banner ? bannerArt(post.data.banner) : undefined;
if (post.data.banner && !banner) throw new Error(`No banner art "${post.data.banner}" for blog/${post.id}`);
const older = post.data.gameVersion !== pack.gameVersion;
---
<Base title={post.data.title}>
  <div class="post">
  <article>
    <a class="back" href={href('blog')}>← Blog</a>
    {banner && <img class="banner" src={banner} alt="" />}
    <div class="cover"><ArtStrip refs={post.data.art} /></div>
    <h1>{post.data.title}</h1>
    <p class="meta">
      {date} · written for game version {post.data.gameVersion}
      {older && <span class="older"> (the site's data is now {pack.gameVersion})</span>}
    </p>
    <div class="body">
      <Content />
    </div>
    <SeeAlso links={related} />
  </article>
  <aside class="rail" aria-label="In this post">
    {sections.length > 1 && (
      <nav class="box">
        <h2>On this page</h2>
        <ol>{sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    {related.length > 0 && (
      <section class="box">
        <h2>Related</h2>
        <ul class="related">
          {related.map((r) => (
            <li><a href={href(r.path)}><SectionArt art={r.art} size={40} /><span>{r.label}</span></a></li>
          ))}
        </ul>
      </section>
    )}
    <a class="box all" href={href('guides')}>All guides ›</a>
  </aside>
  </div>
</Base>

<style>
  article { max-width: 760px; min-width: 0; }
  .rail { display: none; }
  /* Wide screens: the article takes the extra width (tables and headings run the full column, text stays
     a readable measure) and a sticky rail lists the post's sections and related posts. */
  @media (min-width: 1100px) {
    .post { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 40px; align-items: start; }
    article { max-width: none; }
    .body :global(p), .body :global(ul), .body :global(ol), .body :global(blockquote) { max-width: 78ch; }
    /* Wide tables (four or more columns) take the whole column so their cells wrap less. */
    .body :global(table:not(.stack):has(th:nth-child(4))) { display: table; width: 100%; }
    .rail { display: flex; flex-direction: column; gap: 14px; position: sticky; top: 16px; padding-top: 12px; }
  }
  .rail .box { display: block; padding: 14px 16px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .rail h2 { margin: 0 0 8px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--soft); }
  .rail ol, .rail ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; }
  .rail ol a { display: block; padding: 4px 8px; border-radius: var(--radius); color: var(--soft); font-size: 14px; }
  .rail ol a:hover { color: var(--text); background: var(--surface-2); }
  .related a { display: flex; align-items: center; gap: 10px; padding: 4px; border-radius: var(--radius); color: var(--text); font-size: 14px; line-height: 1.3; }
  .related a:hover { background: var(--surface-2); }
  .rail .all { font-size: 14px; font-weight: 600; }
  .back { font-size: 14px; }
  h1 { font-size: 34px; margin: 12px 0 8px; }
  .meta { color: var(--muted); font-size: 14px; margin: 0 0 24px; }
  .older { color: var(--soft); }
  .body { font-size: 17px; color: var(--text); }
  .body :global(h2) { font-size: 23px; margin: 36px 0 12px; }
  .body :global(h3) { font-size: 19px; margin: 28px 0 8px; }
  .body :global(p), .body :global(li) { color: var(--soft); }
  .body :global(strong) { color: var(--text); }
  .body :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 16px 0 24px;
    font-size: 15px;
  }
  .body :global(th), .body :global(td) {
    padding: 8px 14px;
    border-bottom: 1px solid var(--line);
    text-align: right;
  }
  .body :global(th:first-child), .body :global(td:first-child) { text-align: left; }
  .body :global(th) { color: var(--text); font-family: var(--display); font-weight: 600; background: var(--surface); }
  .cover:not(:empty) { margin-top: 20px; }
  .banner { display: block; width: 100%; height: auto; aspect-ratio: 16 / 7; object-fit: cover; margin-top: 16px; border-radius: var(--radius); border: 1px solid var(--line); }
  .body :global(p > img) { display: block; max-width: 100%; height: auto; margin: 16px 0; border-radius: var(--radius); border: 1px solid var(--line); }
  .body :global(a.art-chip span) { color: var(--text); }
  .body :global(a.art-chip:hover span) { color: var(--accent); }
  .body :global(blockquote) {
    margin: 20px 0;
    padding: 12px 18px;
    background: var(--surface);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .body :global(blockquote p) { margin: 0; }
  @media (max-width: 720px) {
    h1 { font-size: 26px; }
    .body { font-size: 16px; }
  }
</style>
