---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArtStrip from '../../components/ArtStrip.astro';
import { pack, href } from '../../lib/data';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const older = post.data.gameVersion !== pack.gameVersion;
---
<Base title={post.data.title}>
  <article>
    <a class="back" href={href('blog')}>← Blog</a>
    <div class="cover"><ArtStrip refs={post.data.art} /></div>
    <h1>{post.data.title}</h1>
    <p class="meta">
      {date} · written for game version {post.data.gameVersion}
      {older && <span class="older"> (the site's data is now {pack.gameVersion})</span>}
    </p>
    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<style>
  article { max-width: 760px; }
  .back { font-size: 14px; }
  h1 { font-size: 34px; margin: 12px 0 8px; }
  .meta { color: var(--muted); font-size: 14px; margin: 0 0 24px; }
  .older { color: var(--soft); }
  .body { font-size: 17px; color: var(--text); }
  .body :global(h2) { font-size: 23px; margin: 36px 0 12px; }
  .body :global(h3) { font-size: 19px; margin: 28px 0 8px; }
  .body :global(p), .body :global(li) { color: var(--soft); }
  .body :global(strong) { color: var(--text); }
  .body :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 16px 0 24px;
    font-size: 15px;
  }
  .body :global(th), .body :global(td) {
    padding: 8px 14px;
    border-bottom: 1px solid var(--line);
    text-align: right;
    white-space: nowrap;
  }
  .body :global(th:first-child), .body :global(td:first-child) { text-align: left; }
  .body :global(th) { color: var(--text); font-family: var(--display); font-weight: 600; background: var(--surface); }
  .cover:not(:empty) { margin-top: 20px; }
  .body :global(.art-chip) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    vertical-align: middle;
    white-space: nowrap;
  }
  .body :global(.art-chip img) {
    width: 24px;
    height: 24px;
    flex: none;
    object-fit: cover;
    object-position: top center;
    border-radius: 6px;
  }
  .body :global(a.art-chip span) { color: var(--text); }
  .body :global(a.art-chip:hover span) { color: var(--accent); }
  .body :global(blockquote) {
    margin: 20px 0;
    padding: 12px 18px;
    background: var(--surface);
    border-left: 3px solid var(--accent);
    border-radius: 0 12px 12px 0;
  }
  .body :global(blockquote p) { margin: 0; }
  @media (max-width: 720px) {
    h1 { font-size: 26px; }
    .body { font-size: 16px; }
  }
</style>
