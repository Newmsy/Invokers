---
import { pack, href } from '../lib/data';
import NavIcon from '../components/NavIcon.astro';
import { headerNav, inGroup, menus, myBox, nav, tabs } from '../lib/nav';
import Account from '../components/Account.astro';
import SectionArt from '../components/SectionArt.astro';
import Tooltips from '../components/Tooltips.astro';
import { accountsEnabled } from '../lib/account/config';

interface Props {
  title: string;
}
const { title } = Astro.props;
const updated = new Date(pack.extractedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });


const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').split('/')[1] ?? '';
// A section's own page (not its sub-pages) shows the section picture beside its heading.
const pagePath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/^\/|\/$/g, '');
const section = nav.find((n) => n.path === pagePath);
// Breadcrumbs: Home › menu › section › this page (when it is a sub-page of a section).
const owner = nav.find((n) => n.path === pagePath) ?? nav.find((n) => n.path === current);
const menu = menus.find((m) => m.group === owner?.group);
const crumbs = pagePath && owner
  ? [
      { label: 'Home', path: '/' },
      ...(menu ? [{ label: menu.label, path: '' }] : []),
      { label: owner.label, path: owner.path },
      ...(owner.path !== pagePath ? [{ label: title, path: '' }] : []),
    ]
  : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Invokers Companion</title>
    <meta name="theme-color" content="#0c0b1d" />
    <link rel="icon" href={href('icons/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('icons/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Invokers" />
    <link rel="manifest" href={href('manifest.webmanifest')} crossorigin="use-credentials" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=DM+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={href('/')}>Invokers <span>Companion</span></a>
      <nav class="top-nav" aria-label="Main">
        {headerNav.filter((n) => n.path === 'news').map((n) => (
          <a href={href(n.path)} aria-current={current === n.path ? 'page' : undefined}>{n.label}</a>
        ))}
        {menus.map((m) => (
          <div class="menu">
            <a class="menu-top" href={href(m.path)} aria-current={owner?.group === m.group ? 'true' : undefined} aria-haspopup="true">
              {m.label}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </a>
            <div class="panel">
              {inGroup(m.group).map((n) => (
                <a href={href(n.path)} aria-current={pagePath === n.path ? 'page' : undefined}>
                  <SectionArt art={n.art} size={36} />
                  <span class="label">{n.label}</span>
                  <span class="blurb">{n.blurb}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
        {headerNav.filter((n) => n.path !== 'news').map((n) => (
          <a href={href(n.path)} aria-current={current === n.path ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <form class="header-search" role="search" action={href('search')} method="get">
        <NavIcon icon="search" size={18} />
        <input type="search" name="q" placeholder="Search" aria-label="Search the site" autocomplete="off" spellcheck="false" enterkeyhint="search" />
        <kbd>/</kbd>
      </form>
      <a class="search-link" href={href('search')} aria-label="Search" title="Search (press /)" aria-current={current === 'search' ? 'page' : undefined}>
        <NavIcon icon="search" size={20} />
      </a>
      <a class="box-button" href={href(myBox.path)} aria-current={current === myBox.path ? 'page' : undefined}>
        <NavIcon icon={myBox.icon} size={18} />
        {myBox.label}
      </a>
      {accountsEnabled && <Account />}
    </header>
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c, i) => (
            <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.label}</span> : c.path ? <a href={href(c.path)}>{c.label}</a> : <span>{c.label}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <main class:list={{ 'has-crumbs': crumbs.length > 0 }}>
      {section?.art && <SectionArt art={section.art} size={88} class="page-art" />}
      <slot />
    </main>
    <footer>
      <div class="footer-links">
        {[...menus, { group: 'site' as const, label: 'Site', path: 'about' }].map((m) => (
          <div>
            <h2>{m.label}</h2>
            <ul>{inGroup(m.group).map((n) => <li><a href={href(n.path)}>{n.label}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <p>
        <a href={href('updates')}>Game version {pack.gameVersion}</a> · updated {updated}
        <br />
        Unofficial fan site, not affiliated with the game's developer. <a href={href('privacy')}>Privacy</a>
      </p>
    </footer>
    <Tooltips />
    <nav class="tab-bar" aria-label="Main" style={`--tabs: ${tabs.length}`}>
      {tabs.map((n) => {
        const here = n.path === 'more' ? !tabs.some((t) => t.path === current) && nav.some((t) => t.path === current) : current === n.path;
        return (
          <a href={href(n.path)} aria-current={here ? 'page' : undefined}>
            <NavIcon icon={n.icon} />
            {n.label}
          </a>
        );
      })}
    </nav>
    {import.meta.env.PROD && (
      <Fragment>
        {/* Cookieless visitor counts (Vercel Web Analytics); the script only exists on Vercel deploys. */}
        <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
        <script is:inline defer src="/_vercel/insights/script.js"></script>
      </Fragment>
    )}
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ sw: href('sw.js'), scope: href('/') }}>
        // Keeps opened pages and images for offline use (pages/sw.js.ts).
        if ('serviceWorker' in navigator) navigator.serviceWorker.register(sw, { scope }).catch(() => {});
      </script>
    )}
    <script>
      // Press / anywhere (outside a text field) to jump to search.
      document.addEventListener('keydown', (e) => {
        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
        const el = e.target as HTMLElement;
        if (el.closest('input, textarea, select, [contenteditable="true"]')) return;
        const box = (document.getElementById('search-input') ??
          (getComputedStyle(document.querySelector('.header-search')!).display !== 'none' ? document.querySelector('.header-search input') : null)) as HTMLInputElement | null;
        e.preventDefault();
        if (box) box.focus();
        else location.href = (document.querySelector('a.search-link') as HTMLAnchorElement).href;
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0c0b1d;
    --surface: #18163a;
    --surface-2: #252150;
    --surface-3: #131130;
    --line: #2e2a5c;
    --text: #eceaf8;
    --soft: #b5b1d3;
    --muted: #8a85b5;
    --accent: #5fdcf7;
    --display: 'Sora', system-ui, sans-serif;
    font-family: 'DM Sans', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { color: #a6edfb; }
  h1, h2, h3 { font-family: var(--display); line-height: 1.2; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .avatar {
    flex: none;
    display: inline-block;
    width: var(--size, 32px);
    height: var(--size, 32px);
    border-radius: 50%;
    overflow: hidden;
    background: var(--surface-2);
    vertical-align: middle;
  }
  .with-avatar { display: inline-flex; align-items: center; gap: 8px; }
  .avatar img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  /* An icon beside a name inside running text (blog chips, guide lines). Plain inline so it sits on the
     text baseline and the name stays glued to the punctuation after it; sized in em to match the text. */
  .art-chip { white-space: nowrap; }
  .art-chip img {
    display: inline-block;
    width: 1.3em;
    height: 1.3em;
    vertical-align: -0.3em;
    object-fit: cover;
    object-position: top center;
    border-radius: 6px;
  }
  .art-chip img + span { margin-left: 0.3em; }

  header.top, main, footer {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 48px;
    padding-right: 48px;
  }
  header.top {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 72px;
  }
  .brand {
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    color: var(--text);
  }
  .brand span { color: var(--accent); }
  .top-nav { display: flex; gap: 2px; font-weight: 500; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .top-nav a { white-space: nowrap; }
  .top-nav { overflow: visible; align-items: center; }
  .top-nav > a, .menu-top {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--soft);
    padding: 10px 12px;
    border-radius: 22px;
  }
  .top-nav > a:hover, .menu:hover .menu-top { color: var(--text); background: var(--surface); }
  .top-nav > a[aria-current='page'], .menu-top[aria-current] { color: var(--bg); background: var(--accent); }
  .menu-top svg { opacity: 0.7; }
  /* Database / Guides / Tools: a panel of sections with pictures, opened on hover or keyboard focus. */
  .menu { position: relative; }
  .menu .panel {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 20;
    width: 560px;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    margin-top: 6px;
    padding: 10px;
    border-radius: 16px;
    background: var(--surface-3);
    border: 1px solid var(--line);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
  }
  .menu .panel::before { content: ''; position: absolute; left: 0; right: 0; top: -8px; height: 8px; }
  .menu:hover .panel, .menu:focus-within .panel { display: grid; }
  .panel a {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 12px;
    align-items: center;
    padding: 8px 10px;
    border-radius: 10px;
    color: var(--text);
    white-space: normal;
  }
  .panel a:hover, .panel a[aria-current='page'] { background: var(--surface-2); }
  .panel .section-art { grid-row: span 2; }
  .panel .label { font-weight: 600; font-size: 14px; }
  .panel .blurb { color: var(--muted); font-size: 12.5px; line-height: 1.35; }
  .header-search {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    width: 220px;
    height: 40px;
    padding: 0 10px 0 12px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--muted);
    flex: none;
  }
  .header-search:focus-within { border-color: var(--accent); }
  .header-search input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--text); font: inherit; font-size: 14px; }
  .header-search input::-webkit-search-cancel-button { display: none; }
  .header-search kbd { font: inherit; font-size: 12px; padding: 0 6px; border: 1px solid var(--line); border-radius: 6px; }
  .search-link { display: none !important; }
  .crumbs { max-width: 1280px; margin: 0 auto; padding: 0 48px; font-size: 13px; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 4px 8px; margin: 0; padding: 8px 0 0; list-style: none; color: var(--muted); }
  .crumbs li + li::before { content: '›'; margin-right: 8px; color: var(--line); }
  .crumbs a { color: var(--soft); }
  .crumbs a:hover { color: var(--accent); }
  .crumbs [aria-current] { color: var(--muted); }
  /* The breadcrumb replaces each page's own back link. */
  main.has-crumbs a.back { display: none; }
  .search-link {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 22px;
    color: var(--soft);
    font-weight: 500;
    white-space: nowrap;
    flex: none;
  }
  .search-link:hover { color: var(--text); background: var(--surface); }
  .search-link[aria-current='page'] { color: var(--accent); }
  header.top .account { margin-left: 0; }
  .box-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 22px;
    border: 1px solid var(--accent);
    color: var(--text);
    font-weight: 600;
  }
  .box-button[aria-current='page'] { background: var(--accent); color: var(--bg); }
  main { padding-top: 16px; padding-bottom: 32px; }
  main .page-art { float: right; margin: 12px 0 12px 16px; }
  footer {
    color: var(--muted);
    font-size: 13px;
    padding-top: 24px;
    padding-bottom: 24px;
    border-top: 1px solid var(--line);
  }
  .footer-links { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 16px; }
  .footer-links h2 { margin: 0 0 6px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--soft); }
  .footer-links ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 2px; }
  .footer-links a { color: var(--muted); }
  .footer-links a:hover { color: var(--accent); }
  footer p { margin: 0; }
  .tab-bar { display: none; }

  .brand { white-space: nowrap; }
  .box-button { white-space: nowrap; flex: none; }
  /* The sign-in button sits right after My box on wide screens. */
  @media (min-width: 1141px) {
    header.top .account { margin-left: 0; min-width: 0; }
  }

  /* Seven sections plus Search and My box: drop the Search label before the links run out of room. */
  @media (max-width: 1320px) {
    header.top { gap: 16px; padding-left: 32px; padding-right: 32px; }
    .header-search { width: 150px; }
    .header-search kbd { display: none; }
  }

  /* Below this width the header links don't fit, so the bottom tab bar takes over. */
  @media (max-width: 1140px) {
    .top-nav, .box-button, .header-search { display: none; }
    .search-link { display: inline-flex !important; margin-left: auto; padding: 0 10px; min-width: 44px; justify-content: center; }
    .crumbs { padding: 0 32px; }
    footer { padding-bottom: 92px; }
    .tab-bar {
      display: grid;
      grid-template-columns: repeat(var(--tabs), minmax(0, 1fr));
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      height: 68px;
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--surface-3);
      border-top: 1px solid var(--line);
      z-index: 10;
    }
    .tab-bar a {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      font-size: 11px;
      color: var(--soft);
    }
    .tab-bar a[aria-current='page'] { color: var(--accent); font-weight: 600; }
  }

  @media (max-width: 720px) {
    header.top, main, footer, .crumbs { padding-left: 16px; padding-right: 16px; }
    .footer-links { grid-template-columns: 1fr 1fr; }
    header.top { height: 60px; }
    .brand { font-size: 19px; }
    main { padding-top: 4px; }
    main .page-art { --size: 56px !important; margin: 10px 0 8px 12px; }
    footer { font-size: 11px; }
  }
</style>
