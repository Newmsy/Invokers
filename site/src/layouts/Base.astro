---
import { pack, href } from '../lib/data';
import NavIcon from '../components/NavIcon.astro';
import { headerNav, myBox, nav, tabs } from '../lib/nav';
import Account from '../components/Account.astro';
import { accountsEnabled } from '../lib/account/config';

interface Props {
  title: string;
}
const { title } = Astro.props;


const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').split('/')[1] ?? '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Invokers Companion</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=DM+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={href('/')}>Invokers <span>Companion</span></a>
      <nav class="top-nav" aria-label="Main">
        {headerNav.map((n) => (
          <a href={href(n.path)} aria-current={current === n.path ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <a class="box-button" href={href(myBox.path)} aria-current={current === myBox.path ? 'page' : undefined}>
        <NavIcon icon={myBox.icon} size={18} />
        {myBox.label}
      </a>
      {accountsEnabled && <Account />}
    </header>
    <main>
      <slot />
    </main>
    <footer>
      Game version {pack.gameVersion} · data extracted {pack.extractedAt}
      <br />
      Unofficial fan site, not affiliated with the game's developer. <a href={href('privacy')}>Privacy</a>
    </footer>
    <nav class="tab-bar" aria-label="Main" style={`--tabs: ${tabs.length}`}>
      {tabs.map((n) => {
        const here = n.path === 'more' ? !tabs.some((t) => t.path === current) && nav.some((t) => t.path === current) : current === n.path;
        return (
          <a href={href(n.path)} aria-current={here ? 'page' : undefined}>
            <NavIcon icon={n.icon} />
            {n.label}
          </a>
        );
      })}
    </nav>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0c0b1d;
    --surface: #18163a;
    --surface-2: #252150;
    --surface-3: #131130;
    --line: #2e2a5c;
    --text: #eceaf8;
    --soft: #b5b1d3;
    --muted: #8a85b5;
    --accent: #5fdcf7;
    --display: 'Sora', system-ui, sans-serif;
    font-family: 'DM Sans', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { color: #a6edfb; }
  h1, h2, h3 { font-family: var(--display); line-height: 1.2; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  header.top, main, footer {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 48px;
    padding-right: 48px;
  }
  header.top {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 72px;
  }
  .brand {
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    color: var(--text);
  }
  .brand span { color: var(--accent); }
  .top-nav { display: flex; gap: 4px; font-weight: 500; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .top-nav a { white-space: nowrap; }
  .top-nav a {
    color: var(--soft);
    padding: 10px 16px;
    border-radius: 22px;
  }
  .top-nav a[aria-current='page'] { color: var(--bg); background: var(--accent); }
  .box-button {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 22px;
    border: 1px solid var(--accent);
    color: var(--text);
    font-weight: 600;
  }
  .box-button[aria-current='page'] { background: var(--accent); color: var(--bg); }
  main { padding-top: 16px; padding-bottom: 32px; }
  footer {
    color: var(--muted);
    font-size: 13px;
    padding-top: 16px;
    padding-bottom: 24px;
  }
  .tab-bar { display: none; }

  .brand { white-space: nowrap; }
  .box-button { white-space: nowrap; flex: none; }
  /* The sign-in button sits right after My box on wide screens. */
  @media (min-width: 1141px) {
    header.top .account { margin-left: 0; min-width: 0; }
  }

  /* Below this width the header links don't fit, so the bottom tab bar takes over. */
  @media (max-width: 1140px) {
    .top-nav, .box-button { display: none; }
    footer { padding-bottom: 92px; }
    .tab-bar {
      display: grid;
      grid-template-columns: repeat(var(--tabs), minmax(0, 1fr));
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      height: 68px;
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--surface-3);
      border-top: 1px solid var(--line);
      z-index: 10;
    }
    .tab-bar a {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      font-size: 11px;
      color: var(--soft);
    }
    .tab-bar a[aria-current='page'] { color: var(--accent); font-weight: 600; }
  }

  @media (max-width: 720px) {
    header.top, main, footer { padding-left: 16px; padding-right: 16px; }
    header.top { height: 60px; }
    .brand { font-size: 19px; }
    main { padding-top: 4px; }
    footer { font-size: 11px; }
  }
</style>
