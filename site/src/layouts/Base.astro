---
import { pack, href } from '../lib/data';

interface Props {
  title: string;
}
const { title } = Astro.props;

const nav = [
  ['heroes', 'Heroes'],
  ['events', 'Events'],
  ['my-box', 'My box'],
  ['about', 'About'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Invokers Companion</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Sora:wght@600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <a class="brand" href={href('/')}>Invokers Companion</a>
      <nav>
        {nav.map(([path, label]) => <a href={href(path)}>{label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      Game version {pack.gameVersion} · data extracted {pack.extractedAt}
      <br />
      Unofficial fan site, not affiliated with the game's developer.
    </footer>
  </body>
</html>

<style is:global>
  /* Rift palette (Newms's pick from the UI style mocks). */
  :root {
    color-scheme: dark;
    --bg: #0c0b1d;
    --surface: #16142e;
    --surface-2: #201d40;
    --line: #2e2a57;
    --text: #e9e8ff;
    --muted: #9c9ac4;
    --accent: #5fdcf7;
    --danger: #ff7a90;
    --legendary: #f5b84a;
    --epic: #b886ff;
    --rare: #5fa8f7;
    --uncommon: #6fdc8c;
    font-family: 'DM Sans', system-ui, sans-serif;
  }
  h1, h2, h3, .brand { font-family: Sora, 'DM Sans', system-ui, sans-serif; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
  }
  a { color: var(--accent); }
  header, main, footer {
    max-width: 960px;
    margin: 0 auto;
    padding: 16px;
  }
  header {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: baseline;
  }
  header nav { display: flex; gap: 12px; }
  .brand { font-weight: 700; color: var(--text); text-decoration: none; }
  footer { color: var(--muted); font-size: 0.85rem; }
</style>
