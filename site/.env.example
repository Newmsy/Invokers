# Copy to site/.env to build the site with sign-in. Leave unset for a browser-only site.
# Both values are public: they ship in the page, and row-level security protects the data.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Sign-in buttons to show, in order. Each must be enabled in Supabase (Authentication > Providers).
PUBLIC_AUTH_PROVIDERS=google,discord
